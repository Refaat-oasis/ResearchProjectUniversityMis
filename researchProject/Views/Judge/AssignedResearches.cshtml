@model List<researchProject.Models.Entities.Evaluation>
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "المقترحات البحثية المسندة للتحكيم الأخلاقي";
}

<div class="page-header-card">
    <div>
        <h1><i class="bi bi-file-earmark-medical"></i> المقترحات البحثية المسندة للتحكيم الأخلاقي</h1>
        <p>تقييم الجوانب الأخلاقية للمقترحات البحثية المسندة إليكم بصفتكم محكماً علمياً مستقلاً</p>
    </div>
    <span class="status-stamp status-assigned">
        إجمالي المهام المسندة: <strong class="font-mono-tabular">@(Model?.Count ?? 0)</strong>
    </span>
</div>

<div class="card card-custom archival-card">
    <div class="table-responsive">
        <table class="table ledger-table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>الكلية</th>
                    <th>التصنيف والتخصص</th>
                    <th>الجولة</th>
                    <th>حالة التقييم</th>
                    <th>التوقيع الرقمي</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var ev in Model)
                    {
                        bool isDone = ev.SubmittedAt.HasValue;

                        <tr style="@(isDone ? "" : "border-right: 3px solid #B88E38;")">
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-bold" style="max-width: 260px; color: var(--ink-primary);">@ev.Research?.Title</td>
                            <td>
                                <span style="display: inline-block; padding: 2px 8px; font-size: 0.8rem; background: var(--bg-subtle); color: var(--ink-primary); border: 1px solid var(--border-hairline); border-radius: 3px;">@ev.Research?.College?.Name</span>
                            </td>
                            <td>
                                <div class="fw-medium">@ev.Research?.Category?.Name</div>
                                <div class="small" style="color: var(--ink-secondary);">@ev.Research?.AcademicSpecialty</div>
                            </td>
                            <td>
                                <span style="display: inline-block; padding: 2px 8px; font-size: 0.8rem; font-weight: 600; background: var(--bg-subtle); color: var(--ink-primary); border: 1px solid var(--border-hairline); border-radius: 3px;">
                                    الجولة <span class="font-mono-tabular">@ev.RoundNumber</span>
                                </span>
                            </td>
                            <td>
                                @if (isDone)
                                {
                                    @if (ev.Decision == EvaluationDecisionConstants.ClosedDueToOtherJudge || ev.Decision == "مغلق لاكتمال التحكيم")
                                    {
                                        <span class="status-stamp status-inactive"><i class="bi bi-lock me-1"></i>مغلق (تم التحكيم بواسطة محكم آخر)</span>
                                    }
                                    else if (ev.Decision == EvaluationDecisionConstants.Approved)
                                    {
                                        <span class="status-stamp status-approved"><i class="bi bi-check-lg me-1"></i>موافق</span>
                                    }
                                    else
                                    {
                                        <span class="status-stamp status-modifications"><i class="bi bi-exclamation-circle me-1"></i>طلب تعديلات</span>
                                    }
                                }
                                else
                                {
                                    <span class="status-stamp status-screening"><i class="bi bi-hourglass-split me-1"></i>قيد التقييم</span>
                                }
                            </td>
                            <td>
                                @if (ev.IsDigitallySigned)
                                {
                                    <span class="status-stamp status-assigned"><i class="bi bi-check2-circle me-1"></i>موقع</span>
                                }
                                else
                                {
                                    <span class="small font-mono-tabular text-muted">-</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    @if (ev.Decision == EvaluationDecisionConstants.ClosedDueToOtherJudge || ev.Decision == "مغلق لاكتمال التحكيم")
                                    {
                                        <a asp-action="Evaluate" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye me-1"></i> استعراض (مغلق)
                                        </a>
                                    }
                                    else if (!isDone)
                                    {
                                        <a asp-action="Evaluate" asp-route-id="@ev.Id" class="btn btn-sm btn-primary-custom">
                                            <i class="bi bi-pencil-square me-1"></i> تعبئة نموذج التقييم
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Evaluate" asp-route-id="@ev.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye me-1"></i> استعراض التقييم
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-clipboard2-check fs-1 d-block mb-3"></i>
                            لا توجد أي مقترحات بحثية مسندة للتحكيم حالياً.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
