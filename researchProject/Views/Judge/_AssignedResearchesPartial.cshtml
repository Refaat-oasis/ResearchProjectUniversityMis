@model List<researchProject.Models.Entities.Evaluation>
@using researchProject.Models.Constants

<div class="card card-custom archival-card">
    <div class="card-header-custom flex-wrap gap-3">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-file-earmark-medical" style="color: var(--brand-brass, #9A6B26);"></i> المقترحات البحثية المسندة للتحكيم الأخلاقي
            </h4>
            <div class="small mt-1" style="color: var(--ink-secondary, #4A525A);">تقييم الجوانب الأخلاقية للمقترحات البحثية المسندة إليكم بصفتكم محكماً علمياً مستقلاً</div>
        </div>
        <span class="status-stamp status-assigned">
            <span class="font-mono-tabular me-1">@(Model?.Count ?? 0)</span> مهمة تحكيم
        </span>
    </div>

    <div class="table-responsive">
        <table class="table ledger-table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>الكلية</th>
                    <th>التصنيف والتخصص</th>
                    <th>الجولة</th>
                    <th>حالة التقييم</th>
                    <th>التوقيع الرقمي</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var ev in Model)
                    {
                        bool isDone = ev.SubmittedAt.HasValue;

                        <tr style="@(isDone ? "" : "border-right: 3px solid #9A6B26;")">
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-bold" style="max-width: 260px; color: var(--ink-primary, #121619);">@ev.Research?.Title</td>
                            <td>
                                <span style="display: inline-block; padding: 2px 8px; font-size: 0.8rem; background: var(--bg-subtle, #EDEBE4); color: var(--ink-primary, #121619); border: 1px solid var(--border-hairline, #D8D5CC); border-radius: 3px;">@ev.Research?.College?.Name</span>
                            </td>
                            <td>
                                <div class="fw-medium">@ev.Research?.Category?.Name</div>
                                <div class="small" style="color: var(--ink-secondary, #4A525A);">@ev.Research?.AcademicSpecialty</div>
                            </td>
                            <td>
                                <span style="display: inline-block; padding: 2px 8px; font-size: 0.8rem; font-weight: 600; background: var(--bg-subtle, #EDEBE4); color: var(--ink-primary, #121619); border: 1px solid var(--border-hairline, #D8D5CC); border-radius: 3px;">
                                    الجولة <span class="font-mono-tabular">@ev.RoundNumber</span>
                                </span>
                            </td>
                            <td>
                                @if (isDone)
                                {
                                    @if (ev.Decision == EvaluationDecisionConstants.ClosedDueToOtherJudge || ev.Decision == "مغلق لاكتمال التحكيم")
                                    {
                                        <span class="status-stamp status-inactive"><i class="bi bi-lock me-1"></i>مغلق (تم التحكيم بواسطة محكم آخر)</span>
                                    }
                                    else if (ev.Decision == EvaluationDecisionConstants.Approved)
                                    {
                                        <span class="status-stamp status-approved"><i class="bi bi-check-lg me-1"></i>موافق</span>
                                    }
                                    else
                                    {
                                        <span class="status-stamp status-modifications"><i class="bi bi-exclamation-circle me-1"></i>طلب تعديلات</span>
                                    }
                                }
                                else
                                {
                                    <span class="status-stamp status-screening"><i class="bi bi-hourglass-split me-1"></i>قيد التقييم</span>
                                }
                            </td>
                            <td>
                                @if (ev.IsDigitallySigned)
                                {
                                    <span class="status-stamp status-assigned"><i class="bi bi-check2-circle me-1"></i>موقع</span>
                                }
                                else
                                {
                                    <span class="small font-mono-tabular" style="color: var(--ink-muted, #767E85);">-</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    @if (ev.Decision == EvaluationDecisionConstants.ClosedDueToOtherJudge || ev.Decision == "مغلق لاكتمال التحكيم")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" onclick="loadPartial('/Judge/EvaluationFormPartial/@ev.Id', '#main-content-container', 'assigned-researches');" title="استعراض التقييم المغلق">
                                            <i class="bi bi-eye me-1"></i> استعراض (مغلق)
                                        </button>
                                    }
                                    else if (!isDone)
                                    {
                                        <button class="btn btn-sm btn-primary-custom" onclick="loadPartial('/Judge/EvaluationFormPartial/@ev.Id', '#main-content-container', 'assigned-researches');" title="تعبئة نموذج التقييم الأخلاقي">
                                            <i class="bi bi-pencil-square me-1"></i> تعبئة نموذج التقييم
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" onclick="loadPartial('/Judge/EvaluationFormPartial/@ev.Id', '#main-content-container', 'assigned-researches');" title="استعراض نتيجة التقييم">
                                            <i class="bi bi-eye me-1"></i> استعراض التقييم
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color: var(--ink-muted, #767E85);">
                            <i class="bi bi-check-circle fs-3 d-block mb-2" style="color: var(--brand-sovereign, #14342B);"></i>
                            لا توجد أبحاث جديدة مسندة إليكم حالياً للتحكيم.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
