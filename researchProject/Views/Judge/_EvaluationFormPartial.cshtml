@model researchProject.Models.Entities.Evaluation
@using researchProject.Models.Constants

<div class="card card-custom">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-clipboard2-pulse text-primary"></i> نموذج التقييم والتحكيم الأخلاقي (الجولة @Model.RoundNumber)
            </h4>
            <div class="text-muted small">« @Model.Research?.Title » - @Model.Research?.College?.Name</div>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm" onclick="loadPartial('/Judge/AssignedResearchesPartial', '#main-content-container', 'assigned-researches');">
                <i class="bi bi-arrow-right me-1"></i> العودة للمقترحات
            </button>
        </div>
    </div>

    <!-- Research Documents Review -->
    <div class="card bg-light border p-3 mb-4">
        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-paperclip me-2 text-primary"></i>المستندات وخطة البحث المطلوب تحكيمها</h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered bg-white mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>نوع المستند</th>
                        <th>النسخة</th>
                        <th>اسم الملف الأصلي</th>
                        <th>تاريخ الرفع</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Research?.ResearchAttachments != null)
                    {
                        foreach (var att in Model.Research?.ResearchAttachments!)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@att.AttachmentType</td>
                                <td><span class="badge bg-secondary">V @att.Version</span></td>
                                <td>@att.OriginalFileName</td>
                                <td class="small text-muted">@att.UploadedAt.ToString("yyyy/MM/dd")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.SubmittedAt.HasValue)
    {
        <!-- Read-Only View of Submitted Evaluation -->
        <div class="alert alert-success border-success p-3 mb-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-patch-check-fill text-success fs-4"></i>
                <h5 class="fw-bold text-success mb-0">تم تقديم هذا التقييم وتوقيعه رقمياً بنجاح</h5>
            </div>
            <div class="small text-muted">
                تاريخ وتوقيت التوقيع الرقمي: <strong>@Model.SignedAt?.ToString("yyyy/MM/dd HH:mm:ss") UTC</strong>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">تقييم حماية الخصوصية:</div>
                    <div class="fw-bold text-dark mt-1">@Model.PrivacyProtectionRating</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">تقييم نسبة المخاطر:</div>
                    <div class="fw-bold text-dark mt-1">@Model.RiskLevel</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">تقييم الموافقة المستنيرة:</div>
                    <div class="fw-bold text-dark mt-1">@Model.InformedConsentRating</div>
                </div>
            </div>
            <div class="col-12">
                <div class="p-3 border rounded bg-white">
                    <div class="text-muted small">قرار التحكيم النهائي:</div>
                    <div class="fs-5 fw-bold @(Model.Decision == EvaluationDecisionConstants.Approved ? "text-success" : "text-danger") mt-1">
                        @Model.Decision
                    </div>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ModificationNotes))
            {
                <div class="col-12">
                    <div class="p-3 border rounded bg-white">
                        <div class="text-muted small">الملاحظات والتعديلات المطلوبة:</div>
                        <div class="text-dark mt-1">@Model.ModificationNotes</div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Recommendations))
            {
                <div class="col-12">
                    <div class="p-3 border rounded bg-white">
                        <div class="text-muted small">التوصيات:</div>
                        <div class="text-dark mt-1">@Model.Recommendations</div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Editable Evaluation Form -->
        <form id="evaluationForm" action="/Judge/SubmitEvaluation" method="post" onsubmit="return submitEvaluation(event);">
            <input type="hidden" name="EvaluationId" value="@Model.Id" />

            <div class="card p-3 mb-4 border">
                <h6 class="fw-bold text-primary mb-3">
                    <i class="bi bi-shield-check me-2"></i>معايير التقييم الأخلاقي الثلاثة (إلزامية)
                </h6>

                <div class="row g-3">
                    <!-- 1. Privacy Protection -->
                    <div class="col-md-4">
                        <label class="form-label">1. حماية الخصوصية وسرية البيانات <span class="text-danger">*</span></label>
                        <select name="PrivacyProtectionRating" class="form-select" required>
                            <option value="">-- اختر التقييم --</option>
                            <option value="@EthicsRatingConstants.Appropriate">@EthicsRatingConstants.Appropriate</option>
                            <option value="@EthicsRatingConstants.NeedsModification">@EthicsRatingConstants.NeedsModification</option>
                            <option value="@EthicsRatingConstants.Inappropriate">@EthicsRatingConstants.Inappropriate</option>
                        </select>
                        <div class="form-text small">تدابير حماية وتجهيل هوية المشاركين بالبحث.</div>
                    </div>

                    <!-- 2. Risk Level -->
                    <div class="col-md-4">
                        <label class="form-label">2. نسبة المخاطر والموازنة <span class="text-danger">*</span></label>
                        <select name="RiskLevel" class="form-select" required>
                            <option value="">-- اختر التقييم --</option>
                            <option value="@EthicsRatingConstants.Appropriate">@EthicsRatingConstants.Appropriate</option>
                            <option value="@EthicsRatingConstants.NeedsModification">@EthicsRatingConstants.NeedsModification</option>
                            <option value="@EthicsRatingConstants.Inappropriate">@EthicsRatingConstants.Inappropriate</option>
                        </select>
                        <div class="form-text small">مستوى الأمان الحيوي والتدابير الوقائية.</div>
                    </div>

                    <!-- 3. Informed Consent -->
                    <div class="col-md-4">
                        <label class="form-label">3. إجراءات الموافقة المستنيرة <span class="text-danger">*</span></label>
                        <select name="InformedConsentRating" class="form-select" required>
                            <option value="">-- اختر التقييم --</option>
                            <option value="@EthicsRatingConstants.Appropriate">@EthicsRatingConstants.Appropriate</option>
                            <option value="@EthicsRatingConstants.NeedsModification">@EthicsRatingConstants.NeedsModification</option>
                            <option value="@EthicsRatingConstants.Inappropriate">@EthicsRatingConstants.Inappropriate</option>
                        </select>
                        <div class="form-text small">وضوح استمارة الموافقة وحرية المشاركة.</div>
                    </div>
                </div>
            </div>

            <!-- Decision -->
            <div class="card p-3 mb-4 border">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-gavel me-2 text-primary"></i>قرار التحكيم للجولة الحالية</h6>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">القرار النهائي <span class="text-danger">*</span></label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="Decision" id="decApprove" value="@EvaluationDecisionConstants.Approved" required onchange="toggleModNotes();">
                            <label class="form-check-label text-success fw-bold" for="decApprove">
                                <i class="bi bi-check-circle me-1"></i> موافق (استيفاء المعايير الأخلاقية)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="Decision" id="decModify" value="@EvaluationDecisionConstants.ModificationsRequired" required onchange="toggleModNotes();">
                            <label class="form-check-label text-danger fw-bold" for="decModify">
                                <i class="bi bi-exclamation-triangle me-1"></i> طلب تعديلات (استيفاء ملاحظات ملزمة)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-3" id="modificationNotesDiv" style="display: none;">
                    <label class="form-label">تفاصيل وملاحظات التعديل المطلوبة من الباحث <span class="text-danger">*</span></label>
                    <textarea name="ModificationNotes" id="modNotesField" class="form-control" rows="3" placeholder="اكتب التعديلات المطلوبة بدقة (سيتم إرسالها للباحث دون كشف هويتكم)..."></textarea>
                </div>

                <div class="mb-2">
                    <label class="form-label">توصيات إضافية للجنة (اختياري)</label>
                    <textarea name="Recommendations" class="form-control" rows="2" placeholder="أي توصيات عامة للجنة الفرعية بالكلية"></textarea>
                </div>
            </div>

            <!-- Digital Signature Agreement -->
            <div class="p-3 bg-light rounded border mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="signAgreement" required>
                    <label class="form-check-label small fw-bold" for="signAgreement">
                        أقر أنا المحكم العلمي بأنني قمت بفحص هذا المقترح بشكل مستقل وتجرد تام دون تضارب مصالح، وأصادق على صحة هذا التقييم بتوقيعي الرقمي الموثق.
                    </label>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary-custom px-4 py-2 fs-6">
                    <i class="bi bi-shield-check me-1"></i> اعتماد التقييم والتوقيع الرقمي
                </button>
            </div>
        </form>
    }
</div>

<script>
    function toggleModNotes() {
        if ($('#decModify').is(':checked')) {
            $('#modificationNotesDiv').slideDown();
            $('#modNotesField').prop('required', true);
        } else {
            $('#modificationNotesDiv').slideUp();
            $('#modNotesField').prop('required', false);
        }
    }

    function submitEvaluation(e) {
        e.preventDefault();
        var form = document.getElementById('evaluationForm');
        handleAjaxFormSubmit(form, function (res) {
            alert(res.message);
            loadPartial('/Judge/AssignedResearchesPartial', '#main-content-container', 'assigned-researches');
        });
        return false;
    }
</script>
