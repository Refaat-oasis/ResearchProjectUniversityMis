@model researchProject.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "تعيين كلمة المرور الجديدة - المنصة الإلكترونية";
}

<div class="auth-shell">
    <div class="auth-ledger-panel">
        <div class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-start gap-3">
            <div>
                <h2 class="page-title fw-bold text-dark mb-1">تعيين كلمة المرور الجديدة</h2>
                <p class="text-muted small mb-0">أدخل الرمز المرسل إلى بريدك الإلكتروني مع كلمة المرور الجديدة</p>
            </div>
            <i class="bi bi-shield-lock-fill fs-4" style="color: var(--brand-sovereign);"></i>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-info small p-3 mb-3">
                <i class="bi bi-info-circle me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control font-mono-tabular" placeholder="example@domain.com" dir="ltr" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                    <label asp-for="Token" class="form-label mb-0"></label>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="copyTokenBtn" title="نسخ الرمز">
                            <i class="bi bi-clipboard me-1"></i> نسخ الرمز
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" id="pasteTokenBtn" title="لصق من الحافظة">
                            <i class="bi bi-clipboard-plus me-1"></i> لصق
                        </button>
                    </div>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                    <input asp-for="Token" id="tokenInput" class="form-control font-mono-tabular" placeholder="الصق رمز التحقق المرسل في البريد هنا" dir="ltr" required />
                </div>
                <span asp-validation-for="Token" class="text-danger small"></span>
                <div class="form-text small text-muted" id="tokenCopyNotice">تجد هذا الرمز داخل رسالة البريد الإلكتروني الواردة من المنصة.</div>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="NewPassword" class="form-control font-mono-tabular" placeholder="••••••••" dir="ltr" required />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control font-mono-tabular" placeholder="••••••••" dir="ltr" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 mb-3">
                <i class="bi bi-check-circle me-1"></i> حفظ وتعيين كلمة المرور
            </button>
        </form>

        <div class="border-top pt-3 text-center">
            <a asp-action="Login" class="text-decoration-none small text-muted">
                <i class="bi bi-arrow-right me-1"></i> العودة لشاشة تسجيل الدخول
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Auto copy token to clipboard if pre-filled from email link
            var initialToken = $('#tokenInput').val();
            if (initialToken && initialToken.trim().length === 6) {
                window.safeCopyToClipboard(initialToken.trim(), function () {
                    window.showToast('success', 'تم نسخ وتعبئة رمز استعادة كلمة المرور تلقائياً.');
                });
            }

            $('#copyTokenBtn').on('click', function () {
                var tokenVal = $('#tokenInput').val();
                if (!tokenVal) {
                    window.showToast('error', 'حقل الرمز فارغ، يرجى إدخال أو لصق الرمز أولاً.');
                    return;
                }
                window.safeCopyToClipboard(tokenVal, function () {
                    var $btn = $('#copyTokenBtn');
                    var oldHtml = $btn.html();
                    $btn.html('<i class="bi bi-check2 text-success me-1"></i> تم النسخ!');
                    window.showToast('success', 'تم نسخ رمز التحقق بنجاح.');
                    setTimeout(function () { $btn.html(oldHtml); }, 2000);
                }, function () {
                    window.showToast('error', 'تعذر النسخ تلقائياً، يرجى النسخ يدوياً (Ctrl+C).');
                });
            });

            $('#pasteTokenBtn').on('click', function () {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    navigator.clipboard.readText().then(function (text) {
                        if (text) {
                            $('#tokenInput').val(text.trim());
                            var $btn = $('#pasteTokenBtn');
                            var oldHtml = $btn.html();
                            $btn.html('<i class="bi bi-check2 text-success me-1"></i> تم اللصق!');
                            window.showToast('success', 'تم لصق الرمز بنجاح.');
                            setTimeout(function () { $btn.html(oldHtml); }, 2000);
                        }
                    }).catch(function () {
                        window.showToast('error', 'يرجى لصق الرمز يدوياً داخل الحقل (Ctrl+V).');
                    });
                } else {
                    window.showToast('error', 'يرجى لصق الرمز يدوياً داخل الحقل (Ctrl+V).');
                }
            });
        });
    </script>
}
