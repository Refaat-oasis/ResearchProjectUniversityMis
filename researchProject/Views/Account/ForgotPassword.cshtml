@model researchProject.Models.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "استعادة كلمة المرور - المنصة الإلكترونية";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card card-custom shadow-sm border-0">
                <div class="text-center mb-4">
                    <div class="bg-warning-subtle text-warning d-inline-flex p-3 rounded-circle shadow-sm mb-3">
                        <i class="bi bi-key-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">استعادة كلمة المرور</h4>
                    <p class="text-muted small">أدخل بريدك الإلكتروني المسجل لإرسال رمز التحقق والاستعادة عبر Gmail</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success small p-3 mb-3">
                        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="ForgotPassword" method="post" id="forgotForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="example@domain.com" dir="ltr" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        <div class="form-text small text-muted">سيصلك رمز أمان ورابط مباشر لتعيين كلمة مرور جديدة فوراً.</div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 mb-3 shadow-sm">
                        <i class="bi bi-send me-1"></i> إرسال رمز التحقق
                    </button>
                </form>

                <div class="border-top pt-3 text-center">
                    <a asp-action="Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-right me-1"></i> تذكرت كلمة المرور؟ تسجيل الدخول
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
