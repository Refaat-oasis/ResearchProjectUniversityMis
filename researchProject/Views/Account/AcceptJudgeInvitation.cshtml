@model researchProject.Models.ViewModels.AcceptInvitationViewModel
@{
    ViewData["Title"] = "قبول دعوة الانضمام لهيئة المحكمين";
}

<div class="auth-shell">
    <div class="auth-ledger-panel auth-ledger-wide" style="max-width: 620px;">
        <div class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-start gap-3">
            <div>
                <h2 class="page-title fw-bold text-dark mb-1">قبول دعوة الانضمام لهيئة المحكمين</h2>
                <p class="text-muted small mb-0">اللجنة الفرعية لأخلاقيات البحث العلمي والنزاهة الأكاديمية</p>
                @if (ViewBag.Specialty != null)
                {
                    <div class="mt-2">
                        <span class="status-stamp status-assigned">
                            التخصص المطلوب: <strong>@ViewBag.Specialty</strong>
                        </span>
                    </div>
                }
            </div>
            <i class="bi bi-mortarboard fs-4" style="color: var(--brand-sovereign);"></i>
        </div>

        <div class="alert alert-info small mb-4">
            <i class="bi bi-info-circle-fill me-1"></i>
            تم توجيه هذه الدعوة إلى البريد: <strong class="font-mono-tabular" dir="ltr">@ViewBag.InvitationEmail</strong>. يرجى استكمال بيانات اعتماد حساب المحكم العلمي.
        </div>

        <form asp-action="AcceptJudgeInvitation" method="post">
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" placeholder="الاسم الكامل واللقب العلمي" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AcademicTitle" class="form-label"></label>
                <input asp-for="AcademicTitle" class="form-control" placeholder="مثال: أستاذ دكتور / خبير سريري" />
                <span asp-validation-for="AcademicTitle" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control font-mono-tabular" dir="ltr" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control font-mono-tabular" dir="ltr" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 mb-2">
                <i class="bi bi-check-circle-fill me-1"></i> قبول الدعوة وتفعيل الحساب
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
