@model researchProject.Models.ViewModels.AcceptInvitationViewModel
@{
    ViewData["Title"] = "قبول دعوة الانضمام لهيئة المحكمين";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card card-custom shadow-sm border-0">
                <div class="text-center mb-4">
                    <div class="bg-info text-dark d-inline-flex p-3 rounded-circle shadow-sm mb-3">
                        <i class="bi bi-mortarboard fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">قبول دعوة الانضمام لهيئة المحكمين</h4>
                    <p class="text-muted small">اللجنة الفرعية لأخلاقيات البحث العلمي والنزاهة الأكاديمية</p>
                    
                    @if (ViewBag.Specialty != null)
                    {
                        <div class="badge bg-primary-subtle text-primary p-2 mt-2">
                            التخصص المطلوب: <strong>@ViewBag.Specialty</strong>
                        </div>
                    }
                </div>

                <div class="alert alert-info small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    تم توجيه هذه الدعوة إلى البريد: <strong>@ViewBag.InvitationEmail</strong>. يرجى استكمال بيانات اعتماد حساب المحكم العلمي.
                </div>

                <form asp-action="AcceptJudgeInvitation" method="post">
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" placeholder="الاسم الكامل واللقب العلمي" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AcademicTitle" class="form-label"></label>
                        <input asp-for="AcademicTitle" class="form-control" placeholder="مثال: أستاذ دكتور / خبير سريري" />
                        <span asp-validation-for="AcademicTitle" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" dir="ltr" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" dir="ltr" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 mb-3 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> قبول الدعوة وتفعيل الحساب
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
