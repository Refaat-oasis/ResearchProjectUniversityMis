@model researchProject.Models.ViewModels.VerifyEmailViewModel
@{
    ViewData["Title"] = "تفعيل الحساب وتأكيد البريد الإلكتروني - المنصة الإلكترونية";
}

<div class="auth-shell">
    <div class="auth-ledger-panel">
        <div class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-start gap-3">
            <div>
                <h2 class="page-title fw-bold text-dark mb-1">تأكيد وتفعيل الحساب الأكاديمي</h2>
                <p class="text-muted small mb-0">أدخل بريدك الإلكتروني مع رمز الأمان (OTP) المكوّن من 6 أرقام المرسل عبر Gmail</p>
            </div>
            <i class="bi bi-shield-check fs-4" style="color: var(--brand-sovereign);"></i>
        </div>

        <!-- 15-Minute Expiry Notice -->
        <div class="alert alert-warning small p-2 mb-3 d-flex align-items-center">
            <i class="bi bi-clock-history fs-5 me-2 text-warning"></i>
            <div>
                <strong>مدة صلاحية الرمز:</strong> صالح للاستخدام لمدة <strong>15 دقيقة</strong> فقط من وقت الإرسال.
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success small p-3 mb-3">
                <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage) || ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger small p-3 mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i> @(Model.ErrorMessage ?? ViewBag.ErrorMessage)
            </div>
        }

        <div id="resendAlertContainer"></div>

        <form asp-action="VerifyEmailToken" method="post" id="verifyEmailForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="EmailOrUserId" class="form-label fw-bold">البريد الإلكتروني المسجل <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="EmailOrUserId" id="emailInput" class="form-control font-mono-tabular" placeholder="example@domain.com" dir="ltr" required />
                </div>
            </div>

            <div class="mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                    <label asp-for="Token" class="form-label fw-bold mb-0">رمز التحقق الرقمي (6 أرقام) <span class="text-danger">*</span></label>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" id="copyTokenBtn" title="نسخ الرمز">
                            <i class="bi bi-clipboard me-1"></i> نسخ
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" id="pasteTokenBtn" title="لصق من الحافظة">
                            <i class="bi bi-clipboard-plus me-1"></i> لصق
                        </button>
                    </div>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-key-fill text-primary"></i></span>
                    <input asp-for="Token" id="tokenInput" class="form-control text-center font-mono-tabular fs-4 fw-bold letter-spacing-wide"
                           maxlength="6" inputmode="numeric" pattern="[0-9]{6}" placeholder="------" dir="ltr" required />
                </div>
                <div class="form-text small text-muted">تجد هذا الرمز في رسالة البريد الإلكتروني الواردة إليك.</div>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 mb-3">
                <i class="bi bi-check-circle-fill me-1"></i> تفعيل الحساب والمتابعة
            </button>
        </form>

        <!-- Resend Verification Code Section -->
        <div class="dossier-panel-subtle mb-3 text-center">
            <div class="text-muted small mb-2">لم تستلم الرمز أو انتهت مدة صلاحيته (15 دقيقة)؟</div>
            <button type="button" class="btn btn-outline-secondary btn-sm py-2 px-3 fw-bold" id="resendCodeBtn">
                <i class="bi bi-arrow-clockwise me-1" id="resendSpinnerIcon"></i>
                <span id="resendBtnText">إعادة إرسال رمز التحقق</span>
            </button>
            <div id="cooldownTimer" class="small text-muted mt-2 d-none">
                يمكنك إعادة الإرسال بعد: <span id="secondsLeft" class="font-mono-tabular fw-bold text-primary">60</span> ثانية
            </div>
        </div>

        <div class="border-top pt-3 text-center">
            <a asp-action="Login" class="text-decoration-none small text-muted">
                <i class="bi bi-arrow-right me-1"></i> العودة لشاشة تسجيل الدخول
            </a>
        </div>
    </div>
</div>

<style>
    .letter-spacing-wide {
        letter-spacing: 8px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Auto copy token to clipboard if pre-filled from email link
            var initialToken = $('#tokenInput').val();
            if (initialToken && initialToken.trim().length === 6) {
                window.safeCopyToClipboard(initialToken.trim(), function () {
                    window.showToast('success', 'تم نسخ وتعبئة رمز التحقق تلقائياً من البريد الإلكتروني.');
                });
            }

            // Copy Token Button
            $('#copyTokenBtn').on('click', function () {
                var tokenVal = $('#tokenInput').val();
                if (!tokenVal) {
                    window.showToast('error', 'حقل الرمز فارغ، يرجى إدخال الرمز أولاً.');
                    return;
                }
                window.safeCopyToClipboard(tokenVal, function () {
                    var $btn = $('#copyTokenBtn');
                    var oldHtml = $btn.html();
                    $btn.html('<i class="bi bi-check2 text-success me-1"></i> تم النسخ!');
                    window.showToast('success', 'تم نسخ رمز التحقق للحافظة بنجاح.');
                    setTimeout(function () { $btn.html(oldHtml); }, 2000);
                }, function () {
                    window.showToast('error', 'تعذر النسخ تلقائياً، يرجى النسخ يدوياً (Ctrl+C).');
                });
            });

            // Paste Token Button
            $('#pasteTokenBtn').on('click', function () {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    navigator.clipboard.readText().then(function (text) {
                        if (text) {
                            var clean = text.trim().replace(/\D/g, '').substring(0, 6);
                            $('#tokenInput').val(clean || text.trim().substring(0, 6));
                            var $btn = $('#pasteTokenBtn');
                            var oldHtml = $btn.html();
                            $btn.html('<i class="bi bi-check2 text-success me-1"></i> تم اللصق!');
                            window.showToast('success', 'تم لصق الرمز بنجاح.');
                            setTimeout(function () { $btn.html(oldHtml); }, 2000);
                        }
                    }).catch(function () {
                        window.showToast('error', 'يرجى لصق الرمز يدوياً داخل الحقل (Ctrl+V).');
                    });
                } else {
                    window.showToast('error', 'يرجى لصق الرمز يدوياً داخل الحقل (Ctrl+V).');
                }
            });

            // Auto-advance / limit only numbers in token
            $('#tokenInput').on('input', function () {
                var val = $(this).val();
                var clean = val.replace(/\D/g, '');
                if (val !== clean) {
                    $(this).val(clean);
                }
            });

            // Resend Code with 60-Second Cooldown
            var cooldownSeconds = 0;
            var countdownInterval = null;

            function startCooldown(seconds) {
                cooldownSeconds = seconds;
                $('#resendCodeBtn').prop('disabled', true);
                $('#cooldownTimer').removeClass('d-none');
                $('#secondsLeft').text(cooldownSeconds);

                if (countdownInterval) {
                    clearInterval(countdownInterval);
                }

                countdownInterval = setInterval(function () {
                    cooldownSeconds--;
                    $('#secondsLeft').text(cooldownSeconds);
                    if (cooldownSeconds <= 0) {
                        clearInterval(countdownInterval);
                        $('#resendCodeBtn').prop('disabled', false);
                        $('#cooldownTimer').addClass('d-none');
                        $('#resendBtnText').text('إعادة إرسال رمز التحقق');
                    }
                }, 1000);
            }

            $('#resendCodeBtn').on('click', function () {
                var email = $('#emailInput').val();
                if (!email) {
                    $('#resendAlertContainer').html(
                        '<div class="alert alert-danger small p-2 mb-3">' +
                        '<i class="bi bi-exclamation-triangle me-1"></i> يرجى إدخال البريد الإلكتروني أولاً لطلب رمز جديد.' +
                        '</div>'
                    );
                    $('#emailInput').focus();
                    return;
                }

                var $btn = $(this);
                $btn.prop('disabled', true);
                $('#resendBtnText').text('جارٍ الإرسال...');
                $('#resendSpinnerIcon').addClass('bi-spin');

                var token = $('input[name="__RequestVerificationToken"]').first().val();

                $.ajax({
                    url: '/Account/ResendVerificationCode',
                    type: 'POST',
                    data: {
                        EmailOrUserId: email,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        $('#resendSpinnerIcon').removeClass('bi-spin');
                        if (res.success) {
                            $('#resendAlertContainer').html(
                                '<div class="alert alert-success small p-3 mb-3">' +
                                '<i class="bi bi-check-circle-fill me-1"></i> ' + res.message +
                                '</div>'
                            );
                            startCooldown(60);
                        } else {
                            $('#resendAlertContainer').html(
                                '<div class="alert alert-warning small p-3 mb-3">' +
                                '<i class="bi bi-exclamation-triangle me-1"></i> ' + res.message +
                                '</div>'
                            );
                            $btn.prop('disabled', false);
                            $('#resendBtnText').text('إعادة إرسال رمز التحقق');
                        }
                    },
                    error: function (xhr) {
                        $('#resendSpinnerIcon').removeClass('bi-spin');
                        $btn.prop('disabled', false);
                        $('#resendBtnText').text('إعادة إرسال رمز التحقق');
                        $('#resendAlertContainer').html(
                            '<div class="alert alert-danger small p-3 mb-3">' +
                            '<i class="bi bi-x-circle me-1"></i> تعذر الاتصال بالخادم لإعادة الإرسال. يرجى المحاولة لاحقاً.' +
                            '</div>'
                        );
                    }
                });
            });
        });
    </script>
}
