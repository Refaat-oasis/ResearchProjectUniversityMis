@model researchProject.Models.DTOs.ResearcherSignUpDto
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "تسجيل باحث جديد - المنصة الإلكترونية";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card card-custom shadow-sm border-0">
                <div class="card-header-custom">
                    <div>
                        <h4 class="fw-bold text-primary mb-1">تسجيل باحث أكاديمي جديد</h4>
                        <div class="text-muted small">يرجى إدخال البيانات الأكاديمية بدقة باستخدام البريد المؤسسي الرسمي للجامعة</div>
                    </div>
                    <div class="badge bg-success-subtle text-success p-2 rounded-pill">
                        <i class="bi bi-person-check fs-6 me-1"></i> بوابة الباحثين
                    </div>
                </div>

                <form asp-action="SignUp" method="post" id="signUpForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="الاسم رباعياً باللغة العربية" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="example@univ.edu.eg" dir="ltr" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text small text-muted">يشترط البريد المؤسسي المعتمد (مثل: mis.edu.eg / univ.edu.eg).</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" dir="ltr" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" dir="ltr" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CollegeId" class="form-label"></label>
                            <select asp-for="CollegeId" class="form-select">
                                <option value="">-- اختر الكلية التابع لها --</option>
                                @if (ViewBag.Colleges != null)
                                {
                                    foreach (var c in ViewBag.Colleges)
                                    {
                                        <option value="@c.Id">@c.Name (@c.Code)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CollegeId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ResearcherType" class="form-label"></label>
                            <select asp-for="ResearcherType" class="form-select">
                                <option value="">-- اختر فئة الباحث --</option>
                                <option value="@ResearcherTypeConstants.FacultyMember">@ResearcherTypeConstants.FacultyMember</option>
                                <option value="@ResearcherTypeConstants.Researcher">@ResearcherTypeConstants.Researcher</option>
                                <option value="@ResearcherTypeConstants.PostgraduateStudent">@ResearcherTypeConstants.PostgraduateStudent</option>
                            </select>
                            <span asp-validation-for="ResearcherType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AcademicDegree" class="form-label"></label>
                            <input asp-for="AcademicDegree" class="form-control" placeholder="مثال: أستاذ مساعد / باحث دكتوراه" />
                            <span asp-validation-for="AcademicDegree" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label"></label>
                            <input asp-for="Department" class="form-control" placeholder="القسم العلمي التابع له" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NationalId" class="form-label"></label>
                            <input asp-for="NationalId" class="form-control" maxlength="14" placeholder="14 رقماً قومياً" dir="ltr" />
                            <span asp-validation-for="NationalId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" dir="ltr" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                        <a asp-action="Login" class="text-muted text-decoration-none small">
                            <i class="bi bi-arrow-right me-1"></i> لديك حساب بالفعل؟ تسجيل الدخول
                        </a>
                        <button type="submit" class="btn btn-accent-custom px-4 py-2">
                            <i class="bi bi-check-lg me-1"></i> إتمام التسجيل وتأكيد البريد
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
