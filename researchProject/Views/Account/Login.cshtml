@model researchProject.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول الموحد - منصة النزاهة الأكاديمية";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card card-custom shadow-sm border-0">
                <div class="text-center mb-4">
                    <div class="bg-primary text-white d-inline-flex p-3 rounded-circle shadow-sm mb-3">
                        <i class="bi bi-shield-lock fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">تسجيل الدخول الموحد</h4>
                    <p class="text-muted small">بوابة النزاهة الأكاديمية وأخلاقيات البحث العلمي</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="اسم المستخدم أو البريد الأكاديمي" dir="ltr" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" dir="ltr" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                            <label class="form-check-label small" for="rememberMe">
                                @Html.DisplayNameFor(m => m.RememberMe)
                            </label>
                        </div>
                        <a asp-action="ForgotPassword" class="text-decoration-none small text-muted">
                            نسيت كلمة المرور؟
                        </a>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 fs-6 mb-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-left me-1"></i> الدخول إلى المنصة
                    </button>
                </form>

                <div class="border-top pt-3 text-center">
                    <span class="text-muted small">باحث جديد لأول مرة؟</span>
                    <a asp-action="SignUp" class="text-decoration-none fw-bold small ms-1 text-primary">إنشاء حساب باحث</a>
                    <div class="mt-2">
                        <a asp-action="VerifyEmailToken" class="text-muted small text-decoration-none">
                            <i class="bi bi-shield-check text-success me-1"></i> إدخال رمز تأكيد البريد الإلكتروني
                        </a>
                    </div>
                </div>
            </div>

            <div class="card card-custom p-3 bg-light border text-center small text-muted">
                <i class="bi bi-info-circle text-primary fs-5 mb-1"></i>
                <div>يدخل كافة منسوبي الجامعة (مديرو اللجان، المحكمون، والباحثون) من هذه الشاشة الموحدة.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
