@{
    ViewData["Title"] = "إدارة ومراقبة مهام Hangfire - لوحة المطور";
}

<div class="page-header-card mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 w-100">
        <div>
            <h2><i class="bi bi-cpu-fill text-primary"></i> إدارة ومراقبة المهام الخلفية (Hangfire Monitor)</h2>
            <p class="text-secondary mb-0">لوحة تحكم للمطورين لمراقبة الطوابير الخلفية، مهام إرسال البريد الإلكتروني، والمهام الدورية المجدولة</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/hangfire" target="_blank" class="btn btn-primary-custom d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-box-arrow-up-right"></i>
                فتح لوحة Hangfire في نافذة مستقلة
            </a>
            <a asp-controller="Developer" asp-action="AuditLogs" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i class="bi bi-shield-check"></i>
                سجل تدقيق العمليات
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary">طابور البريد (Emails Queue)</span>
                <i class="bi bi-envelope-paper-heart fs-3 text-warning"></i>
            </div>
            <h5 class="fw-bold mb-2">معالجة رسائل النظام الفورية</h5>
            <p class="small text-white-50 mb-3">معالجة دعوات المحكمين، وتأكيد البريد، وبيانات الاعتماد مع سياسة المحاولات الذكية.</p>
            <div class="mt-auto pt-2 border-top border-secondary border-opacity-25 small text-white-50">
                <i class="bi bi-check-circle-fill text-success me-1"></i> الطابور نشط ومجدول آلياً
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-info">المهام الدورية (Recurring Jobs)</span>
                <i class="bi bi-clock-history fs-3 text-info"></i>
            </div>
            <h5 class="fw-bold mb-2">تنظيف الحسابات غير المؤكدة</h5>
            <p class="small text-white-50 mb-3">مهمة خلفية تعمل كل 12 ساعة لحذف الحسابات المؤقتة التي تجاوزت مهلة التفعيل المسموحة.</p>
            <div class="mt-auto pt-2 border-top border-secondary border-opacity-25 small text-white-50">
                <i class="bi bi-arrow-repeat text-info me-1"></i> الكرون: <code>0 */12 * * *</code>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-success">الصلاحيات والأمان (Authorization)</span>
                <i class="bi bi-shield-shaded fs-3 text-success"></i>
            </div>
            <h5 class="fw-bold mb-2">وصول محمي للمطور والإدارة</h5>
            <p class="small text-white-50 mb-3">لوحة Hangfire محمية بفلتر تفويض أمني يمنح حق الوصول حصرياً لـ Developer و SuperAdmin.</p>
            <div class="mt-auto pt-2 border-top border-secondary border-opacity-25 small text-white-50">
                <i class="bi bi-lock-fill text-warning me-1"></i> مصفاة بواسطة IDashboardAuthorizationFilter
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-speedometer2 text-primary me-2"></i>معاينة لوحة تحكم Hangfire المباشرة</h5>
        <a href="/hangfire" target="_blank" class="btn btn-sm btn-outline-primary">
            تكبير الشاشة <i class="bi bi-arrows-fullscreen ms-1"></i>
        </a>
    </div>
    <div class="card-body p-0">
        <iframe src="/hangfire" style="width: 100%; height: 750px; border: none; background: #fff;" title="Hangfire Live Dashboard"></iframe>
    </div>
</div>
