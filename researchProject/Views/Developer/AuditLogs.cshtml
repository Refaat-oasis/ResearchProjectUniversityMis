@model researchProject.Models.ViewModels.AuditLogListViewModel
@{
    ViewData["Title"] = "سجل رقابة وتدقيق العمليات - لوحة المطور";
}

<div class="page-header-card mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 w-100">
        <div>
            <h2><i class="bi bi-shield-check text-primary"></i> سجل رقابة وتدقيق العمليات (Developer Audit Logs)</h2>
            <p class="text-secondary mb-0">توثيق شامل ومفصل لكافة العمليات، طلبات المستخدمين، العمليات الخلفية، وحالات النجاح والاستثناءات في النظام</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Developer" asp-action="Hangfire" class="btn btn-outline-primary d-inline-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-gear-wide-connected"></i>
                مراقبة مهام Hangfire
            </a>
            <button type="button" class="btn btn-light border d-inline-flex align-items-center gap-1" onclick="reloadAuditLogs()">
                <i class="bi bi-arrow-clockwise"></i>
                تحديث السجلات
            </button>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
    <div class="card-body p-3">
        <form id="auditFilterForm" class="row g-2 align-items-end" onsubmit="event.preventDefault(); currentPage = 1; reloadAuditLogs();">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">بحث نصي (مستخدم، مسار، وصف)</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchTermInput" class="form-control" placeholder="ابحث هنا..." value="@Model.SearchTerm">
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">نوع العملية (Action)</label>
                <select id="actionFilterInput" class="form-select form-select-sm">
                    <option value="">جميع العمليات (All Actions)</option>
                    <option value="Login">تسجيل الدخول (Login)</option>
                    <option value="SignUp">تسجيل باحث جديد (SignUp)</option>
                    <option value="VerifyCode">تأكيد البريد والأمان (VerifyCode)</option>
                    <option value="SubmitResearch">تقديم مقترح بحثي (SubmitResearch)</option>
                    <option value="ModifyResearch">تعديل مقترح بحثي (ModifyResearch)</option>
                    <option value="FormalScreening">الفحص الشكلي (FormalScreening)</option>
                    <option value="AssignJudges">إسناد المحكمين (AssignJudges)</option>
                    <option value="InviteJudge">دعوة محكمين (InviteJudge)</option>
                    <option value="SubmitEvaluation">إرسال التقييم (SubmitEvaluation)</option>
                    <option value="FinalApproval">الاعتماد وإصدار الشهادة (FinalApproval)</option>
                    <option value="SaveCollege">إدارة الكليات (SaveCollege)</option>
                    <option value="SaveDepartment">إدارة الأقسام (SaveDepartment)</option>
                    <option value="SaveCategory">إدارة التصنيفات (SaveCategory)</option>
                    <option value="ToggleCoAdminStatus">تعطيل/تفعيل مشرف كلية</option>
                    <option value="RemoveCoAdminFromCollege">إزالة مدير كلية</option>
                    <option value="ToggleResearcherStatus">تعطيل/تفعيل باحث</option>
                    <option value="ToggleJudgeStatus">تعطيل/تفعيل محكم</option>
                    <option value="Download">تحميل المرفقات (Download)</option>
                    <option value="Hangfire">مراقبة مهام Hangfire</option>
                    <option value="AuditLogs">استعراض سجلات الرقابة (AuditLogs)</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">الدور الوظيفي</label>
                <select id="roleFilterInput" class="form-select form-select-sm">
                    <option value="">جميع الأدوار</option>
                    <option value="Developer">Developer (مطور المنصة)</option>
                    <option value="SuperAdmin">SuperAdmin (مدير النظام)</option>
                    <option value="CollegeCoAdmin">CollegeCoAdmin (مشرف كلية)</option>
                    <option value="Judge">Judge (محكم)</option>
                    <option value="Researcher">Researcher (باحث)</option>
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label small fw-bold text-secondary mb-1">حالة العملية</label>
                <select id="successFilterInput" class="form-select form-select-sm">
                    <option value="">الكل</option>
                    <option value="true">ناجحة</option>
                    <option value="false">أخطاء</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-bold text-secondary mb-1">من تاريخ</label>
                <input type="date" id="fromDateInput" class="form-control form-control-sm">
            </div>

            <div class="col-md-1">
                <label class="form-label small fw-bold text-secondary mb-1">إلى تاريخ</label>
                <input type="date" id="toDateInput" class="form-control form-control-sm">
            </div>

            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-filter"></i> تصفية
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Table Container Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="background: rgba(255, 255, 255, 0.98);">
    <div id="auditLogsContainer">
        @await Html.PartialAsync("_AuditLogsPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;

        function loadAuditLogsPage(page) {
            currentPage = page;
            reloadAuditLogs();
        }

        function reloadAuditLogs() {
            const container = document.getElementById('auditLogsContainer');
            const searchTerm = document.getElementById('searchTermInput').value;
            const actionFilter = document.getElementById('actionFilterInput').value;
            const roleFilter = document.getElementById('roleFilterInput').value;
            const successFilter = document.getElementById('successFilterInput').value;
            const fromDate = document.getElementById('fromDateInput').value;
            const toDate = document.getElementById('toDateInput').value;

            const baseUrl = '@Url.Action("AuditLogsPartial", "Developer")';
            const url = new URL(baseUrl, window.location.origin);
            url.searchParams.set('page', currentPage);
            if (searchTerm) url.searchParams.set('searchTerm', searchTerm);
            if (actionFilter) url.searchParams.set('actionFilter', actionFilter);
            if (roleFilter) url.searchParams.set('roleFilter', roleFilter);
            if (successFilter) url.searchParams.set('successFilter', successFilter);
            if (fromDate) url.searchParams.set('fromDate', fromDate);
            if (toDate) url.searchParams.set('toDate', toDate);

            container.style.opacity = '0.5';
            fetch(url)
                .then(res => {
                    if (!res.ok) {
                        throw new Error('HTTP ' + res.status);
                    }
                    return res.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    container.style.opacity = '1';
                })
                .catch(err => {
                    console.error('Audit Log Fetch Error:', err);
                    container.innerHTML = '<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle me-2"></i>حدث خطأ أثناء تحميل سجلات التدقيق. يرجى إعادة المحاولة.</div>';
                    container.style.opacity = '1';
                });
        }
    </script>
}
