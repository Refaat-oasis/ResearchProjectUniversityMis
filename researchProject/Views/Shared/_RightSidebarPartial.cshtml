@using researchProject.Models.Constants
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool IsActive(string ctrl, params string[] actions)
    {
        if (!string.Equals(currentCtrl, ctrl, StringComparison.OrdinalIgnoreCase)) return false;
        if (actions.Length == 0) return true;
        foreach (var a in actions)
        {
            if (string.Equals(currentAct, a, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }
}

<aside class="right-sidebar">
    <!-- User Portal Role Stamps -->
    <div class="sidebar-roles-panel">
        <div class="sidebar-roles-caption">الأدوار الممنوحة للحساب:</div>
        <div class="d-flex flex-wrap gap-1">
            @if (User.IsInRole(RoleConstants.SuperAdmin))
            {
                <span class="role-stamp role-stamp-admin">مدير النظام العام</span>
            }
            @if (User.IsInRole(RoleConstants.CollegeCoAdmin))
            {
                <span class="role-stamp role-stamp-coadmin">مدير اللجنة الفرعية</span>
            }
            @if (User.IsInRole(RoleConstants.Judge))
            {
                <span class="role-stamp role-stamp-judge">محكم علمي</span>
            }
            @if (User.IsInRole(RoleConstants.Researcher))
            {
                <span class="role-stamp role-stamp-researcher">باحث أكاديمي</span>
            }
        </div>

        @if (User.IsInRole(RoleConstants.Judge) && !User.IsInRole(RoleConstants.Researcher))
        {
            <div class="sidebar-promo-box text-center">
                <div class="small fw-semibold mb-2 sidebar-promo-title">باحث أكاديمي؟</div>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-primary w-100 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> تفعيل صفة باحث
                </a>
            </div>
        }
    </div>

    <!-- 1. Super Admin Section -->
    @if (User.IsInRole(RoleConstants.SuperAdmin))
    {
        <div class="sidebar-section">
            <div class="sidebar-heading">
                <i class="bi bi-shield-lock-fill"></i> بوابة الإدارة العليا
            </div>
            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Index" class="@(IsActive("SuperAdmin", "Index", "Dashboard") ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> لوحة المؤشرات المركزية
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Colleges" class="@(IsActive("SuperAdmin", "Colleges") ? "active" : "")">
                        <i class="bi bi-buildings"></i> إدارة كليات الجامعة
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Categories" class="@(IsActive("SuperAdmin", "Categories") ? "active" : "")">
                        <i class="bi bi-sliders"></i> تصنيفات الأبحاث ونماذجها
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="CoAdmins" class="@(IsActive("SuperAdmin", "CoAdmins") ? "active" : "")">
                        <i class="bi bi-person-badge"></i> مديرو اللجان الفرعية
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Judges" class="@(IsActive("SuperAdmin", "Judges") ? "active" : "")">
                        <i class="bi bi-mortarboard"></i> هيئة المحكمين والدعوات
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Researches" class="@(IsActive("SuperAdmin", "Researches", "ResearchDetails") ? "active" : "")">
                        <i class="bi bi-journal-text"></i> كافة مقترحات الجامعة
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Reports" class="@(IsActive("SuperAdmin", "Reports") ? "active" : "")">
                        <i class="bi bi-graph-up-arrow"></i> تقارير الجودة والاعتماد
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="SuperAdmin" asp-action="Certificates" class="@(IsActive("SuperAdmin", "Certificates") ? "active" : "")">
                        <i class="bi bi-archive"></i> أرشيف الشهادات الأخلاقية
                    </a>
                </li>
            </ul>
        </div>
    }

    <!-- 2. College Co-Admin Section -->
    @if (User.IsInRole(RoleConstants.CollegeCoAdmin))
    {
        <div class="sidebar-section">
            <div class="sidebar-heading">
                <i class="bi bi-person-workspace"></i> إدارة اللجنة الفرعية بالكلية
            </div>
            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a asp-controller="CollegeCoAdmin" asp-action="ScreeningQueue" class="@(IsActive("CollegeCoAdmin", "ScreeningQueue", "Index", "Review") ? "active" : "")">
                        <i class="bi bi-hourglass-split"></i> طابور الفحص الشكلي
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="CollegeCoAdmin" asp-action="FinalApproval" class="@(IsActive("CollegeCoAdmin", "FinalApproval") ? "active" : "")">
                        <i class="bi bi-award"></i> اعتماد وإصدار الشهادات
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="CollegeCoAdmin" asp-action="InviteJudge" class="@(IsActive("CollegeCoAdmin", "InviteJudge") ? "active" : "")">
                        <i class="bi bi-envelope-plus"></i> دعوة محكم علمي
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="CollegeCoAdmin" asp-action="Reports" class="@(IsActive("CollegeCoAdmin", "Reports") ? "active" : "")">
                        <i class="bi bi-pie-chart"></i> إحصائيات وتقارير الكلية
                    </a>
                </li>
            </ul>
        </div>
    }

    <!-- 3. Judge Section -->
    @if (User.IsInRole(RoleConstants.Judge))
    {
        <div class="sidebar-section">
            <div class="sidebar-heading">
                <i class="bi bi-clipboard2-check"></i> بوابة المحكمين
            </div>
            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a asp-controller="Judge" asp-action="AssignedResearches" class="@(IsActive("Judge", "AssignedResearches", "Index", "Evaluate") ? "active" : "")">
                        <i class="bi bi-file-earmark-medical"></i> الأبحاث المسندة للتحكيم
                    </a>
                </li>
            </ul>
        </div>
    }

    <!-- 4. Researcher Section -->
    @if (User.IsInRole(RoleConstants.Researcher))
    {
        <div class="sidebar-section">
            <div class="sidebar-heading">
                <i class="bi bi-pencil-square"></i> بوابة الباحثين
            </div>
            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a asp-controller="Researcher" asp-action="Create" class="@(IsActive("Researcher", "Create") ? "active" : "")">
                        <i class="bi bi-file-earmark-plus"></i> تقديم مقترح بحثي جديد
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="Researcher" asp-action="MyResearches" class="@(IsActive("Researcher", "MyResearches", "Index", "Tracker", "Modify") ? "active" : "")">
                        <i class="bi bi-folder2-open"></i> مقترحاتي ومتابعة الحالات
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="Researcher" asp-action="Certificates" class="@(IsActive("Researcher", "Certificates") ? "active" : "")">
                        <i class="bi bi-patch-check-fill"></i> شهاداتي الأخلاقية المعتمدة
                    </a>
                </li>
            </ul>
        </div>
    }

    <!-- 5. Profile & Account Settings -->
    <div class="sidebar-footer-section mt-auto">
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a asp-controller="Account" asp-action="Profile" class="@(IsActive("Account", "Profile") ? "active" : "")">
                    <i class="bi bi-person-gear"></i> الملف الشخصي والحساب
                </a>
            </li>
        </ul>
    </div>
</aside>
