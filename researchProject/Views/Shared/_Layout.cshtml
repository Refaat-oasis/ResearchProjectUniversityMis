@using Microsoft.AspNetCore.Identity
@using researchProject.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "المنصة الإلكترونية لأخلاقيات البحث العلمي والنزاهة الأكاديمية")</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/favicon-192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true" />

    <!-- Typography: Authentic Egyptian University Font - Cairo -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Bootstrap RTL 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <partial name="_SeoMetaTagsPartial" model="ViewBag.Seo" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()

    <!-- Top Navigation Header -->
    <header class="app-navbar">
        <div class="d-flex flex-wrap flex-sm-nowrap justify-content-between align-items-center gap-2 app-navbar-inner">
            <div class="d-flex align-items-center gap-2 gap-md-3 min-w-0">
                @if (SignInManager.IsSignedIn(User))
                {
                    <button class="btn btn-sm navbar-toggle-btn d-flex align-items-center justify-content-center flex-shrink-0" id="sidebarToggleBtn" type="button" title="طي / فتح القائمة الجانبية">
                        <i class="bi bi-layout-sidebar-inset-reverse fs-6"></i>
                    </button>
                }
                <a class="brand-text d-flex align-items-center gap-2 min-w-0" href="/">
                    <img src="~/images/brand/assiut-university-logo.png" asp-append-version="true" alt="شعار الجامعة" class="brand-crest-img flex-shrink-0" width="38" height="38" />
                    <div class="min-w-0">
                        <div class="brand-title">المنصة الإلكترونية لأخلاقيات البحث العلمي</div>
                        <div class="brand-subtitle d-none d-md-block">اللجان الفرعية للنزاهة الأكاديمية - جامعة مصر الأكاديمية</div>
                    </div>
                </a>
            </div>

            <!-- Center Public Links (Desktop/Tablet) -->
            @{
                var navCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                var navAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                bool isHome = string.Equals(navCtrl, "Home", StringComparison.OrdinalIgnoreCase);
            }
            <nav class="d-none d-lg-flex align-items-center gap-1" aria-label="التنقل العام">
                <a asp-controller="Home" asp-action="Index"
                   class="navbar-nav-link @(isHome && string.Equals(navAct, "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   aria-current="@(isHome && string.Equals(navAct, "Index", StringComparison.OrdinalIgnoreCase) ? "page" : null)">الرئيسية</a>
                <a asp-controller="Home" asp-action="About"
                   class="navbar-nav-link @(isHome && string.Equals(navAct, "About", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   aria-current="@(isHome && string.Equals(navAct, "About", StringComparison.OrdinalIgnoreCase) ? "page" : null)">عن المنصة</a>
                <a asp-controller="Home" asp-action="Developers"
                   class="navbar-nav-link @(isHome && string.Equals(navAct, "Developers", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   aria-current="@(isHome && string.Equals(navAct, "Developers", StringComparison.OrdinalIgnoreCase) ? "page" : null)">فريق المطورين</a>
            </nav>

            <div class="d-flex align-items-center gap-2 flex-shrink-0 app-navbar-actions">
                <a asp-controller="Public" asp-action="VerifyCertificate" class="btn btn-sm navbar-verify-btn">التحقق من صحة شهادة</a>

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);

                    <!-- Archival Ledger Notification Center Dropdown -->
                    <div class="dropdown" id="notifDropdown">
                        <button class="notif-bell-btn" type="button" id="notifBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="مركز الإشعارات">
                            <i class="bi bi-bell"></i>
                            <span class="notif-badge-pill" id="notifBadge" style="display:none;">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-start notif-ledger-dropdown" aria-labelledby="notifBellBtn">
                            <div class="notif-header">
                                <h6><i class="bi bi-bell-fill"></i> مركز التنبيهات والإشعارات</h6>
                                <button type="button" class="notif-mark-all-btn" id="notifMarkAllBtn">
                                    <i class="bi bi-check-all"></i> تحديد الكل كمقروء
                                </button>
                            </div>
                            <div class="notif-list-container" id="notifList">
                                <div class="notif-empty-state">
                                    <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                                    <div>جاري تحميل الإشعارات...</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-sm navbar-user-btn dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-6 text-primary"></i>
                            <span class="fw-semibold d-none d-sm-inline">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-start archival-dropdown-menu mt-2">
                            <li class="px-3 py-2 border-bottom mb-1 archival-dropdown-identity">
                                <div class="fw-bold text-dark small">@(currentUser?.FullName ?? User.Identity?.Name)</div>
                                <div class="small text-muted font-mono-tabular">@currentUser?.Email</div>
                            </li>
                            <li>
                                <a asp-controller="Account" asp-action="Profile" class="dropdown-item d-flex align-items-center gap-2">
                                    <i class="bi bi-person-badge text-primary"></i> الملف الشخصي
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-nav-auth-login">تسجيل الدخول</a>
                    <a asp-controller="Account" asp-action="SignUp" class="btn btn-sm btn-nav-auth-signup">تسجيل باحث جديد</a>
                }
            </div>
        </div>
    </header>

    <!-- Global Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show archival-global-alert m-3" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show archival-global-alert m-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main App Body -->
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="app-container">
            <partial name="_RightSidebarPartial" />
            <main class="main-content">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="public-container">
            @RenderBody()
        </main>

        <footer class="app-colophon-footer">
            <div class="container py-4">
                <div class="row align-items-center g-3">
                    <div class="col-lg-6">
                        <div>
                            <div class="fw-semibold text-white small">المنصة الإلكترونية لأخلاقيات البحث العلمي</div>
                            <div class="colophon-sub small">اللجان الفرعية للنزاهة الأكاديمية - جامعة مصر الأكاديمية</div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="d-flex flex-wrap gap-3 justify-content-lg-end align-items-center small">
                            <a asp-controller="Home" asp-action="Index" class="colophon-link">الرئيسية</a>
                            <a asp-controller="Home" asp-action="About" class="colophon-link">عن المنصة</a>
                            <a asp-controller="Home" asp-action="Developers" class="colophon-link">فريق المطورين</a>
                            <a asp-controller="Public" asp-action="VerifyCertificate" class="colophon-link">التحقق من صحة شهادة</a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    }

    <!-- Mobile Sidebar Overlay Backdrop -->
    <div id="sidebar-overlay" class="sidebar-overlay"></div>

    <!-- Loading Spinner Overlay -->
    <div id="partial-loading-spinner">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Global AJAX setup for Anti-Forgery Token
        $.ajaxSetup({
            headers: {
                'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val()
            }
        });

        // Unified AJAX Partial Loader with Hash Navigation
        function loadPartial(url, targetSelector, hashKey) {
            if (!url) return;
            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: url,
                type: 'GET',
                cache: false,
                success: function (html) {
                    $(targetSelector).html(html);
                    $('#partial-loading-spinner').hide();

                    // Re-parse unobtrusive validation for any forms in the partial
                    $(targetSelector + ' form').each(function () {
                        $.validator.unobtrusive.parse($(this));
                    });

                    // Initialize unified custom datalists in the partial
                    if (typeof initCustomDatalists === 'function') {
                        initCustomDatalists(targetSelector);
                    }

                    // Initialize universal table pagination in the partial
                    if (typeof initUniversalTablePagination === 'function') {
                        initUniversalTablePagination(targetSelector);
                    }

                    // Update sidebar active link
                    $('.sidebar-item a').removeClass('active');
                    if (hashKey) {
                        $('.sidebar-item a[data-hash="' + hashKey + '"]').addClass('active');
                        window.location.hash = hashKey;
                    }

                    // Close mobile drawer after navigation
                    if (window.innerWidth < 992) {
                        $('.right-sidebar').removeClass('show-mobile');
                        $('#sidebar-overlay').removeClass('active');
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    var msg = xhr.responseText || 'حدث خطأ أثناء تحميل المحتوى.';
                    $(targetSelector).html('<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle me-2"></i>' + msg + '</div>');
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
