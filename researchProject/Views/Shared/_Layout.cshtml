@using Microsoft.AspNetCore.Identity
@using researchProject.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "المنصة الإلكترونية لأخلاقيات البحث العلمي والنزاهة الأكاديمية")</title>
    
    <!-- Bootstrap RTL 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()

    <!-- Top Navigation Header -->
    <header class="app-navbar">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <a class="brand-text" href="/">
                    <i class="bi bi-shield-check text-warning fs-3"></i>
                    <div>
                        <div>المنصة الإلكترونية لأخلاقيات البحث العلمي</div>
                        <div class="brand-subtitle">اللجان الفرعية للنزاهة الأكاديمية - جامعة مصر الأكاديمية</div>
                    </div>
                </a>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Public" asp-action="VerifyCertificate" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="bi bi-qr-code-scan me-1"></i> التحقق من صحة شهادة
                </a>

                @if (SignInManager.IsSignedIn(User))
                {
                    var currentUser = await UserManager.GetUserAsync(User);
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5 text-primary"></i>
                            <span class="fw-bold">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-start shadow border-0 mt-2">
                            <li class="px-3 py-1 text-muted small border-bottom mb-2">
                                <div>@currentUser?.Email</div>
                            </li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i> تسجيل الخروج
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-light px-3 fw-bold rounded-pill">تسجيل الدخول</a>
                    <a asp-controller="Account" asp-action="SignUp" class="btn btn-sm btn-success px-3 fw-bold rounded-pill">تسجيل باحث جديد</a>
                }
            </div>
        </div>
    </header>

    <!-- Global Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3 shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3 shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main App Body -->
    @RenderBody()

    <!-- Loading Spinner Overlay -->
    <div id="partial-loading-spinner">
        <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status">
            <span class="visually-hidden">جاري التحميل...</span>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Global AJAX setup for Anti-Forgery Token
        $.ajaxSetup({
            headers: {
                'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val()
            }
        });

        // Unified AJAX Partial Loader with Hash Navigation
        function loadPartial(url, targetSelector, hashKey) {
            if (!url) return;
            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: url,
                type: 'GET',
                cache: false,
                success: function (html) {
                    $(targetSelector).html(html);
                    $('#partial-loading-spinner').hide();

                    // Re-parse unobtrusive validation for any forms in the partial
                    $(targetSelector + ' form').each(function () {
                        $.validator.unobtrusive.parse($(this));
                    });

                    // Update sidebar active link
                    $('.sidebar-item a').removeClass('active');
                    if (hashKey) {
                        $('.sidebar-item a[data-hash="' + hashKey + '"]').addClass('active');
                        window.location.hash = hashKey;
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    var msg = xhr.responseText || 'حدث خطأ أثناء تحميل المحتوى.';
                    $(targetSelector).html('<div class="alert alert-danger m-3"><i class="bi bi-exclamation-triangle me-2"></i>' + msg + '</div>');
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
