@model researchProject.Models.DTOs.ResearchCreateDto
@{
    ViewData["Title"] = "تقديم مقترح بحثي جديد";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-file-earmark-plus text-success"></i> تقديم مقترح بحثي جديد للجنة الأخلاقيات</h2>
        <p>يرجى تعبئة بيانات المقترح ورفع المستندات الإلزامية الثلاثة (الموافقة المستنيرة، أدوات البحث، خطة البحث)</p>
    </div>
    <span class="badge bg-light text-dark fs-6 p-2 border">
        الكلية التابع لها: <strong>@(ViewBag.ResearcherCollege?.Name ?? "غير محدد")</strong>
    </span>
</div>

<div class="liquid-glass-card">
    <form id="createResearchForm" asp-action="CreateResearch" method="post" enctype="multipart/form-data">
        <input type="hidden" name="CollegeId" value="@(ViewBag.ResearcherCollege?.Id ?? 1)" />

        <div class="row g-3 mb-4">
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="Title" class="form-control" required placeholder="العنوان الأكاديمي الدقيق للمقترح البحثي" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label"></label> <span class="text-danger">*</span>
                <input type="hidden" asp-for="CategoryId" id="CategoryId" />
                <div class="dedicated-dropdown-wrapper" data-target-input="#CategoryId">
                    <div class="dedicated-dropdown-input-group">
                        <i class="bi bi-search dedicated-dropdown-icon-right"></i>
                        <input type="text" class="dedicated-dropdown-input" placeholder="ابحث أو اختر نوع وتصنيف البحث..." required autocomplete="off" />
                        <div class="dedicated-dropdown-actions-left">
                            <button type="button" class="dedicated-dropdown-clear-btn" title="مسح">
                                <i class="bi bi-x-lg"></i>
                            </button>
                            <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>
                    <div class="dedicated-dropdown-menu">
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories)
                            {
                                <div class="dedicated-dropdown-item" data-id="@cat.Id" data-name="@cat.Name">
                                    <span>@cat.Name</span>
                                    <span class="dedicated-dropdown-item-badge">معتمد بالكلية</span>
                                </div>
                            }
                        }
                    </div>
                </div>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="AcademicSpecialty" class="form-label"></label> <span class="text-danger">*</span>
                <input asp-for="AcademicSpecialty" class="form-control" required placeholder="مثال: العلوم الصيدلية / علم الأدوية السريري" />
                <span asp-validation-for="AcademicSpecialty" class="text-danger small"></span>
            </div>
        </div>

        <!-- Dynamic Category Fields Container -->
        <div id="dynamicFieldsContainer" class="mb-4"></div>

        <!-- Mandatory Attachments Card -->
        <div class="card p-3 mb-4 border bg-light rounded-3">
            <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-paperclip me-2 text-primary"></i>المستندات والوثائق الإلزامية
            </h6>

            <div class="row g-3">
                <!-- 1. Informed Consent -->
                <div class="col-md-6">
                    <label class="form-label">1. وثيقة الموافقة المستنيرة (Informed Consent) <span class="text-danger">*</span></label>
                    <input type="file" name="InformedConsentFile" class="form-control" required accept=".pdf,.doc,.docx" />
                    <div class="form-text small">نموذج الإقرار والموافقة المستنيرة للمشاركين بالبحث (PDF, DOCX).</div>
                </div>

                <!-- 2. Research Tools -->
                <div class="col-md-6">
                    <label class="form-label">2. أدوات وأجهزة البحث (Research Tools) <span class="text-danger">*</span></label>
                    <input type="file" name="ResearchToolsFile" class="form-control" required accept=".pdf,.doc,.docx,.xls,.xlsx" />
                    <div class="form-text small">الاستبيانات، استمارات المقابلات، أو بروتوكول التجارب المعملية.</div>
                </div>

                <!-- 3. Research Proposal Plan -->
                <div class="col-md-6">
                    <label class="form-label">3. خطة المقترح البحثي الكاملة (Research Proposal) <span class="text-danger">*</span></label>
                    <input type="file" name="ResearchProposalFile" class="form-control" required accept=".pdf,.doc,.docx" />
                    <div class="form-text small">الخطة البحثية المتضمنة الأهداف والمنهجية العلمية والاعتبارات الأخلاقية.</div>
                </div>

                <!-- 4. Additional Documents (Optional) -->
                <div class="col-md-6">
                    <label class="form-label">4. مستندات وملاحق إضافية (اختياري)</label>
                    <input type="file" name="AdditionalDocumentFile" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx" />
                    <div class="form-text small">موافقات جهات خارجية، مذكرات تعاون، أو ملاحق تكميلية.</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="MyResearches" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-right me-1"></i> العودة للمقترحات
            </a>
            <button type="submit" class="btn btn-accent-custom px-4 py-2 fs-6">
                <i class="bi bi-send-check-fill me-1"></i> تقديم المقترح البحثي واعتماد الرفع
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $('#CategoryId').on('change', function () {
            var catId = $(this).val();
            loadCategoryFields(catId);
        });

        function loadCategoryFields(categoryId) {
            if (!categoryId) {
                $('#dynamicFieldsContainer').empty();
                return;
            }
            $.get('/Researcher/DynamicCategoryFieldsPartial?categoryId=' + categoryId, function (html) {
                $('#dynamicFieldsContainer').html(html);
                if (typeof initDedicatedDropdowns === 'function') {
                    initDedicatedDropdowns('#dynamicFieldsContainer');
                }
            });
        }

        $('#createResearchForm').on('submit', function (e) {
            e.preventDefault();
            const form = this;

            // Check for empty 0-byte files before sending
            const fileInputs = $(form).find('input[type="file"]');
            for (let i = 0; i < fileInputs.length; i++) {
                const files = fileInputs[i].files;
                if (files && files.length > 0) {
                    if (files[0].size === 0) {
                        window.showToast('error', 'الملف المرفق (' + files[0].name + ') فارغ (حجمه 0 بايت). يرجى التأكد من اختيار ملف صالح يحتوي على محتوى.');
                        return false;
                    }
                }
            }

            const formData = new FormData(form);

            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    if (res && res.success) {
                        window.showToast('success', res.message || 'تم تقديم المقترح البحثي بنجاح.');
                        setTimeout(function () {
                            window.location.href = res.researchId ? '/Researcher/Tracker/' + res.researchId : '/Researcher/MyResearches';
                        }, 1200);
                    } else {
                        window.showToast('error', res.message || 'حدث خطأ أثناء التقديم.');
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    var errMsg = 'حدث خطأ أثناء الاتصال بالخادم.';
                    try {
                        var json = JSON.parse(xhr.responseText);
                        if (json && json.message) errMsg = json.message;
                    } catch (e) {
                        if (xhr.responseText) errMsg = xhr.responseText;
                    }
                    window.showToast('error', errMsg);
                }
            });
        });
    </script>
}

