@model List<researchProject.Models.Entities.Research>

<div class="card-custom archival-card">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">شهاداتي الأخلاقية المعتمدة</h4>
            <div class="text-muted small">سجل الشهادات الأخلاقية الرسمية الصادرة لمقترحاتك البحثية المعتمدة</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover ledger-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الرقم المسلسل للشهادة</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>الكلية</th>
                    <th>تاريخ الاعتماد</th>
                    <th>فحص الكود (QR)</th>
                    <th>تحميل الوثيقة</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        <tr>
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-semibold font-mono-tabular text-nowrap" dir="ltr">@r.CertificateSerialNumber</td>
                            <td class="fw-medium" style="min-width: 200px; max-width: 280px;">@r.Title</td>
                            <td class="text-nowrap small">@r.College?.Name</td>
                            <td class="text-muted small font-mono-tabular text-nowrap" dir="ltr">@(r.CertificateIssuedAt?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                <div class="table-actions-inline">
                                    <a href="@r.CertificateQrCodeUrl" target="_blank" class="btn btn-sm btn-outline-secondary text-decoration-none">
                                        <i class="bi bi-qr-code"></i> فحص رسمي
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    <a href="/Researcher/DownloadCertificate?researchId=@r.Id" target="_blank" class="btn btn-sm btn-primary-custom fw-medium" title="تحميل الشهادة المعتمدة">
                                        <i class="bi bi-download"></i> تحميل الشهادة
                                    </a>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            لا توجد شهادات أخلاقية صادرة لك حتى الآن. بمجرد اعتماد أبحاثك من لجان الأخلاقيات، ستظهر شهاداتك هنا.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
