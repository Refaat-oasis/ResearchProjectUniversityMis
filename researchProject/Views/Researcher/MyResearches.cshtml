@model List<researchProject.Models.Entities.Research>
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "مقترحاتي البحثية ومتابعة الحالات";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-folder2-open"></i> مقترحاتي البحثية ومتابعة الحالات</h2>
        <p>تتبع مسار كافة الأبحاث المقدمة منكم للجان الأخلاقيات والنزاهة الأكاديمية بالجامعة</p>
    </div>
    <a asp-action="Create" class="btn btn-accent-custom">
        <i class="bi bi-plus-lg me-1"></i> تقديم مقترح جديد
    </a>
</div>

<div class="card-custom archival-card">
    <div class="table-responsive">
        <table class="table table-hover ledger-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>التصنيف والتخصص</th>
                    <th>تاريخ التقديم</th>
                    <th>الحالة الحالية</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        string badgeClass = r.WorkflowStatus switch
                        {
                            ResearchStatusConstants.UnderFormalScreening => "status-screening",
                            ResearchStatusConstants.AssignedToJudges => "status-assigned",
                            ResearchStatusConstants.ModificationsRequired => "status-modifications",
                            ResearchStatusConstants.Approved => "status-approved",
                            ResearchStatusConstants.CertificateIssued => "status-issued",
                            _ => "status-inactive"
                        };

                        <tr>
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-bold" style="min-width: 200px; max-width: 280px;">@r.Title</td>
                            <td>
                                <div>@r.Category?.Name</div>
                                <div class="text-muted small">@r.AcademicSpecialty</div>
                            </td>
                            <td class="text-muted small font-mono-tabular" style="white-space: nowrap;" dir="ltr">@r.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td><span class="status-stamp @badgeClass">@r.WorkflowStatus</span></td>
                            <td>
                                <div class="table-actions-inline">
                                    <a asp-action="Tracker" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-activity"></i> تتبع المسار
                                    </a>

                                    @if (r.WorkflowStatus == ResearchStatusConstants.ModificationsRequired)
                                    {
                                        <a asp-action="Modify" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger fw-bold">
                                            <i class="bi bi-upload"></i> رفع التعديلات
                                        </a>
                                    }

                                    @if (r.WorkflowStatus == ResearchStatusConstants.CertificateIssued)
                                    {
                                        <a asp-action="DownloadCertificate" asp-route-researchId="@r.Id" target="_blank" class="btn btn-sm btn-primary-custom">
                                            <i class="bi bi-download"></i> الشهادة
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 text-muted"></i>
                            لم تقم بتقديم أي مقترحات بحثية حتى الآن.
                            <div class="mt-3">
                                <a asp-action="Create" class="btn btn-primary-custom btn-sm">
                                    <i class="bi bi-plus-lg me-1"></i> تقديم أول مقترح الآن
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
