@model researchProject.Models.Entities.ResearchCategory
@using System.Text.Json

@if (Model != null && !string.IsNullOrWhiteSpace(Model.FieldsDefinitionJson))
{
    <div class="card p-3 bg-light border mb-3">
        <h6 class="fw-bold text-primary mb-3">
            <i class="bi bi-ui-radios-grid me-2"></i>حقول نموذج التقديم الخاصة بتصنيف: « @Model.Name »
        </h6>

        <div class="row g-3">
            @{
                try
                {
                    using var doc = JsonDocument.Parse(Model.FieldsDefinitionJson);
                    foreach (var element in doc.RootElement.EnumerateArray())
                    {
                        var name = element.GetProperty("Name").GetString() ?? "";
                        var label = element.TryGetProperty("Label", out var lProp) ? lProp.GetString() : name;
                        var type = element.TryGetProperty("Type", out var tProp) ? tProp.GetString()?.ToLowerInvariant() : "text";
                        var isReq = element.TryGetProperty("IsRequired", out var rProp) && rProp.GetBoolean();

                        <div class="col-md-6">
                            <label class="form-label">
                                @label
                                @if (isReq)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @if (type == "textarea")
                            {
                                <textarea name="DynamicAnswers[@name]" class="form-control" rows="2" @(isReq ? "required" : "") placeholder="@label"></textarea>
                            }
                            else if (type == "number")
                            {
                                <input type="number" name="DynamicAnswers[@name]" class="form-control" @(isReq ? "required" : "") placeholder="@label" />
                            }
                            else if (type == "date")
                            {
                                <input type="date" name="DynamicAnswers[@name]" class="form-control" @(isReq ? "required" : "") />
                            }
                            else if (type == "yesno")
                            {
                                <select name="DynamicAnswers[@name]" class="form-select" @(isReq ? "required" : "")>
                                    <option value="">-- اختر (نعم / لا) --</option>
                                    <option value="نعم">نعم</option>
                                    <option value="لا">لا</option>
                                </select>
                            }
                            else if (type == "dropdown")
                            {
                                var inputId = "dynDrop_" + name.Replace(" ", "_");
                                <input type="hidden" name="DynamicAnswers[@name]" id="@inputId" />
                                <div class="dedicated-dropdown-wrapper" data-target-input="#@inputId">
                                    <div class="dedicated-dropdown-input-group">
                                        <i class="bi bi-search dedicated-dropdown-icon-right"></i>
                                        <input type="text" class="dedicated-dropdown-input" placeholder="-- اختر من الخيارات أو ابحث --" @(isReq ? "required" : "") autocomplete="off" />
                                        <div class="dedicated-dropdown-actions-left">
                                            <button type="button" class="dedicated-dropdown-clear-btn" title="مسح">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                            <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة">
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="dedicated-dropdown-menu">
                                        @if (element.TryGetProperty("Options", out var optsProp) && optsProp.ValueKind == JsonValueKind.Array)
                                        {
                                            foreach (var opt in optsProp.EnumerateArray())
                                            {
                                                var optVal = opt.GetString() ?? "";
                                                <div class="dedicated-dropdown-item" data-id="@optVal" data-name="@optVal">
                                                    <span>@optVal</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input type="text" name="DynamicAnswers[@name]" class="form-control" @(isReq ? "required" : "") placeholder="@label" />
                            }
                        </div>
                    }
                }
                catch
                {
                    <div class="col-12 text-muted small">تعذر قراءة الحقول الإضافية.</div>
                }
            }
        </div>
    </div>
}
