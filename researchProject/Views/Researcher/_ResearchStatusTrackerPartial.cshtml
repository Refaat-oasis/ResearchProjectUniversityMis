@model researchProject.Models.Entities.Research
@using researchProject.Models.Constants

@{
    int currentStep = 1;
    if (Model.WorkflowStatus == ResearchStatusConstants.UnderFormalScreening) currentStep = 1;
    else if (Model.WorkflowStatus == ResearchStatusConstants.AssignedToJudges) currentStep = 2;
    else if (Model.WorkflowStatus == ResearchStatusConstants.ModificationsRequired) currentStep = 3;
    else if (Model.WorkflowStatus == ResearchStatusConstants.Approved) currentStep = 4;
    else if (Model.WorkflowStatus == ResearchStatusConstants.CertificateIssued) currentStep = 5;

    string GetStatusStampClass(string? status) => status switch
    {
        ResearchStatusConstants.UnderFormalScreening => "status-screening",
        ResearchStatusConstants.AssignedToJudges => "status-assigned",
        ResearchStatusConstants.ModificationsRequired => "status-modifications",
        ResearchStatusConstants.Approved => "status-approved",
        ResearchStatusConstants.CertificateIssued => "status-issued",
        _ => "status-inactive"
    };
}

<style>
    .archival-stage-ledger {
        position: relative;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .archival-stage-ledger::before {
        content: '';
        position: absolute;
        top: 22px;
        bottom: 22px;
        right: 17px;
        width: 1px;
        background-color: var(--border-hairline, #E2E8F0);
        z-index: 0;
    }
    .archival-stage-item {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 7px 0;
    }
    .archival-stage-marker {
        width: 34px;
        height: 34px;
        border-radius: 3px;
        border: 1px solid var(--border-hairline, #E2E8F0);
        background-color: var(--bg-surface, #FFFFFF);
        color: var(--ink-muted, #64748B);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.88rem;
        font-weight: 600;
        flex-shrink: 0;
    }
    .archival-stage-row {
        flex: 1;
        min-width: 0;
        padding: 9px 14px;
        background-color: var(--bg-surface, #FFFFFF);
        border: 1px solid var(--border-hairline, #E2E8F0);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }
    .archival-stage-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--ink-secondary, #475569);
    }
    .archival-stage-item.step-completed .archival-stage-marker {
        background-color: var(--brand-sovereign, #0E2235);
        border-color: var(--brand-sovereign, #0E2235);
        color: #FFFFFF;
    }
    .archival-stage-item.step-completed .archival-stage-label {
        color: var(--ink-primary, #0E2235);
    }
    .archival-stage-item.step-active .archival-stage-marker {
        background-color: var(--brand-brass-soft, #FBF5E8);
        border: 1.5px solid var(--brand-brass, #B88E38);
        color: var(--brand-sovereign, #0E2235);
        font-weight: 700;
    }
    .archival-stage-item.step-active .archival-stage-row {
        border-color: var(--brand-brass, #B88E38);
        background-color: var(--brand-brass-soft, #FBF5E8);
    }
    .archival-stage-item.step-active .archival-stage-label {
        color: var(--brand-sovereign, #0E2235);
        font-weight: 700;
    }
    .archival-stage-item.step-modifications .archival-stage-marker {
        background-color: var(--tone-modifications-bg, #FDF1F2);
        border: 1.5px solid var(--tone-modifications-ink, #8C1D24);
        color: var(--tone-modifications-ink, #8C1D24);
        font-weight: 700;
    }
    .archival-stage-item.step-modifications .archival-stage-row {
        border-color: var(--tone-modifications-border, #E8B4B8);
        background-color: var(--tone-modifications-bg, #FDF1F2);
    }
    .archival-stage-item.step-modifications .archival-stage-label {
        color: var(--tone-modifications-ink, #8C1D24);
        font-weight: 700;
    }
</style>

<div class="card-custom archival-card" id="trackerCardContainer" data-research-id="@Model.Id">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-activity" style="color: var(--brand-sovereign);"></i> تتبع مسار المقترح البحثي (Status Tracker)
            </h4>
            <div class="text-muted small">« @Model.Title » - كلية @Model.College?.Name</div>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm" onclick="loadPartial('/Researcher/MyResearchesPartial', '#main-content-container', 'my-researches');">
                <i class="bi bi-arrow-right me-1"></i> العودة لقائمتي
            </button>
        </div>
    </div>

    <!-- Swiss-Archival Vertical Stage Ledger -->
    <div class="dossier-panel dossier-panel-subtle mb-4">
        <ol class="archival-stage-ledger">
            <!-- Stage 1 -->
            <li class="archival-stage-item @(currentStep > 1 ? "step-completed" : (currentStep == 1 ? "step-active" : ""))">
                <div class="archival-stage-marker font-mono-tabular">
                    @if (currentStep > 1) { <i class="bi bi-check-lg"></i> } else { <span>1</span> }
                </div>
                <div class="archival-stage-row">
                    <span class="archival-stage-label">المراجعة الشكلية</span>
                </div>
            </li>

            <!-- Stage 2 -->
            <li class="archival-stage-item @(currentStep > 2 ? "step-completed" : (currentStep == 2 ? "step-active" : ""))">
                <div class="archival-stage-marker font-mono-tabular">
                    @if (currentStep > 2) { <i class="bi bi-check-lg"></i> } else { <span>2</span> }
                </div>
                <div class="archival-stage-row">
                    <span class="archival-stage-label">مسند للمحكمين</span>
                </div>
            </li>

            <!-- Stage 3 (Modifications or Under Review) -->
            <li class="archival-stage-item @(currentStep > 3 ? "step-completed" : (currentStep == 3 ? "step-modifications" : ""))">
                <div class="archival-stage-marker font-mono-tabular">
                    @if (currentStep > 3) { <i class="bi bi-check-lg"></i> } else { <span>3</span> }
                </div>
                <div class="archival-stage-row">
                    <span class="archival-stage-label">@(currentStep == 3 ? "تعديلات مطلوبة" : "مراجعة التعديلات")</span>
                </div>
            </li>

            <!-- Stage 4 -->
            <li class="archival-stage-item @(currentStep > 4 ? "step-completed" : (currentStep == 4 ? "step-active" : ""))">
                <div class="archival-stage-marker font-mono-tabular">
                    @if (currentStep > 4) { <i class="bi bi-check-lg"></i> } else { <span>4</span> }
                </div>
                <div class="archival-stage-row">
                    <span class="archival-stage-label">معتمد بالكامل</span>
                </div>
            </li>

            <!-- Stage 5 -->
            <li class="archival-stage-item @(currentStep == 5 ? "step-completed" : "")">
                <div class="archival-stage-marker font-mono-tabular">
                    @if (currentStep == 5) { <i class="bi bi-patch-check-fill"></i> } else { <span>5</span> }
                </div>
                <div class="archival-stage-row">
                    <span class="archival-stage-label">صادر الشهادة</span>
                </div>
            </li>
        </ol>
    </div>

    <!-- Status Action Banner -->
    @if (Model.WorkflowStatus == ResearchStatusConstants.ModificationsRequired)
    {
        <div class="alert alert-danger p-3 my-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3" style="border-right: 3px solid var(--tone-modifications-ink);">
            <div>
                <h6 class="fw-bold mb-1" style="color: var(--tone-modifications-ink);"><i class="bi bi-exclamation-triangle-fill me-1"></i>تعديلات مطلوبة من المحكمين</h6>
                <div class="small">يرجى مراجعة الملاحظات المدونة أدناه وإعادة رفع خطة البحث أو الأدوات المعدلة.</div>
            </div>
            <button class="btn btn-danger btn-sm fw-bold px-3 flex-shrink-0" onclick="loadPartial('/Researcher/UploadModificationsPartial/@Model.Id', '#main-content-container', 'my-researches');">
                <i class="bi bi-upload me-1"></i> رفع الملفات المعدلة الآن
            </button>
        </div>
    }
    else if (Model.WorkflowStatus == ResearchStatusConstants.CertificateIssued)
    {
        <div class="alert alert-success p-3 my-3 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3" style="border-right: 3px solid var(--brand-sovereign);">
            <div>
                <h6 class="fw-bold mb-1" style="color: var(--brand-sovereign);"><i class="bi bi-patch-check-fill me-1"></i>تم إصدار الشهادة الأخلاقية الرسمية بنجاح!</h6>
                <div class="small">رقم الشهادة: <strong class="font-mono-tabular" dir="ltr">@Model.CertificateSerialNumber</strong> (تاريخ الإصدار: <span class="font-mono-tabular" dir="ltr">@Model.CertificateIssuedAt?.ToString("yyyy/MM/dd")</span>)</div>
            </div>
            <a href="/Researcher/DownloadCertificate?researchId=@Model.Id" target="_blank" class="btn btn-primary-custom btn-sm fw-bold px-3 flex-shrink-0">
                <i class="bi bi-download me-1"></i> تحميل الشهادة (HTML / PDF)
            </a>
        </div>
    }

    <!-- Timeline of Status Changes -->
    <h6 class="fw-bold mt-4 mb-3 pb-2 border-bottom" style="color: var(--ink-primary); border-color: var(--border-hairline) !important;">
        <i class="bi bi-clock-history me-2" style="color: var(--brand-sovereign);"></i>سجل المسار وتاريخ الحالات
    </h6>
    <div class="table-responsive">
        <table class="table ledger-table table-sm align-middle">
            <thead>
                <tr>
                    <th>تاريخ الإجراء</th>
                    <th>الحالة السابقة</th>
                    <th>الحالة الجديدة</th>
                    <th>بيان الإجراء / ملاحظات اللجنة</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ResearchStatusHistories != null && Model.ResearchStatusHistories.Any())
                {
                    foreach (var h in Model.ResearchStatusHistories.OrderByDescending(h => h.ChangedAt))
                    {
                        <tr>
                            <td class="text-muted small font-mono-tabular" style="white-space: nowrap;" dir="ltr">@h.ChangedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(h.OldStatus))
                                {
                                    <span class="status-stamp @GetStatusStampClass(h.OldStatus)">@h.OldStatus</span>
                                }
                                else
                                {
                                    <span class="status-stamp status-inactive">طلب جديد</span>
                                }
                            </td>
                            <td><span class="status-stamp @GetStatusStampClass(h.NewStatus)">@h.NewStatus</span></td>
                            <td class="small" style="min-width: 200px; max-width: 450px; white-space: pre-line;">@h.Reason</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Polling Notice -->
    <div class="text-muted text-center small mt-3">
        <i class="bi bi-arrow-repeat me-1 spin-icon"></i> يتم تحديث حالة هذا المقترح تلقائياً كل 30 ثانية.
    </div>
</div>

<script>
    // Polling every 30 seconds per Rule Section 5.5 (prevent interval timer leak)
    if (window.trackerPollInterval) {
        clearInterval(window.trackerPollInterval);
    }
    window.trackerPollInterval = setInterval(function () {
        var $tracker = $('#trackerCardContainer');
        if ($tracker.length && $tracker.is(':visible')) {
            var researchId = $tracker.data('research-id');
            if (researchId) {
                $.get('/Researcher/ResearchStatusTrackerPartial/' + researchId, function (html) {
                    $('#main-content-container').html(html);
                });
            }
        } else {
            clearInterval(window.trackerPollInterval);
            window.trackerPollInterval = null;
        }
    }, 30000);
</script>
