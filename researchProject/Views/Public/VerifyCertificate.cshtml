@model researchProject.Models.ViewModels.CertificateVerificationResultViewModel
@{
    ViewData["Title"] = "التحقق من صحة الشهادة الأخلاقية";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="verify-dossier verify-dossier-engraved">
                <div class="pb-3 mb-4 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div>
                        <h2 class="page-title editorial-display-title fw-bold text-dark mb-1">التحقق الرسمي من الشهادات الأخلاقية</h2>
                        <p class="text-muted small mb-0">نظام التحقق الإلكتروني المعتمد - جامعة مصر الأكاديمية</p>
                    </div>
                    <div class="verify-icon-badge" aria-hidden="true">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                </div>

                <form asp-controller="Public" asp-action="VerifyCertificate" method="get" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="serialNumber" value="@Model.SerialNumber" class="form-control form-control-lg font-mono-tabular" placeholder="أدخل الرقم المسلسل للشهادة (مثال: REC-MED-2026-123456)" dir="ltr" />
                        <button type="submit" class="btn btn-primary-custom px-3 px-md-4">
                            <i class="bi bi-search me-1"></i> فحص وتحقق
                        </button>
                    </div>
                </form>

                @if (!string.IsNullOrEmpty(Model.SerialNumber))
                {
                    if (Model.IsValid)
                    {
                        <div class="border p-4" style="border-color: var(--tone-approved-border) !important; background-color: var(--bg-canvas); border-radius: var(--radius-md);">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                                <span class="verify-dossier-seal">
                                    <i class="bi bi-patch-check-fill"></i> شهادة معتمدة ورسمية
                                </span>
                                <div class="text-muted small">@Model.Message</div>
                            </div>

                            <table class="colophon-table mt-0">
                                <tbody>
                                    <tr>
                                        <th>الرقم المسلسل المعتمد:</th>
                                        <td class="font-mono-tabular fw-bold text-dark" dir="ltr">@Model.SerialNumber</td>
                                    </tr>
                                    <tr>
                                        <th>عنوان المقترح البحثي:</th>
                                        <td class="fw-bold text-primary">« @Model.ResearchTitle »</td>
                                    </tr>
                                    <tr>
                                        <th>الكلية التابع لها البحث:</th>
                                        <td>@Model.CollegeName</td>
                                    </tr>
                                    <tr>
                                        <th>تاريخ الاعتماد والإصدار:</th>
                                        <td class="font-mono-tabular" dir="ltr">@(Model.IssueDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                    </tr>
                                    <tr>
                                        <th>الجهة المانحة:</th>
                                        <td>اللجنة الفرعية لأخلاقيات البحث العلمي والنزاهة الأكاديمية</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger p-4 mb-0">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-x-circle-fill fs-5"></i>
                                <h5 class="fw-bold mb-0">شهادة غير صالحة أو غير مسجلة</h5>
                            </div>
                            <p class="mb-0 small">@Model.Message</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
