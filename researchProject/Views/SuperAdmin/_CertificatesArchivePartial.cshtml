@model List<researchProject.Models.Entities.Research>

<div class="card card-custom">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-archive text-primary"></i> الأرشيف الرقمي الموحد للشهادات الأخلاقية
            </h4>
            <div class="text-muted small">قاعدة بيانات موثقة لجميع الشهادات الأخلاقية الصادرة مع إمكانية البحث والتحقق والطباعة</div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="p-3 bg-light rounded border mb-4">
        <form id="archiveSearchForm" onsubmit="return searchArchive(event);">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small">الرقم المسلسل للشهادة</label>
                    <input type="text" id="arcSerial" class="form-control form-control-sm" placeholder="REC-..." dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">اسم الباحث</label>
                    <input type="text" id="arcResearcher" class="form-control form-control-sm" placeholder="ابحث باسم الباحث" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">الكلية</label>
                    <select id="arcCollege" class="form-select form-select-sm">
                        <option value="">-- كافة الكليات --</option>
                        @if (ViewBag.Colleges != null)
                        {
                            foreach (var c in ViewBag.Colleges)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-custom btn-sm w-100">
                        <i class="bi bi-search me-1"></i> بحث في الأرشيف
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Archive Results Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>الرقم المسلسل</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>الكلية</th>
                    <th>الباحث</th>
                    <th>تاريخ الإصدار</th>
                    <th>رمز QR والتحقق</th>
                    <th>عرض الشهادة</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var author = r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";
                        <tr>
                            <td>@index</td>
                            <td class="fw-bold font-monospace text-success" dir="ltr">@r.CertificateSerialNumber</td>
                            <td class="fw-bold" style="max-width: 250px;">@r.Title</td>
                            <td><span class="badge bg-light text-dark border">@r.College?.Name</span></td>
                            <td>@author</td>
                            <td class="text-muted small">@(r.CertificateIssuedAt?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                <a href="@r.CertificateQrCodeUrl" target="_blank" class="badge bg-primary text-decoration-none">
                                    <i class="bi bi-qr-code me-1"></i> فحص عام
                                </a>
                            </td>
                            <td>
                                <a href="/Researcher/DownloadCertificate?researchId=@r.Id" target="_blank" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-file-earmark-pdf"></i> فتح الشهادة
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">لا توجد شهادات صادرة تطابق معايير البحث.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function searchArchive(e) {
        e.preventDefault();
        var serial = $('#arcSerial').val();
        var researcher = $('#arcResearcher').val();
        var college = $('#arcCollege').val();

        var query = '?serialNumber=' + encodeURIComponent(serial) +
                    '&researcherName=' + encodeURIComponent(researcher) +
                    '&collegeId=' + encodeURIComponent(college);

        loadPartial('/SuperAdmin/CertificatesArchivePartial' + query, '#main-content-container', 'archive');
        return false;
    }
</script>
