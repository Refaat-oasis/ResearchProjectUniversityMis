@model List<researchProject.Models.Entities.Research>

<div class="card card-custom archival-card">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-archive"></i> الأرشيف الرقمي الموحد للشهادات الأخلاقية
            </h4>
            <div class="small" style="color: var(--ink-muted);">قاعدة بيانات موثقة لجميع الشهادات الأخلاقية الصادرة مع إمكانية البحث والتحقق والطباعة</div>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="dossier-panel-subtle mb-4">
        <form id="archiveSearchForm" onsubmit="return searchArchive(event);">
            <div class="row g-2">
                <div class="col-12 col-md-3">
                    <label class="form-label small">الرقم المسلسل للشهادة</label>
                    <input type="text" id="arcSerial" class="form-control form-control-sm font-mono-tabular" placeholder="REC-..." dir="ltr" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small">اسم الباحث</label>
                    <input type="text" id="arcResearcher" class="form-control form-control-sm" placeholder="ابحث باسم الباحث" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small">الكلية</label>
                    <div class="dedicated-dropdown-wrapper">
                        <input type="hidden" id="arcCollege" />
                        <input type="text" id="arcCollegeInput" class="form-control form-control-sm dedicated-dropdown-input" placeholder="ابحث أو اختر الكلية..." autocomplete="off" />
                        <div class="dedicated-dropdown-menu" id="arcCollegesMenu">
                            <div class="dedicated-dropdown-item" data-value="" data-label="كل الكليات">
                                <span class="text-muted">كل الكليات</span>
                            </div>
                            @if (ViewBag.Colleges != null)
                            {
                                foreach (var c in ViewBag.Colleges)
                                {
                                    <div class="dedicated-dropdown-item" data-value="@c.Id" data-label="@c.Name">
                                        <div class="fw-bold">@c.Name</div>
                                        <small class="text-muted">@c.Code</small>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-custom btn-sm w-100">
                        <i class="bi bi-search me-1"></i> بحث في الأرشيف
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Archive Results Table -->
    <div class="table-responsive">
        <table class="table ledger-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الرقم المسلسل</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>الكلية</th>
                    <th>الباحث</th>
                    <th>تاريخ الإصدار</th>
                    <th>رمز QR والتحقق</th>
                    <th>عرض الشهادة</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var author = r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";
                        <tr>
                            <td class="font-mono-tabular">@index</td>
                            <td><span class="status-stamp status-approved font-mono-tabular" dir="ltr">@r.CertificateSerialNumber</span></td>
                            <td class="fw-bold" style="max-width: 250px; color: var(--ink-primary);">@r.Title</td>
                            <td><span class="status-stamp">@r.College?.Name</span></td>
                            <td>@author</td>
                            <td class="font-mono-tabular small" style="color: var(--ink-muted);">@(r.CertificateIssuedAt?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td>
                                <div class="table-actions-inline">
                                    <a href="@r.CertificateQrCodeUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-qr-code"></i> فحص عام
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    <a href="/Researcher/DownloadCertificate?researchId=@r.Id" target="_blank" class="btn btn-sm btn-outline-success" title="استعراض الشهادة الرسمية">
                                        <i class="bi bi-file-earmark-pdf"></i> فتح الشهادة
                                    </a>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4" style="color: var(--ink-muted);">لا توجد شهادات صادرة تطابق معايير البحث.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    if (typeof initDedicatedDropdowns === 'function') {
        initDedicatedDropdowns();
    }

    function searchArchive(e) {
        e.preventDefault();
        var serial = $('#arcSerial').val();
        var researcher = $('#arcResearcher').val();
        var college = $('#arcCollege').val();

        var query = '?serialNumber=' + encodeURIComponent(serial) +
                    '&researcherName=' + encodeURIComponent(researcher) +
                    '&collegeId=' + encodeURIComponent(college);

        loadPartial('/SuperAdmin/CertificatesArchivePartial' + query, '#main-content-container', 'archive');
        return false;
    }
</script>
