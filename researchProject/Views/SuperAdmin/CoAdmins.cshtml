@model List<researchProject.Models.Entities.CollegeCoAdmin>
@{
    ViewData["Title"] = "إدارة مديري اللجان الفرعية بالكليات";
}

<div class="page-header-card">
    <div>
        <h1 class="page-title"><i class="bi bi-person-badge"></i> إدارة مديري اللجان الفرعية بالكليات</h1>
        <p>تعيين مديري اللجان لكل كلية، وإعادة تعيين الكليات المسندة، وإدارة تفعيل أو تعطيل حساباتهم</p>
    </div>
    <button class="btn btn-brass btn-sm" data-bs-toggle="modal" data-bs-target="#addCoAdminModal">
        <i class="bi bi-person-plus-fill me-1"></i> تعيين مدير لجنة جديد
    </button>
</div>

<div class="card-custom archival-card mb-4">
    <div class="table-responsive">
        <table class="table ledger-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الاسم الكامل</th>
                    <th>البريد الإلكتروني</th>
                    <th>الكلية المسندة</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var a in Model)
                    {
                        bool isActive = a.IsActive && (a.User?.IsActive ?? true);
                        <tr>
                            <td class="font-mono-tabular">@index</td>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-person-badge-fill text-primary me-1"></i>
                                @a.User?.FullName
                            </td>
                            <td dir="ltr" class="text-end font-mono-tabular small">@a.User?.Email</td>
                            <td>
                                <span class="status-stamp status-assigned">
                                    <i class="bi bi-building me-1"></i>@(a.College?.Name ?? "غير محدد")
                                </span>
                            </td>
                            <td>
                                @if (isActive)
                                {
                                    <span class="status-stamp status-approved">نشط</span>
                                }
                                else
                                {
                                    <span class="status-stamp status-inactive">معطل</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    <button class="btn btn-sm @(isActive ? "btn-outline-danger" : "btn-outline-success")"
                                            onclick="toggleCoAdminStatus(@a.Id, @(!isActive ? "true" : "false"))">
                                        <i class="bi @(isActive ? "bi-person-x" : "bi-person-check") me-1"></i>
                                        @(isActive ? "تعطيل" : "تفعيل")
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary ms-1"
                                            onclick="openReassignModal(@a.Id, @a.CollegeId, '@a.User?.FullName', '@(a.College?.Name ?? "")')">
                                        <i class="bi bi-arrow-left-right me-1"></i>
                                        تغيير الكلية
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5" style="color: var(--ink-muted);">لا يوجد مديرو لجان مسجلون حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Add Co-Admin (Tabs: New User vs Existing User) -->
<div class="modal fade" id="addCoAdminModal" tabindex="-1" aria-labelledby="addCoAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addCoAdminModalLabel">
                    <i class="bi bi-person-plus me-2 text-primary"></i>تعيين مدير لجنة فرعية لكلية
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <ul class="nav nav-tabs nav-fill border-bottom px-3 pt-2" id="coAdminTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold" id="new-user-tab" data-bs-toggle="tab" data-bs-target="#newUserTabPane" type="button" role="tab">
                        <i class="bi bi-person-plus-fill me-1"></i> إنشاء حساب جديد
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold" id="existing-user-tab" data-bs-toggle="tab" data-bs-target="#existingUserTabPane" type="button" role="tab">
                        <i class="bi bi-person-check-fill me-1"></i> اختيار مستخدم مسجل بالنظام
                    </button>
                </li>
            </ul>

            <div class="tab-content p-3" id="coAdminTabsContent">
                <!-- Tab 1: New User -->
                <div class="tab-pane fade show active" id="newUserTabPane" role="tabpanel">
                    <form id="createCoAdminForm" asp-action="CreateCoAdminNewUser" method="post">
                        <div class="mb-3">
                            <label class="form-label">الكلية المسندة <span class="text-danger">*</span></label>
                            <input type="hidden" name="collegeId" id="newCoAdminCollegeId" required />
                            <div class="dedicated-dropdown-wrapper" data-target-input="#newCoAdminCollegeId">
                                <div class="dedicated-dropdown-input-group">
                                    <i class="bi bi-building dedicated-dropdown-icon-right"></i>
                                    <input type="text" class="dedicated-dropdown-input" placeholder="ابحث أو اختر الكلية..." required autocomplete="off" />
                                    <div class="dedicated-dropdown-actions-left">
                                        <button type="button" class="dedicated-dropdown-clear-btn" title="مسح"><i class="bi bi-x-lg"></i></button>
                                        <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة"><i class="bi bi-chevron-down"></i></button>
                                    </div>
                                </div>
                                <div class="dedicated-dropdown-menu">
                                    @if (ViewBag.Colleges != null)
                                    {
                                        foreach (var c in ViewBag.Colleges)
                                        {
                                            <div class="dedicated-dropdown-item" data-value="@c.Id" data-label="@c.Name">
                                                <div class="fw-bold">@c.Name</div>
                                                <small class="text-muted">@c.Code</small>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" class="form-control" required placeholder="مثال: أ.د. أحمد محمد علي" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">البريد الإلكتروني المؤسسي <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control" required placeholder="coadmin@university.edu.eg" dir="ltr" />
                            <div class="form-text small">سيقوم النظام بإنشاء الحساب وتعيين كلمة مرور مؤقتة وإرسالها إلى البريد مباشرة.</div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-primary-custom">إنشاء وتعيين مدير الكلية</button>
                        </div>
                    </form>
                </div>

                <!-- Tab 2: Existing User -->
                <div class="tab-pane fade" id="existingUserTabPane" role="tabpanel">
                    <form id="addExistingCoAdminForm" asp-action="AddCoAdminExistingUser" method="post">
                        <div class="mb-3">
                            <label class="form-label">المستخدم المسجل بالنظام <span class="text-danger">*</span></label>
                            <input type="hidden" name="userId" id="existingUserId" required />
                            <div class="dedicated-dropdown-wrapper" data-target-input="#existingUserId">
                                <div class="dedicated-dropdown-input-group">
                                    <i class="bi bi-person dedicated-dropdown-icon-right"></i>
                                    <input type="text" class="dedicated-dropdown-input" placeholder="ابحث باسم المستخدم أو البريد..." required autocomplete="off" />
                                    <div class="dedicated-dropdown-actions-left">
                                        <button type="button" class="dedicated-dropdown-clear-btn" title="مسح"><i class="bi bi-x-lg"></i></button>
                                        <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة"><i class="bi bi-chevron-down"></i></button>
                                    </div>
                                </div>
                                <div class="dedicated-dropdown-menu">
                                    @if (ViewBag.SystemUsers != null)
                                    {
                                        foreach (var u in ViewBag.SystemUsers)
                                        {
                                            <div class="dedicated-dropdown-item" data-value="@u.UserId" data-label="@u.FullName (@u.Email)">
                                                <div class="fw-bold">@u.FullName</div>
                                                <small class="text-muted">@u.Email | الدور: @u.RoleName</small>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الكلية المسندة <span class="text-danger">*</span></label>
                            <input type="hidden" name="collegeId" id="existingCoAdminCollegeId" required />
                            <div class="dedicated-dropdown-wrapper" data-target-input="#existingCoAdminCollegeId">
                                <div class="dedicated-dropdown-input-group">
                                    <i class="bi bi-building dedicated-dropdown-icon-right"></i>
                                    <input type="text" class="dedicated-dropdown-input" placeholder="ابحث أو اختر الكلية..." required autocomplete="off" />
                                    <div class="dedicated-dropdown-actions-left">
                                        <button type="button" class="dedicated-dropdown-clear-btn" title="مسح"><i class="bi bi-x-lg"></i></button>
                                        <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة"><i class="bi bi-chevron-down"></i></button>
                                    </div>
                                </div>
                                <div class="dedicated-dropdown-menu">
                                    @if (ViewBag.Colleges != null)
                                    {
                                        foreach (var c in ViewBag.Colleges)
                                        {
                                            <div class="dedicated-dropdown-item" data-value="@c.Id" data-label="@c.Name">
                                                <div class="fw-bold">@c.Name</div>
                                                <small class="text-muted">@c.Code</small>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-success">إسناد الصلاحية والكلية للمستخدم</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reassign College -->
<div class="modal fade" id="reassignCollegeModal" tabindex="-1" aria-labelledby="reassignCollegeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="reassignCollegeModalLabel">
                    <i class="bi bi-arrow-left-right me-2 text-primary"></i>إعادة تعيين الكلية لمدير اللجنة
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="reassignCollegeForm" asp-action="ReassignCoAdminCollege" method="post">
                <input type="hidden" name="coAdminId" id="reassignCoAdminId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted">اسم مدير الكلية:</label>
                        <div class="fw-bold fs-6 text-dark" id="reassignAdminName">-</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">الكلية الحالية:</label>
                        <div class="badge bg-secondary-subtle text-secondary fs-6" id="reassignCurrentCollege">-</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الكلية الجديدة المطلوب النقل إليها <span class="text-danger">*</span></label>
                        <input type="hidden" name="newCollegeId" id="reassignNewCollegeId" required />
                        <div class="dedicated-dropdown-wrapper" data-target-input="#reassignNewCollegeId">
                            <div class="dedicated-dropdown-input-group">
                                <i class="bi bi-building dedicated-dropdown-icon-right"></i>
                                <input type="text" class="dedicated-dropdown-input" placeholder="اختر الكلية الجديدة..." required autocomplete="off" />
                                <div class="dedicated-dropdown-actions-left">
                                    <button type="button" class="dedicated-dropdown-clear-btn" title="مسح"><i class="bi bi-x-lg"></i></button>
                                    <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة"><i class="bi bi-chevron-down"></i></button>
                                </div>
                            </div>
                            <div class="dedicated-dropdown-menu">
                                @if (ViewBag.Colleges != null)
                                {
                                    foreach (var c in ViewBag.Colleges)
                                    {
                                        <div class="dedicated-dropdown-item" data-value="@c.Id" data-label="@c.Name">
                                            <div class="fw-bold">@c.Name</div>
                                            <small class="text-muted">@c.Code</small>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">تأكيد نقل الكلية</button>
                </div>
            </form>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function openReassignModal(coAdminId, currentCollegeId, adminName, currentCollegeName) {
            $('#reassignCoAdminId').val(coAdminId);
            $('#reassignAdminName').text(adminName);
            $('#reassignCurrentCollege').text(currentCollegeName);
            $('#reassignNewCollegeId').val('');
            $('#reassignCollegeModal').find('.dedicated-dropdown-input').val('');
            $('#reassignCollegeModal').modal('show');
        }

        function toggleCoAdminStatus(coAdminId, isActive) {
            var actionText = isActive ? 'تفعيل' : 'تعطيل';
            if (!confirm('هل أنت متأكد من ' + actionText + ' حساب مدير الكلية؟')) return;

            var token = $('input[name="__RequestVerificationToken"]').val();
            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: '/SuperAdmin/ToggleCoAdminStatus',
                type: 'POST',
                data: {
                    coAdminId: coAdminId,
                    isActive: isActive,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    if (res && res.success) {
                        window.showToast('success', res.message || 'تم تحديث حالة الحساب بنجاح.');
                        setTimeout(function () { window.location.reload(); }, 1000);
                    } else {
                        window.showToast('error', res.message || 'فشل تحديث حالة الحساب.');
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    window.showToast('error', xhr.responseText || 'حدث خطأ أثناء الاتصال بالخادم.');
                }
            });
        }

        $('#createCoAdminForm, #addExistingCoAdminForm, #reassignCollegeForm').on('submit', function (e) {
            e.preventDefault();
            var form = this;
            var data = $(form).serialize();

            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: data,
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    if (res && res.success) {
                        $('.modal').modal('hide');
                        window.showToast('success', res.message || 'تمت العملية بنجاح.');
                        setTimeout(function () { window.location.reload(); }, 1200);
                    } else {
                        window.showToast('error', res.message || 'فشلت العملية.');
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    window.showToast('error', xhr.responseText || 'حدث خطأ أثناء الاتصال بالخادم.');
                }
            });
        });

        $(document).ready(function () {
            if (typeof initDedicatedDropdowns === 'function') {
                initDedicatedDropdowns();
            }
        });
    </script>
}
