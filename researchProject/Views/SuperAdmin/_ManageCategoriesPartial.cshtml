@model List<researchProject.Models.Entities.ResearchCategory>

<div class="card card-custom archival-card">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-sliders"></i> تصنيفات الأبحاث ونماذج الحقول الديناميكية
            </h4>
            <div class="small" style="color: var(--ink-muted);">تحديد نوع الأبحاث (بشري، حيواني، سريري، استبيانات) وبناء الحقول التفاعلية الإضافية لكل تصنيف دون تعديل كود النظام</div>
        </div>
        <button class="btn btn-primary-custom btn-sm btn-add-cat-partial">
            <i class="bi bi-plus-lg me-1"></i> إضافة تصنيف جديد
        </button>
    </div>

    <div class="table-responsive">
        <table class="table ledger-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم التصنيف</th>
                    <th>الكلية التابع لها</th>
                    <th>الوصف</th>
                    <th>تعريف الحقول الإضافية</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var cat in Model)
                    {
                        <tr>
                            <td class="font-mono-tabular">@index</td>
                            <td class="fw-bold" style="color: var(--ink-primary);">@cat.Name</td>
                            <td><span class="status-stamp">@cat.College?.Name</span></td>
                            <td class="small" style="max-width: 250px; color: var(--ink-muted);">@(cat.Description ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(cat.FieldsDefinitionJson))
                                {
                                    <span class="status-stamp status-approved">حقول ديناميكية معرفة</span>
                                }
                                else
                                {
                                    <span class="status-stamp status-inactive">لا توجد حقول إضافية</span>
                                }
                            </td>
                            <td>
                                @if (cat.IsActive)
                                {
                                    <span class="status-stamp status-approved">نشط</span>
                                }
                                else
                                {
                                    <span class="status-stamp status-inactive">معطل</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    <button class="btn btn-sm btn-outline-primary btn-edit-cat-partial"
                                            data-id="@cat.Id"
                                            data-college-id="@cat.CollegeId"
                                            data-name="@cat.Name"
                                            data-description="@(cat.Description ?? "")"
                                            data-fields="@(cat.FieldsDefinitionJson ?? "[]")"
                                            title="تعديل وتصميم الحقول">
                                        <i class="bi bi-gear-wide-connected"></i> تعديل وتصميم الحقول
                                    </button>
                                    <button class="btn btn-sm @(cat.IsActive ? "btn-outline-danger" : "btn-outline-success") ms-1 btn-toggle-cat-partial"
                                            data-id="@cat.Id"
                                            data-target-status="@(!cat.IsActive ? "true" : "false")">
                                        <i class="bi @(cat.IsActive ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                        @(cat.IsActive ? "تعطيل" : "تفعيل")
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4" style="color: var(--ink-muted);">لا توجد تصنيفات أبحاث مسجلة حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Category & Dynamic Fields Builder -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel"><i class="bi bi-magic me-2"></i>تصميم تصنيف البحث والحقول التفاعلية</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="categoryForm" action="/SuperAdmin/SaveCategory" method="post" onsubmit="return saveCategoryWithFields(this);">
                <input type="hidden" name="Id" id="catId" value="0" />
                <input type="hidden" name="FieldsDefinitionJson" id="catFieldsJson" value="[]" />

                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">الكلية <span class="text-danger">*</span></label>
                            <div class="dedicated-dropdown-wrapper">
                                <input type="hidden" name="CollegeId" id="catCollegeId" required />
                                <input type="text" id="catCollegeInput" class="form-control dedicated-dropdown-input" placeholder="ابحث أو اختر الكلية..." autocomplete="off" />
                                <div class="dedicated-dropdown-menu" id="partialCatCollegesMenu">
                                    @if (ViewBag.Colleges != null)
                                    {
                                        foreach (var c in ViewBag.Colleges)
                                        {
                                            <div class="dedicated-dropdown-item" data-value="@c.Id" data-label="@c.Name">
                                                <div class="fw-bold">@c.Name</div>
                                                <small class="text-muted">@c.Code</small>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">اسم تصنيف البحث <span class="text-danger">*</span></label>
                            <input type="text" name="Name" id="catName" class="form-control" required placeholder="مثال: أبحاث وتجارب سريرية" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">وصف التصنيف</label>
                            <textarea name="Description" id="catDesc" class="form-control" rows="2" placeholder="وصف موجز لطبيعة الأبحاث المندرجة تحت هذا التصنيف"></textarea>
                        </div>
                    </div>

                    <div class="dossier-panel">
                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                            <h6 class="fw-bold mb-0" style="color: var(--ink-primary);"><i class="bi bi-ui-checks me-2"></i>الحقول الإضافية في نموذج التقديم</h6>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addFieldRow();">
                                <i class="bi bi-plus-circle me-1"></i> إضافة حقل جديد
                            </button>
                        </div>
                        <div class="small mb-3" style="color: var(--ink-muted);">يمكنك تعريف حقول مخصصة (نص، رقم، تاريخ، قائمة منسدلة، نعم/لا) تظهر للباحث عند اختيار هذا التصنيف.</div>

                        <div id="fieldsContainer" class="d-flex flex-column gap-2">
                            <!-- Dynamic field rows inserted here -->
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">حفظ التصنيف والحقول</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var currentFields = [];

    function openFieldsBuilder(id, collegeId, name, desc, fieldsJson) {
        $('#catId').val(id);
        $('#catCollegeId').val(collegeId);
        var $item = $('#partialCatCollegesMenu .dedicated-dropdown-item[data-value="' + collegeId + '"]');
        if ($item.length > 0) {
            $('#catCollegeInput').val($item.data('label'));
        } else {
            $('#catCollegeInput').val('');
        }
        $('#catName').val(name);
        $('#catDesc').val(desc);

        try {
            currentFields = typeof fieldsJson === 'string' ? JSON.parse(fieldsJson) : fieldsJson;
        } catch (e) {
            currentFields = [];
        }

        renderFieldRows();
        $('#addCategoryModal').modal('show');
    }

    function addFieldRow() {
        currentFields.push({
            Name: 'Field_' + (currentFields.length + 1),
            Label: 'حقل إضافي ' + (currentFields.length + 1),
            Type: 'text',
            IsRequired: true,
            Options: []
        });
        renderFieldRows();
    }

    function removeFieldRow(idx) {
        currentFields.splice(idx, 1);
        renderFieldRows();
    }

    function updateFieldOptions(idx, val) {
        if (!val) {
            currentFields[idx].Options = [];
        } else {
            currentFields[idx].Options = val.split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
        }
    }

    function renderFieldRows() {
        var $c = $('#fieldsContainer');
        $c.empty();

        if (currentFields.length === 0) {
            $c.html('<div class="text-muted text-center py-3 small">لا توجد حقول إضافية بعد. انقر على "إضافة حقل جديد" لإدراج حقول مخصصة.</div>');
            return;
        }

        currentFields.forEach(function (f, i) {
            var isDropdown = f.Type === 'dropdown';
            var optionsVal = Array.isArray(f.Options) ? f.Options.join(', ') : (f.Options || '');

            var $card = $('<div class="bg-white p-2 border mx-0 mb-2 rounded" style="border-color: var(--border-hairline) !important;"></div>');
            var $row = $('<div class="row g-2 align-items-center"></div>');

            var $colName = $('<div class="col-12 col-md-3"></div>');
            var $inputName = $('<input type="text" class="form-control form-control-sm font-mono-tabular" placeholder="اسم المعرف (Code)" dir="ltr" />')
                .val(f.Name || '')
                .on('input change', function () { currentFields[i].Name = this.value; });
            $colName.append($inputName);

            var $colLabel = $('<div class="col-12 col-md-4"></div>');
            var $inputLabel = $('<input type="text" class="form-control form-control-sm" placeholder="التسمية العربية للحقل" />')
                .val(f.Label || '')
                .on('input change', function () { currentFields[i].Label = this.value; });
            $colLabel.append($inputLabel);

            var $colType = $('<div class="col-8 col-md-3"></div>');
            var $selectType = $('<select class="form-select form-select-sm"></select>')
                .append($('<option value="text">نص عادي</option>'))
                .append($('<option value="textarea">نص تفصيلي (فقرة)</option>'))
                .append($('<option value="number">رقم</option>'))
                .append($('<option value="date">تاريخ</option>'))
                .append($('<option value="dropdown">قائمة اختيار (MCQ)</option>'))
                .append($('<option value="yesno">نعم / لا</option>'))
                .val(f.Type || 'text')
                .on('change', function () {
                    currentFields[i].Type = this.value;
                    renderFieldRows();
                });
            $colType.append($selectType);

            var $colReq = $('<div class="col-2 col-md-1 text-center"></div>');
            var $formCheck = $('<div class="form-check d-inline-block"></div>');
            var $inputReq = $('<input class="form-check-input" type="checkbox" title="إلزامي؟" />')
                .prop('checked', !!f.IsRequired)
                .on('change', function () { currentFields[i].IsRequired = this.checked; });
            $formCheck.append($inputReq);
            $colReq.append($formCheck);

            var $colDel = $('<div class="col-2 col-md-1 text-center"></div>');
            var $btnDel = $('<button type="button" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>')
                .on('click', function () { removeFieldRow(i); });
            $colDel.append($btnDel);

            $row.append($colName).append($colLabel).append($colType).append($colReq).append($colDel);
            $card.append($row);

            if (isDropdown) {
                var $rowOpt = $('<div class="row g-2 align-items-center mt-1 pt-2 border-top"></div>');
                var $colOpt = $('<div class="col-12"></div>');
                var $optWrap = $('<div class="d-flex align-items-center gap-2 bg-light p-2 rounded border border-dashed"></div>');
                var $badge = $('<span class="badge bg-primary text-nowrap"><i class="bi bi-list-check me-1"></i>خيارات القائمة:</span>');
                var $inputOpt = $('<input type="text" class="form-control form-control-sm" placeholder="أدخل الخيارات مفصولة بفاصلة (مثال: خيار 1, خيار 2, خيار 3)" />')
                    .val(optionsVal)
                    .on('input change', function () { updateFieldOptions(i, this.value); });
                $optWrap.append($badge).append($inputOpt);

                var $hint = $('<div class="text-muted small mt-1 ps-2"><i class="bi bi-info-circle me-1"></i>اكتب الخيارات وافصل بين كل خيار والآخر بفاصلة (,) لتظهر كقائمة منسدلة للباحث.</div>');
                $colOpt.append($optWrap).append($hint);
                $rowOpt.append($colOpt);
                $card.append($rowOpt);
            }

            $c.append($card);
        });
    }

    $(document).off('click', '.btn-add-cat-partial').on('click', '.btn-add-cat-partial', function () {
        openFieldsBuilder(0, 0, '', '', '[]');
    });

    $(document).off('click', '.btn-edit-cat-partial').on('click', '.btn-edit-cat-partial', function () {
        var $btn = $(this);
        openFieldsBuilder(
            $btn.data('id'),
            $btn.data('college-id'),
            $btn.data('name'),
            $btn.data('description'),
            $btn.data('fields')
        );
    });

    $(document).off('click', '.btn-toggle-cat-partial').on('click', '.btn-toggle-cat-partial', function () {
        var id = $(this).data('id');
        var status = $(this).data('target-status') === true || $(this).data('target-status') === 'true';
        toggleCategoryStatusPartial(id, status);
    });

    function toggleCategoryStatusPartial(id, isActive) {
        var actionText = isActive ? 'تفعيل' : 'تعطيل وإخفاء';
        if (!confirm('هل أنت متأكد من ' + actionText + ' هذا التصنيف؟')) return;

        var token = $('input[name="__RequestVerificationToken"]').val();
        $('#partial-loading-spinner').css('display', 'flex');

        $.ajax({
            url: '/SuperAdmin/ToggleCategoryStatus',
            type: 'POST',
            data: { id: id, isActive: isActive, __RequestVerificationToken: token },
            success: function (res) {
                $('#partial-loading-spinner').hide();
                if (res && res.success) {
                    window.showToast('success', res.message || 'تم تحديث حالة التصنيف.');
                    loadPartial('/SuperAdmin/ManageCategoriesPartial', '#main-content-container', 'categories');
                } else {
                    window.showToast('error', res.message || 'فشلت العملية.');
                }
            },
            error: function (xhr) {
                $('#partial-loading-spinner').hide();
                window.showToast('error', xhr.responseText || 'حدث خطأ أثناء الاتصال بالخادم.');
            }
        });
    }

    function saveCategoryWithFields(form) {
        $('#catFieldsJson').val(JSON.stringify(currentFields));
        return handleAjaxFormSubmit(form, function (res) {
            $('#addCategoryModal').modal('hide');
            $('.modal-backdrop').remove();
            loadPartial('/SuperAdmin/ManageCategoriesPartial', '#main-content-container', 'categories');
        });
    }
</script>
