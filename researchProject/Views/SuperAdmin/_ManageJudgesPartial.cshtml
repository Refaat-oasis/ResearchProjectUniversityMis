@model List<researchProject.Models.Entities.Judge>
@using researchProject.Models.Constants

<div class="card card-custom archival-card">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-mortarboard"></i> هيئة المحكمين المعتمدين والدعوات الأكاديمية
            </h4>
            <div class="small" style="color: var(--ink-muted);">إدارة المحكمين وتفعيلهم أو تعطيلهم، ومتابعة روابط الدعوات المرسلة</div>
        </div>
        <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#inviteJudgeModal">
            <i class="bi bi-envelope-plus-fill me-1"></i> إرسال دعوة تحكيم جديدة
        </button>
    </div>

    <!-- Nav Tabs for Active Judges and Invitations -->
    <ul class="nav nav-tabs mb-3" id="judgesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="active-judges-tab" data-bs-toggle="tab" data-bs-target="#active-judges" type="button" role="tab">
                المحكمون المسجلون (<span class="font-mono-tabular">@(Model?.Count ?? 0)</span>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="invitations-tab" data-bs-toggle="tab" data-bs-target="#invitations" type="button" role="tab">
                سجل الدعوات (<span class="font-mono-tabular">@(ViewBag.Invitations != null ? ((List<researchProject.Models.Entities.JudgeInvitation>)ViewBag.Invitations).Count : 0)</span>)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="judgesTabContent">
        <!-- Tab 1: Judges List -->
        <div class="tab-pane fade show active" id="active-judges" role="tabpanel">
            <div class="table-responsive">
                <table class="table ledger-table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم المحكم</th>
                            <th>اللقب الأكاديمي</th>
                            <th>التخصص الدقيق</th>
                            <th>البريد الإلكتروني</th>
                            <th>التقييمات المفتوحة</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var j in Model)
                            {
                                int openEvals = j.Evaluations?.Count(e => e.Decision == EvaluationDecisionConstants.UnderEvaluation) ?? 0;
                                <tr>
                                    <td class="font-mono-tabular">@index</td>
                                    <td class="fw-bold" style="color: var(--ink-primary);">@j.User?.FullName</td>
                                    <td>@j.AcademicTitle</td>
                                    <td><span class="status-stamp">@j.Specialty</span></td>
                                    <td dir="ltr" class="text-end font-mono-tabular small">@j.User?.Email</td>
                                    <td>
                                        <span class="status-stamp @(openEvals > 0 ? "status-screening" : "status-approved") font-mono-tabular">
                                            @openEvals أبحاث
                                        </span>
                                    </td>
                                    <td>
                                        @if (j.IsActive)
                                        {
                                            <span class="status-stamp status-approved">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="status-stamp status-inactive">معطل</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="table-actions-inline">
                                            <button class="btn btn-sm @(j.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    onclick="toggleJudgeStatus(@j.Id, @(!j.IsActive ? "true" : "false"))"
                                                    title="@(j.IsActive ? "تعطيل المحكم" : "تفعيل المحكم")">
                                                <i class="bi @(j.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                                @(j.IsActive ? "تعطيل" : "تفعيل")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4" style="color: var(--ink-muted);">لا يوجد محكمون مسجلون حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab 2: Invitations -->
        <div class="tab-pane fade" id="invitations" role="tabpanel">
            <div class="table-responsive">
                <table class="table ledger-table align-middle">
                    <thead>
                        <tr>
                            <th>البريد الإلكتروني</th>
                            <th>التخصص المطلوب</th>
                            <th>المرسل</th>
                            <th>تاريخ الإرسال</th>
                            <th>تاريخ الانتهاء</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Invitations != null)
                        {
                            foreach (var inv in (List<researchProject.Models.Entities.JudgeInvitation>)ViewBag.Invitations)
                            {
                                <tr>
                                    <td dir="ltr" class="text-end font-mono-tabular">@inv.Email</td>
                                    <td>@(inv.Specialty ?? "عام")</td>
                                    <td>@(inv.InvitedByUser?.FullName ?? "مدير النظام")</td>
                                    <td class="font-mono-tabular small">@inv.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td class="font-mono-tabular small">@inv.ExpiresAt.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        @if (inv.Status == InvitationStatusConstants.Accepted)
                                        {
                                            <span class="status-stamp status-approved">تم القبول</span>
                                        }
                                        else if (inv.Status == InvitationStatusConstants.Pending)
                                        {
                                            <span class="status-stamp status-screening">قيد الانتظار</span>
                                        }
                                        else
                                        {
                                            <span class="status-stamp status-inactive">@inv.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (inv.Status == InvitationStatusConstants.Pending && inv.ExpiresAt > DateTime.UtcNow)
                                        {
                                            <div class="table-actions-inline">
                                                <button class="btn btn-sm btn-outline-danger" onclick="revokeInvitation(@inv.Id)">
                                                    <i class="bi bi-x-circle"></i> إلغاء
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="small" style="color: var(--ink-muted);">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Invite Judge -->
<div class="modal fade" id="inviteJudgeModal" tabindex="-1" aria-labelledby="inviteJudgeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="inviteJudgeModalLabel"><i class="bi bi-envelope-plus me-2"></i>دعوة محكم علمي للانضمام</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="inviteJudgeForm" action="/SuperAdmin/InviteJudge" method="post" onsubmit="return handleAjaxFormSubmit(this, onJudgeInvited);">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني للمحكم <span class="text-danger">*</span></label>
                        <div class="dedicated-dropdown-wrapper">
                            <input type="email" name="email" id="partialJudgeEmailInput" class="form-control dedicated-dropdown-input font-mono-tabular" required placeholder="اكتب بريداً جديداً أو اختر من مستخدمي النظام..." dir="ltr" autocomplete="off" />
                            <div class="dedicated-dropdown-menu" id="partialJudgeUsersMenu">
                                @if (ViewBag.SystemUsers != null)
                                {
                                    foreach (var u in ViewBag.SystemUsers)
                                    {
                                        <div class="dedicated-dropdown-item" data-value="@u.Email" data-label="@u.Email">
                                            <div class="fw-bold">@u.FullName</div>
                                            <small class="text-muted">@u.Email (@u.RoleName)</small>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="form-text small">يمكنك اختيار مستخدم مسجل بالنظام أو كتابة أي بريد جديد وسيتم إرسال رابط الدعوة الرسمية إليه مباشرة.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">التخصص الأكاديمي الدقيق</label>
                        <input type="text" name="specialty" class="form-control" placeholder="مثال: العلوم الطبية والصحية / التجارب السريرية" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">إرسال الدعوة بالبريد</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    if (typeof initDedicatedDropdowns === 'function') {
        initDedicatedDropdowns();
    }

    function onJudgeInvited(res) {
        $('#inviteJudgeModal').modal('hide');
        $('.modal-backdrop').remove();
        showToast(res.message, res.success ? 'success' : 'error');
        loadPartial('/SuperAdmin/ManageJudgesPartial', '#main-content-container', 'judges');
    }

    function toggleJudgeStatus(id, isActive) {
        $.post('/SuperAdmin/ToggleJudgeStatus', { judgeId: id, isActive: isActive }, function (res) {
            showToast(res.message, res.success ? 'success' : 'error');
            if (res.success) {
                loadPartial('/SuperAdmin/ManageJudgesPartial', '#main-content-container', 'judges');
            }
        }).fail(function (xhr) {
            showToast(xhr.responseText || 'حدث خطأ أثناء تغيير الحالة.', 'error');
        });
    }

    function revokeInvitation(id) {
        if (!confirm('هل أنت متأكد من رغبتك في إلغاء هذه الدعوة؟')) return;
        $.post('/SuperAdmin/RevokeInvitation', { invitationId: id }, function (res) {
            showToast(res.message, res.success ? 'success' : 'error');
            if (res.success) {
                loadPartial('/SuperAdmin/ManageJudgesPartial', '#main-content-container', 'judges');
            }
        }).fail(function (xhr) {
            showToast(xhr.responseText || 'حدث خطأ أثناء إلغاء الدعوة.', 'error');
        });
    }
</script>
