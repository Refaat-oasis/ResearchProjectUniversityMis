@model List<researchProject.Models.Entities.Judge>
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "هيئة المحكمين المعتمدين والدعوات الأكاديمية";
    var invitations = ViewBag.Invitations as List<researchProject.Models.Entities.JudgeInvitation>;
}

<div class="page-header-card">
    <div>
        <h1 class="page-title"><i class="bi bi-mortarboard"></i> هيئة المحكمين المعتمدين والدعوات الأكاديمية</h1>
        <p>إدارة المحكمين وتفعيلهم أو تعطيلهم، ومتابعة روابط الدعوات المرسلة</p>
    </div>
    <button class="btn btn-brass btn-sm" data-bs-toggle="modal" data-bs-target="#inviteJudgeModal">
        <i class="bi bi-envelope-plus-fill me-1"></i> إرسال دعوة تحكيم جديدة
    </button>
</div>

<div class="card-custom archival-card mb-4">
    <!-- Nav Tabs for Active Judges and Invitations -->
    <ul class="nav nav-tabs mb-3" id="judgesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="active-judges-tab" data-bs-toggle="tab" data-bs-target="#active-judges" type="button" role="tab">
                المحكمون المسجلون (<span class="font-mono-tabular">@(Model?.Count ?? 0)</span>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="invitations-tab" data-bs-toggle="tab" data-bs-target="#invitations" type="button" role="tab">
                سجل الدعوات (<span class="font-mono-tabular">@(invitations?.Count ?? 0)</span>)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="judgesTabContent">
        <!-- Tab 1: Judges List -->
        <div class="tab-pane fade show active" id="active-judges" role="tabpanel">
            <div class="table-responsive">
                <table class="table ledger-table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>اسم المحكم</th>
                            <th>اللقب الأكاديمي</th>
                            <th>التخصص الدقيق</th>
                            <th>البريد الإلكتروني</th>
                            <th>التقييمات المفتوحة</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var j in Model)
                            {
                                int openEvals = j.Evaluations?.Count(e => e.Decision == EvaluationDecisionConstants.UnderEvaluation) ?? 0;
                                <tr>
                                    <td class="font-mono-tabular">@index</td>
                                    <td class="fw-bold" style="color: var(--ink-primary);">@j.User?.FullName</td>
                                    <td>@j.AcademicTitle</td>
                                    <td><span class="status-stamp">@j.Specialty</span></td>
                                    <td dir="ltr" class="text-end font-mono-tabular small">@j.User?.Email</td>
                                    <td>
                                        <span class="status-stamp @(openEvals > 0 ? "status-screening" : "status-approved") font-mono-tabular">
                                            @openEvals أبحاث
                                        </span>
                                    </td>
                                    <td>
                                        @if (j.IsActive)
                                        {
                                            <span class="status-stamp status-approved">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="status-stamp status-inactive">معطل</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="table-actions-inline">
                                            <button class="btn btn-sm @(j.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    onclick="toggleJudgeStatus(@j.Id, @(!j.IsActive ? "true" : "false"))">
                                                <i class="bi @(j.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                                @(j.IsActive ? "تعطيل" : "تفعيل")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5" style="color: var(--ink-muted);">لا يوجد محكمون مسجلون حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab 2: Invitations -->
        <div class="tab-pane fade" id="invitations" role="tabpanel">
            <div class="table-responsive">
                <table class="table ledger-table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>البريد الإلكتروني</th>
                            <th>التخصص المطلوب</th>
                            <th>تاريخ الدعوة</th>
                            <th>تاريخ الانتهاء</th>
                            <th>الحالة</th>
                            <th>إلغاء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (invitations != null && invitations.Any())
                        {
                            int idx = 1;
                            foreach (var inv in invitations)
                            {
                                bool isExpired = inv.ExpiresAt < DateTime.UtcNow;
                                <tr>
                                    <td class="font-mono-tabular">@idx</td>
                                    <td dir="ltr" class="text-end font-mono-tabular">@inv.Email</td>
                                    <td>@(inv.Specialty ?? "عام")</td>
                                    <td class="font-mono-tabular small" style="color: var(--ink-muted);">@inv.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="font-mono-tabular small" style="color: @(isExpired ? "#8C1D24" : "var(--ink-muted)");">@inv.ExpiresAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        @if (inv.Status == InvitationStatusConstants.Accepted)
                                        {
                                            <span class="status-stamp status-approved">مكتملة (تم التسجيل)</span>
                                        }
                                        else if (inv.Status == InvitationStatusConstants.Revoked)
                                        {
                                            <span class="status-stamp status-inactive">ملغاة</span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="status-stamp status-modifications">منتهية الصلاحية</span>
                                        }
                                        else
                                        {
                                            <span class="status-stamp status-screening">بانتظار قبول الدعوة</span>
                                        }
                                    </td>
                                    <td>
                                        @if (inv.Status == InvitationStatusConstants.Pending && !isExpired)
                                        {
                                            <div class="table-actions-inline">
                                                <button class="btn btn-sm btn-outline-danger" onclick="revokeInvitation(@inv.Id)">إلغاء الدعوة</button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5" style="color: var(--ink-muted);">لا توجد دعوات مسجلة.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Invite Judge -->
<div class="modal fade" id="inviteJudgeModal" tabindex="-1" aria-labelledby="inviteJudgeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="inviteJudgeModalLabel"><i class="bi bi-envelope-plus me-2"></i>إرسال دعوة محكم علمي</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="superAdminInviteForm" asp-action="InviteJudge" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <div class="dedicated-dropdown-wrapper">
                            <input type="email" name="email" id="superAdminJudgeEmailInput" class="form-control dedicated-dropdown-input font-mono-tabular" required placeholder="اكتب بريداً جديداً أو اختر من مستخدمي النظام..." dir="ltr" autocomplete="off" />
                            <div class="dedicated-dropdown-menu" id="superAdminSystemUsersMenu">
                                @if (ViewBag.SystemUsers != null)
                                {
                                    foreach (var u in ViewBag.SystemUsers)
                                    {
                                        <div class="dedicated-dropdown-item" data-value="@u.Email" data-label="@u.Email">
                                            <div class="fw-bold">@u.FullName</div>
                                            <small class="text-muted">@u.Email (@u.RoleName)</small>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="form-text small">يمكنك اختيار مستخدم مسجل بالنظام أو كتابة أي بريد جديد وسيتم إرسال رابط الدعوة الرسمية إليه مباشرة.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">التخصص الأكاديمي الدقيق المطلوب للتحكيم</label>
                        <input type="text" name="specialty" class="form-control" placeholder="مثال: علم الأدوية السريري / الأخلاقيات الحيوية" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">إرسال رابط الدعوة</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleJudgeStatus(judgeId, isActive) {
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/SuperAdmin/ToggleJudgeStatus',
                type: 'POST',
                data: { judgeId: judgeId, isActive: isActive },
                headers: { 'X-CSRF-TOKEN': token },
                success: function (res) {
                    if (res && res.success) {
                        showToast(res.message, 'success');
                    } else {
                        showToast(res.message || 'حدث خطأ.', 'error');
                    }
                    setTimeout(function () {
                        window.location.reload();
                    }, 1200);
                },
                error: function (xhr) {
                    showToast(xhr.responseText || 'حدث خطأ أثناء الاتصال بالخادم.', 'error');
                }
            });
        }

        function revokeInvitation(invitationId) {
            if (!confirm('هل أنت متأكد من إلغاء هذه الدعوة؟')) return;
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/SuperAdmin/RevokeInvitation',
                type: 'POST',
                data: { invitationId: invitationId },
                headers: { 'X-CSRF-TOKEN': token },
                success: function (res) {
                    if (res && res.success) {
                        showToast(res.message, 'success');
                    } else {
                        showToast(res.message || 'حدث خطأ.', 'error');
                    }
                    setTimeout(function () {
                        window.location.reload();
                    }, 1200);
                },
                error: function (xhr) {
                    showToast(xhr.responseText || 'حدث خطأ أثناء الاتصال بالخادم.', 'error');
                }
            });
        }

        $('#superAdminInviteForm').on('submit', function (e) {
            e.preventDefault();
            const form = this;
            const data = $(form).serialize();

            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: data,
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    if (res && res.success) {
                        showToast(res.message, 'success');
                        setTimeout(function () {
                            window.location.reload();
                        }, 1200);
                    } else {
                        showToast(res.message || 'حدث خطأ.', 'error');
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    showToast(xhr.responseText || 'حدث خطأ أثناء إرسال الدعوة.', 'error');
                }
            });
        });

        $(document).ready(function () {
            if (typeof initDedicatedDropdowns === 'function') {
                initDedicatedDropdowns();
            }
        });
    </script>
}
