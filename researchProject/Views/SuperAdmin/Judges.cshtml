@model List<researchProject.Models.Entities.Judge>
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "هيئة المحكمين المعتمدين والدعوات الأكاديمية";
    var invitations = ViewBag.Invitations as List<researchProject.Models.Entities.JudgeInvitation>;
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-mortarboard text-warning"></i> هيئة المحكمين المعتمدين والدعوات الأكاديمية</h2>
        <p>إدارة المحكمين وتفعيلهم أو تعطيلهم، ومتابعة روابط الدعوات المرسلة</p>
    </div>
    <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#inviteJudgeModal">
        <i class="bi bi-envelope-plus-fill me-1"></i> إرسال دعوة تحكيم جديدة
    </button>
</div>

<div class="liquid-glass-card mb-4">
    <!-- Nav Tabs for Active Judges and Invitations -->
    <ul class="nav nav-pills mb-3" id="judgesTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active btn-sm" id="active-judges-tab" data-bs-toggle="pill" data-bs-target="#active-judges" type="button" role="tab">
                المحكمون المسجلون (@(Model?.Count ?? 0))
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link btn-sm" id="invitations-tab" data-bs-toggle="pill" data-bs-target="#invitations" type="button" role="tab">
                سجل الدعوات (@(invitations?.Count ?? 0))
            </button>
        </li>
    </ul>

    <div class="tab-content" id="judgesTabContent">
        <!-- Tab 1: Judges List -->
        <div class="tab-pane fade show active" id="active-judges" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>اسم المحكم</th>
                            <th>اللقب الأكاديمي</th>
                            <th>التخصص الدقيق</th>
                            <th>البريد الإلكتروني</th>
                            <th>التقييمات المفتوحة</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var j in Model)
                            {
                                int openEvals = j.Evaluations?.Count(e => e.Decision == EvaluationDecisionConstants.UnderEvaluation) ?? 0;
                                <tr>
                                    <td>@index</td>
                                    <td class="fw-bold text-dark">@j.User?.FullName</td>
                                    <td>@j.AcademicTitle</td>
                                    <td><span class="badge bg-light text-primary border">@j.Specialty</span></td>
                                    <td dir="ltr" class="text-end font-monospace small">@j.User?.Email</td>
                                    <td>
                                        <span class="badge @(openEvals > 0 ? "bg-warning text-dark" : "bg-success")">
                                            @openEvals أبحاث
                                        </span>
                                    </td>
                                    <td>
                                        @if (j.IsActive)
                                        {
                                            <span class="badge bg-success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">معطل</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm @(j.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                onclick="toggleJudgeStatus(@j.Id, @(!j.IsActive ? "true" : "false"))">
                                            <i class="bi @(j.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                            @(j.IsActive ? "تعطيل" : "تفعيل")
                                        </button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">لا يوجد محكمون مسجلون حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab 2: Invitations -->
        <div class="tab-pane fade" id="invitations" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>البريد الإلكتروني</th>
                            <th>التخصص المطلوب</th>
                            <th>تاريخ الدعوة</th>
                            <th>تاريخ الانتهاء</th>
                            <th>الحالة</th>
                            <th>إلغاء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (invitations != null && invitations.Any())
                        {
                            int idx = 1;
                            foreach (var inv in invitations)
                            {
                                bool isExpired = inv.ExpiresAt < DateTime.UtcNow;
                                <tr>
                                    <td>@idx</td>
                                    <td dir="ltr" class="text-end font-monospace">@inv.Email</td>
                                    <td>@(inv.Specialty ?? "عام")</td>
                                    <td class="text-muted small">@inv.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="small @(isExpired ? "text-danger" : "text-muted")">@inv.ExpiresAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        @if (inv.Status == InvitationStatusConstants.Accepted)
                                        {
                                            <span class="badge bg-success">مكتملة (تم التسجيل)</span>
                                        }
                                        else if (inv.Status == InvitationStatusConstants.Revoked)
                                        {
                                            <span class="badge bg-secondary">ملغاة</span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="badge bg-danger">منتهية الصلاحية</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">بانتظار قبول الدعوة</span>
                                        }
                                    </td>
                                    <td>
                                        @if (inv.Status == InvitationStatusConstants.Pending && !isExpired)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" onclick="revokeInvitation(@inv.Id)">إلغاء الدعوة</button>
                                        }
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">لا توجد دعوات مسجلة.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Invite Judge -->
<div class="modal fade" id="inviteJudgeModal" tabindex="-1" aria-labelledby="inviteJudgeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="inviteJudgeModalLabel"><i class="bi bi-envelope-plus me-2 text-primary"></i>إرسال دعوة محكم علمي</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="superAdminInviteForm" asp-action="InviteJudge" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <input list="superAdminSystemUsersList" type="email" name="email" class="form-control" required placeholder="اكتب بريداً جديداً أو اختر من مستخدمي النظام..." dir="ltr" autocomplete="off" />
                        <datalist id="superAdminSystemUsersList">
                            @if (ViewBag.SystemUsers != null)
                            {
                                foreach (var u in ViewBag.SystemUsers)
                                {
                                    <option value="@u.Email">@u.FullName (@u.RoleName)</option>
                                }
                            }
                        </datalist>
                        <div class="form-text small">يمكنك اختيار مستخدم مسجل بالنظام أو كتابة أي بريد جديد وسيتم إرسال رابط الدعوة الرسمية إليه مباشرة.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">التخصص الأكاديمي الدقيق المطلوب للتحكيم</label>
                        <input type="text" name="specialty" class="form-control" placeholder="مثال: علم الأدوية السريري / الأخلاقيات الحيوية" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">إرسال رابط الدعوة</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleJudgeStatus(judgeId, isActive) {
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/SuperAdmin/ToggleJudgeStatus',
                type: 'POST',
                data: { judgeId: judgeId, isActive: isActive },
                headers: { 'X-CSRF-TOKEN': token },
                success: function (res) {
                    alert(res.message);
                    window.location.reload();
                }
            });
        }

        function revokeInvitation(invitationId) {
            if (!confirm('هل أنت متأكد من إلغاء هذه الدعوة؟')) return;
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                url: '/SuperAdmin/RevokeInvitation',
                type: 'POST',
                data: { invitationId: invitationId },
                headers: { 'X-CSRF-TOKEN': token },
                success: function (res) {
                    alert(res.message);
                    window.location.reload();
                }
            });
        }

        $('#superAdminInviteForm').on('submit', function (e) {
            e.preventDefault();
            const form = this;
            const data = $(form).serialize();

            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: data,
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    alert(res.message);
                    if (res.success) {
                        window.location.reload();
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    alert(xhr.responseText || 'حدث خطأ.');
                }
            });
        });
    </script>
}
