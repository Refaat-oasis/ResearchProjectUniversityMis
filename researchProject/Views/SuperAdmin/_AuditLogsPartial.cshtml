@model researchProject.Models.ViewModels.AuditLogListViewModel

<div class="table-responsive">
    <table class="table table-hover align-middle custom-table mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 70px;">#</th>
                <th style="width: 170px;">التاريخ والوقت</th>
                <th>المستخدم والدور</th>
                <th>العملية والمسار</th>
                <th style="width: 120px;">طريقة الطلب</th>
                <th style="width: 110px;">الحالة</th>
                <th style="width: 100px;">الاستجابة</th>
                <th style="width: 80px;">المدة</th>
                <th style="width: 80px;">التفاصيل</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Logs == null || !Model.Logs.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                        لا توجد سجلات تدقيق أو عمليات مطابقة للبحث حالياً.
                    </td>
                </tr>
            }
            else
            {
                foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="text-muted small">@log.Id</td>
                        <td>
                            <div class="fw-bold small text-dark">@log.Timestamp.ToLocalTime().ToString("yyyy/MM/dd")</div>
                            <div class="text-muted small">@log.Timestamp.ToLocalTime().ToString("hh:mm:ss tt")</div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(log.UserEmail))
                            {
                                <div class="fw-semibold text-primary small">@log.UserEmail</div>
                                <div class="text-muted small">
                                    <span class="badge bg-light text-dark border">@(log.UserRole ?? "مستخدم مسجل")</span>
                                    @if (!string.IsNullOrEmpty(log.IpAddress))
                                    {
                                        <span class="ms-1 font-monospace" style="font-size: 11px;">(@log.IpAddress)</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">زائر غير مسجل</span>
                                @if (!string.IsNullOrEmpty(log.IpAddress))
                                {
                                    <div class="text-muted font-monospace" style="font-size: 11px;">@log.IpAddress</div>
                                }
                            }
                        </td>
                        <td>
                            <div class="fw-bold small text-dark">@(log.Description ?? $"{log.ControllerName}/{log.ActionName}")</div>
                            <div class="text-muted small font-monospace text-truncate" style="max-width: 250px;" title="@log.Path">@log.Path</div>
                        </td>
                        <td>
                            <span class="badge @(log.HttpMethod == "POST" ? "bg-warning text-dark" : log.HttpMethod == "BACKGROUND" ? "bg-info text-dark" : "bg-light text-secondary border")">
                                @log.HttpMethod
                            </span>
                        </td>
                        <td>
                            @if (log.IsSuccess)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-check-circle"></i> نجاح
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-exclamation-triangle"></i> تعذر / خطأ
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge @(log.StatusCode >= 200 && log.StatusCode < 300 ? "bg-success" : log.StatusCode == 404 ? "bg-warning text-dark" : "bg-danger")">
                                @log.StatusCode
                            </span>
                        </td>
                        <td class="small text-muted font-monospace">
                            @(log.ExecutionDurationMs)ms
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-info rounded-circle" 
                                    style="width: 32px; height: 32px; padding: 0;"
                                    data-bs-toggle="modal" data-bs-target="#auditModal_@log.Id" title="عرض التفاصيل">
                                <i class="bi bi-eye"></i>
                            </button>

                            <!-- Modal -->
                            <div class="modal fade" id="auditModal_@log.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <div class="modal-header bg-light">
                                            <h5 class="modal-title fs-6 fw-bold">
                                                <i class="bi bi-journal-text text-primary me-1"></i>
                                                تفاصيل سجل الرقابة رقم #@log.Id
                                            </h5>
                                            <button type="button" class="btn-close ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body text-start" dir="ltr" style="font-family: Consolas, monospace; font-size: 13px;">
                                            <div class="mb-2"><strong>Timestamp:</strong> @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff UTC")</div>
                                            <div class="mb-2"><strong>User:</strong> @(log.UserEmail ?? "Anonymous") (ID: @(log.UserId ?? "None"))</div>
                                            <div class="mb-2"><strong>Role:</strong> @(log.UserRole ?? "None")</div>
                                            <div class="mb-2"><strong>Method & Path:</strong> @log.HttpMethod @log.Path</div>
                                            <div class="mb-2"><strong>Controller / Action:</strong> @log.ControllerName / @log.ActionName</div>
                                            <div class="mb-2"><strong>IP Address:</strong> @(log.IpAddress ?? "N/A")</div>
                                            <div class="mb-2"><strong>Status Code:</strong> @log.StatusCode (@(log.IsSuccess ? "Success" : "Failed"))</div>
                                            <div class="mb-2"><strong>Duration:</strong> @log.ExecutionDurationMs ms</div>
                                            <div class="mb-2" dir="rtl" style="font-family: system-ui;"><strong>الوصف:</strong> @log.Description</div>
                                            @if (!string.IsNullOrEmpty(log.ExceptionDetails))
                                            {
                                                <div class="mt-3">
                                                    <strong class="text-danger">Exception Stack Trace:</strong>
                                                    <pre class="bg-dark text-danger p-3 rounded-3 mt-1 overflow-auto" style="max-height: 250px; font-size: 11px;">@log.ExceptionDetails</pre>
                                                </div>
                                            }
                                        </div>
                                        <div class="modal-footer bg-light py-2">
                                            <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">إغلاق</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="p-3 border-top d-flex justify-content-between align-items-center">
        <span class="text-muted small">
            إجمالي السجلات: <strong>@Model.TotalCount</strong> • صفحة <strong>@Model.CurrentPage</strong> من <strong>@Model.TotalPages</strong>
        </span>
        <ul class="pagination pagination-sm mb-0">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="javascript:loadAuditLogsPage(@(Model.CurrentPage - 1))">السابق</a>
                </li>
            }
            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="javascript:loadAuditLogsPage(@p)">@p</a>
                </li>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="javascript:loadAuditLogsPage(@(Model.CurrentPage + 1))">التالي</a>
                </li>
            }
        </ul>
    </nav>
}

