@model List<researchProject.Models.Entities.Research>
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "كافة المقترحات البحثية في الجامعة";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-journal-text text-warning"></i> كافة المقترحات البحثية في الجامعة</h2>
        <p>متابعة مسار جميع الأبحاث المقدمة في مختلف الكليات وحالات سير العمل</p>
    </div>
    <span class="badge bg-light text-dark fs-6 p-2 border">
        إجمالي المقترحات: <strong>@(Model?.Count ?? 0)</strong>
    </span>
</div>

<div class="liquid-glass-card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>الكلية</th>
                    <th>التصنيف والتخصص</th>
                    <th>الباحث الرئيسي</th>
                    <th>تاريخ التقديم</th>
                    <th>حالة سير العمل</th>
                    <th>التفاصيل</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var mainAuthor = r.ResearcherResearchesBridges?.FirstOrDefault(b => b.IsMainAuthor)?.Researcher?.User?.FullName 
                            ?? r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";

                        string badgeClass = r.WorkflowStatus switch
                        {
                            ResearchStatusConstants.UnderFormalScreening => "status-screening",
                            ResearchStatusConstants.AssignedToJudges => "status-assigned",
                            ResearchStatusConstants.ModificationsRequired => "status-modifications",
                            ResearchStatusConstants.Approved => "status-approved",
                            ResearchStatusConstants.CertificateIssued => "status-issued",
                            _ => "bg-secondary text-white"
                        };

                        <tr>
                            <td>@index</td>
                            <td class="fw-bold text-dark" style="max-width: 280px;">@r.Title</td>
                            <td><span class="badge bg-light text-dark border">@r.College?.Name</span></td>
                            <td>
                                <div>@r.Category?.Name</div>
                                <div class="text-muted small">@r.AcademicSpecialty</div>
                            </td>
                            <td><i class="bi bi-person me-1"></i>@mainAuthor</td>
                            <td class="text-muted small">@r.SubmittedAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                <span class="badge-status @badgeClass">@r.WorkflowStatus</span>
                            </td>
                            <td>
                                <a asp-action="ResearchDetails" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> عرض التفاصيل
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">لا توجد مقترحات بحثية مسجلة بالنظام حتى الآن.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

