@model List<researchProject.Models.Entities.College>

<div class="card card-custom archival-card">
    <div class="card-header-custom">
        <h4 class="card-title-custom">
            <i class="bi bi-buildings"></i> إدارة كليات الجامعة ولجانها الفرعية والأقسام الأكاديمية
        </h4>
        <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#addCollegeModal">
            <i class="bi bi-plus-lg me-1"></i> إضافة كلية جديدة
        </button>
    </div>

    <div class="table-responsive">
        <table class="table ledger-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>اسم الكلية</th>
                    <th>رمز الكلية</th>
                    <th>مدير اللجنة الفرعية</th>
                    <th>الأقسام الأكاديمية</th>
                    <th>عدد التصنيفات</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var c in Model)
                    {
                        var coAdmin = c.CollegeCoAdmins?.FirstOrDefault()?.User?.FullName ?? "لم يُعين بعد";
                        var deptsCount = c.Departments?.Count ?? 0;
                        <tr>
                            <td class="font-mono-tabular">@index</td>
                            <td class="fw-bold" style="color: var(--ink-primary);">@c.Name</td>
                            <td><span class="status-stamp font-mono-tabular" dir="ltr">@c.Code</span></td>
                            <td>
                                @if (c.CollegeCoAdmins != null && c.CollegeCoAdmins.Any())
                                {
                                    <span style="color: var(--brand-sovereign);"><i class="bi bi-person-badge me-1"></i>@coAdmin</span>
                                }
                                else
                                {
                                    <span class="small" style="color: #8C1D24;"><i class="bi bi-exclamation-circle me-1"></i>لا يوجد مدير لجنة</span>
                                }
                            </td>
                            <td>
                                <span class="status-stamp status-assigned"><span class="font-mono-tabular">@deptsCount</span> قسم</span>
                            </td>
                            <td><span class="font-mono-tabular">@(c.ResearchCategories?.Count ?? 0)</span> تصنيف</td>
                            <td>
                                <div class="table-actions-inline">
                                    <button class="btn btn-sm btn-outline-primary" onclick="manageDepartments(@c.Id, '@c.Name')" title="إدارة الأقسام">
                                        <i class="bi bi-diagram-3"></i> الأقسام (<span class="font-mono-tabular">@deptsCount</span>)
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="editCollege(@c.Id, '@c.Name', '@c.Code')" title="تعديل بيانات الكلية">
                                        <i class="bi bi-pencil"></i> تعديل
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4" style="color: var(--ink-muted);">لا توجد كليات مسجلة حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Add College -->
<div class="modal fade" id="addCollegeModal" tabindex="-1" aria-labelledby="addCollegeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addCollegeModalLabel"><i class="bi bi-building-add me-2"></i>إضافة كلية جديدة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCollegeForm" action="/SuperAdmin/CreateCollege" method="post" onsubmit="return handleAjaxFormSubmit(this, onCollegeSaved);">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اسم الكلية <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" required placeholder="مثال: كلية الطب البشري" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">رمز الكلية (Code) <span class="text-danger">*</span></label>
                        <input type="text" name="Code" class="form-control font-mono-tabular" required placeholder="مثال: MED" dir="ltr" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">حفظ الكلية</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Manage Departments (Requirement 3) -->
<div class="modal fade" id="departmentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-diagram-3-fill me-2"></i>
                    إدارة الأقسام الأكاديمية - <span id="deptCollegeName" style="color: var(--brand-sovereign);"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Add Department Form -->
                <form id="addDeptForm" class="dossier-panel mb-4">
                    <input type="hidden" id="deptTargetCollegeId" name="collegeId" />
                    <input type="hidden" id="deptEditingId" name="id" />
                    <label class="form-label fw-bold mb-1" id="deptFormLabel">إضافة قسم أكاديمي جديد للكلية:</label>
                    <div class="input-group">
                        <input type="text" id="deptNameInput" name="name" class="form-control" placeholder="اكتب اسم القسم الأكاديمي..." required />
                        <button type="submit" class="btn btn-primary-custom px-4" id="deptSaveBtn">
                            <i class="bi bi-plus-lg me-1"></i> حفظ القسم
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="deptCancelEditBtn" style="display:none;" onclick="cancelEditDept()">
                            إلغاء التعديل
                        </button>
                    </div>
                </form>

                <!-- Departments List -->
                <h6 class="fw-bold mb-2" style="color: var(--ink-primary);"><i class="bi bi-list-check me-1"></i> الأقسام الأكاديمية المسجلة بالكلية:</h6>
                <div class="table-responsive">
                    <table class="table ledger-table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>اسم القسم الأكاديمي</th>
                                <th style="width: 160px;">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="departmentsTableBody">
                            <tr>
                                <td colspan="3" class="text-center py-3" style="color: var(--ink-muted);">جاري تحميل الأقسام...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<script>
    var currentCollegeId = 0;

    function onCollegeSaved(res) {
        $('#addCollegeModal').modal('hide');
        $('.modal-backdrop').remove();
        loadPartial('/SuperAdmin/ManageCollegesPartial', '#main-content-container', 'colleges');
    }

    function editCollege(id, name, code) {
        var newName = prompt('تعديل اسم الكلية:', name);
        if (newName === null) return;
        var newCode = prompt('تعديل رمز الكلية:', code);
        if (newCode === null) return;

        $.post('/SuperAdmin/UpdateCollege', { Id: id, Name: newName, Code: newCode }, function (res) {
            alert(res.message);
            if (res.success) {
                loadPartial('/SuperAdmin/ManageCollegesPartial', '#main-content-container', 'colleges');
            }
        });
    }

    function manageDepartments(collegeId, collegeName) {
        currentCollegeId = collegeId;
        $('#deptTargetCollegeId').val(collegeId);
        $('#deptCollegeName').text(collegeName);
        cancelEditDept();
        loadDepartmentsList(collegeId);
        new bootstrap.Modal(document.getElementById('departmentsModal')).show();
    }

    function loadDepartmentsList(collegeId) {
        $('#departmentsTableBody').html('<tr><td colspan="3" class="text-center py-3 text-muted">جاري التحميل...</td></tr>');
        $.get('/SuperAdmin/GetDepartments?collegeId=' + collegeId, function (data) {
            var tbody = $('#departmentsTableBody');
            tbody.empty();
            if (!data || data.length === 0) {
                tbody.append('<tr><td colspan="3" class="text-center py-3 text-muted">لا توجد أقسام مسجلة لهذه الكلية بعد. يمكنك إضافة قسم جديد أعلاه.</td></tr>');
                return;
            }
            $.each(data, function (i, item) {
                var tr = $('<tr>');
                tr.append($('<td class="font-mono-tabular">').text(i + 1));
                tr.append($('<td class="fw-bold">').text(item.name));
                var actionsTd = $('<td>');
                var actionsWrap = $('<div class="table-actions-inline">');
                actionsWrap.append('<button class="btn btn-outline-primary btn-sm" onclick="startEditDept(' + item.id + ', \'' + item.name.replace(/'/g, "\\'") + '\')"><i class="bi bi-pencil"></i> تعديل</button>');
                actionsWrap.append('<button class="btn btn-outline-danger btn-sm" onclick="deleteDept(' + item.id + ')"><i class="bi bi-trash"></i> حذف</button>');
                actionsTd.append(actionsWrap);
                tr.append(actionsTd);
                tbody.append(tr);
            });
        });
    }

    function startEditDept(id, name) {
        $('#deptEditingId').val(id);
        $('#deptNameInput').val(name).focus();
        $('#deptFormLabel').text('تعديل اسم القسم الأكاديمي:');
        $('#deptSaveBtn').html('<i class="bi bi-check-lg me-1"></i> حفظ التعديل');
        $('#deptCancelEditBtn').show();
    }

    function cancelEditDept() {
        $('#deptEditingId').val('');
        $('#deptNameInput').val('');
        $('#deptFormLabel').text('إضافة قسم أكاديمي جديد للكلية:');
        $('#deptSaveBtn').html('<i class="bi bi-plus-lg me-1"></i> حفظ القسم');
        $('#deptCancelEditBtn').hide();
    }

    $('#addDeptForm').off('submit').on('submit', function (e) {
        e.preventDefault();
        var id = $('#deptEditingId').val();
        var name = $('#deptNameInput').val();
        var collegeId = $('#deptTargetCollegeId').val();

        $.ajax({
            url: '/SuperAdmin/SaveDepartment',
            type: 'POST',
            data: {
                id: id ? parseInt(id) : null,
                name: name,
                collegeId: parseInt(collegeId)
            },
            success: function (res) {
                alert(res.message);
                if (res.success) {
                    cancelEditDept();
                    loadDepartmentsList(collegeId);
                }
            },
            error: function (xhr) {
                alert(xhr.responseText || 'حدث خطأ.');
            }
        });
    });

    function deleteDept(id) {
        if (!confirm('هل أنت متأكد من رغبتك في حذف هذا القسم الأكاديمي؟')) return;
        $.ajax({
            url: '/SuperAdmin/DeleteDepartment',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                alert(res.message);
                if (res.success) {
                    loadDepartmentsList(currentCollegeId);
                }
            },
            error: function (xhr) {
                alert(xhr.responseText || 'حدث خطأ.');
            }
        });
    }
</script>
