@model researchProject.Models.Entities.Research
@using System.Text.Json
@using researchProject.Models.Constants
@{
    ViewData["Title"] = $"تفاصيل المقترح البحثي: {Model.Title}";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-file-earmark-text text-warning"></i> تفاصيل المقترح البحثي: « @Model.Title »</h2>
        <p>@Model.College?.Name - @Model.Category?.Name (التخصص: @Model.AcademicSpecialty)</p>
    </div>
    <a asp-action="Researches" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
    </a>
</div>

<div class="liquid-glass-card mb-4">
    <!-- Overview Metadata -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="p-3 bg-light rounded border">
                <div class="text-muted small">حالة سير العمل:</div>
                <div class="fw-bold mt-1">
                    <span class="badge-status status-assigned">@Model.WorkflowStatus</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-light rounded border">
                <div class="text-muted small">تاريخ التقديم:</div>
                <div class="fw-bold mt-1">@Model.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-light rounded border">
                <div class="text-muted small">الباحثون المشاركون:</div>
                <div class="mt-1">
                    @if (Model.ResearcherResearchesBridges != null)
                    {
                        foreach (var b in Model.ResearcherResearchesBridges)
                        {
                            <span class="badge bg-secondary-subtle text-secondary me-1">
                                @b.Researcher?.User?.FullName @(b.IsMainAuthor ? "(رئيسي)" : "")
                            </span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Dynamic Category Answers -->
    @if (!string.IsNullOrWhiteSpace(Model.DynamicFieldsJson))
    {
        <div class="card bg-light border p-3 mb-4 rounded-3">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-ui-checks me-2 text-primary"></i>إجابات الحقول الإضافية للتصنيف</h6>
            <div class="row g-2">
                @{
                    try
                    {
                        var answers = JsonSerializer.Deserialize<Dictionary<string, string>>(Model.DynamicFieldsJson);
                        if (answers != null && answers.Any())
                        {
                            foreach (var item in answers)
                            {
                                <div class="col-md-4">
                                    <div class="bg-white p-2 border rounded small">
                                        <div class="text-muted">@item.Key:</div>
                                        <div class="fw-bold text-dark">@item.Value</div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    catch { }
                }
            </div>
        </div>
    }

    <!-- Attachments Table -->
    <h5 class="fw-bold text-dark mb-2"><i class="bi bi-paperclip me-2 text-primary"></i>وثائق ومرفقات المقترح</h5>
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>نوع المستند</th>
                    <th>النسخة</th>
                    <th>اسم الملف الأصلي</th>
                    <th>تاريخ الرفع</th>
                    <th class="text-center">تحميل / معاينة</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ResearchAttachments != null && Model.ResearchAttachments.Any())
                {
                    foreach (var att in Model.ResearchAttachments.OrderByDescending(a => a.Version))
                    {
                        <tr>
                            <td class="fw-bold text-primary">@att.AttachmentType</td>
                            <td><span class="badge bg-secondary">V @att.Version</span></td>
                            <td>@att.OriginalFileName</td>
                            <td class="text-muted small">@att.UploadedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-center">
                                <a href="/Attachment/Download/@att.Id" class="btn btn-sm btn-outline-primary" target="_blank" title="تحميل الملف">
                                    <i class="bi bi-download me-1"></i> تحميل
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-3 text-muted">لا توجد مرفقات.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Evaluations History (Rounds) -->
    <h5 class="fw-bold text-dark mb-2"><i class="bi bi-clipboard2-check me-2 text-primary"></i>تقييمات المحكمين وجولات التحكيم</h5>
    <div class="table-responsive mb-4">
        <table class="table table-bordered table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>الجولة</th>
                    <th>المحكم</th>
                    <th>الخصوصية</th>
                    <th>المخاطر</th>
                    <th>الموافقة المستنيرة</th>
                    <th>القرار</th>
                    <th>التوقيع الرقمي</th>
                    <th>التاريخ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Evaluations != null && Model.Evaluations.Any())
                {
                    foreach (var ev in Model.Evaluations.OrderByDescending(e => e.RoundNumber))
                    {
                        <tr>
                            <td class="fw-bold">الجولة @ev.RoundNumber</td>
                            <td>@ev.Judge?.User?.FullName</td>
                            <td>@(ev.PrivacyProtectionRating ?? "-")</td>
                            <td>@(ev.RiskLevel ?? "-")</td>
                            <td>@(ev.InformedConsentRating ?? "-")</td>
                            <td>
                                @if (ev.Decision == EvaluationDecisionConstants.Approved)
                                {
                                    <span class="badge bg-success">@ev.Decision</span>
                                }
                                else if (ev.Decision == EvaluationDecisionConstants.ModificationsRequired)
                                {
                                    <span class="badge bg-danger">@ev.Decision</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@ev.Decision</span>
                                }
                            </td>
                            <td>
                                @if (ev.IsDigitallySigned)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-check-circle me-1"></i>موقع إلكترونياً</span>
                                }
                                else
                                {
                                    <span class="text-muted small">غير موقع</span>
                                }
                            </td>
                            <td class="text-muted small">@(ev.SubmittedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center py-3 text-muted">لم يتم إسناد محكمين بعد.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Audit Log: ResearchStatusHistories -->
    <h5 class="fw-bold text-dark mb-2"><i class="bi bi-clock-history me-2 text-primary"></i>سجل التدقيق وتاريخ حالات سير العمل</h5>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead class="table-light">
                <tr>
                    <th>التاريخ والوقت</th>
                    <th>المسؤول</th>
                    <th>الحالة السابقة</th>
                    <th>الحالة الجديدة</th>
                    <th>السبب / البيان</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ResearchStatusHistories != null && Model.ResearchStatusHistories.Any())
                {
                    foreach (var h in Model.ResearchStatusHistories.OrderByDescending(h => h.ChangedAt))
                    {
                        <tr>
                            <td class="text-muted small">@h.ChangedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="fw-bold">@(h.ChangedByUser?.FullName ?? "النظام")</td>
                            <td>@(h.OldStatus ?? "طلب جديد")</td>
                            <td class="text-primary fw-bold">@h.NewStatus</td>
                            <td class="small">@h.Reason</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
