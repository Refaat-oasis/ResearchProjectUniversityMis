@model researchProject.Models.Entities.Research
@using System.Text.Json
@using researchProject.Models.Constants
@{
    ViewData["Title"] = $"تفاصيل المقترح البحثي: {Model.Title}";
    string statusBadgeClass = Model.WorkflowStatus switch
    {
        ResearchStatusConstants.UnderFormalScreening => "status-screening",
        ResearchStatusConstants.AssignedToJudges => "status-assigned",
        ResearchStatusConstants.ModificationsRequired => "status-modifications",
        ResearchStatusConstants.Approved => "status-approved",
        ResearchStatusConstants.CertificateIssued => "status-issued",
        _ => "status-assigned"
    };
}

<div class="page-header-card">
    <div>
        <h1 class="page-title"><i class="bi bi-file-earmark-text"></i> تفاصيل المقترح البحثي: « @Model.Title »</h1>
        <p>@Model.College?.Name - @Model.Category?.Name (التخصص: @Model.AcademicSpecialty)</p>
    </div>
    <a asp-action="Researches" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-right me-1"></i> العودة للقائمة
    </a>
</div>

<div class="card-custom archival-card mb-4">
    <!-- Overview Metadata -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">حالة سير العمل:</div>
                <div class="fw-bold mt-2">
                    <span class="status-stamp @statusBadgeClass">@Model.WorkflowStatus</span>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">تاريخ التقديم:</div>
                <div class="fw-bold mt-2 font-mono-tabular" style="color: var(--ink-primary);">@Model.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">الباحثون المشاركون:</div>
                <div class="mt-2 d-flex flex-wrap gap-1">
                    @if (Model.ResearcherResearchesBridges != null)
                    {
                        foreach (var b in Model.ResearcherResearchesBridges)
                        {
                            <span class="status-stamp">
                                @b.Researcher?.User?.FullName @(b.IsMainAuthor ? "(رئيسي)" : "")
                            </span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Dynamic Category Answers -->
    @if (!string.IsNullOrWhiteSpace(Model.DynamicFieldsJson))
    {
        <div class="dossier-panel-subtle mb-4">
            <h6 class="fw-bold mb-3" style="color: var(--ink-primary);"><i class="bi bi-ui-checks me-2"></i>إجابات الحقول الإضافية للتصنيف</h6>
            <div class="row g-2">
                @{
                    try
                    {
                        var answers = JsonSerializer.Deserialize<Dictionary<string, string>>(Model.DynamicFieldsJson);
                        if (answers != null && answers.Any())
                        {
                            foreach (var item in answers)
                            {
                                <div class="col-12 col-md-4">
                                    <div class="bg-white p-2 border small" style="border-color: var(--border-hairline) !important;">
                                        <div style="color: var(--ink-muted);">@item.Key:</div>
                                        <div class="fw-bold" style="color: var(--ink-primary);">@item.Value</div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    catch { }
                }
            </div>
        </div>
    }

    <!-- Attachments Table -->
    <h5 class="card-title-custom fs-6 mb-2"><i class="bi bi-paperclip"></i> وثائق ومرفقات المقترح</h5>
    <div class="table-responsive mb-4">
        <table class="table ledger-table table-sm align-middle">
            <thead>
                <tr>
                    <th>نوع المستند</th>
                    <th>النسخة</th>
                    <th>اسم الملف الأصلي</th>
                    <th>تاريخ الرفع</th>
                    <th class="text-center">تحميل / معاينة</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ResearchAttachments != null && Model.ResearchAttachments.Any())
                {
                    foreach (var att in Model.ResearchAttachments.OrderByDescending(a => a.Version))
                    {
                        <tr>
                            <td class="fw-bold" style="color: var(--brand-sovereign);">@att.AttachmentType</td>
                            <td><span class="status-stamp font-mono-tabular">V @att.Version</span></td>
                            <td>@att.OriginalFileName</td>
                            <td class="font-mono-tabular small" style="color: var(--ink-muted);">@att.UploadedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-center">
                                <div class="table-actions-inline">
                                    <a href="/Attachment/Download/@att.Id" class="btn btn-sm btn-outline-primary" target="_blank" title="تحميل الملف">
                                        <i class="bi bi-download"></i> تحميل
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-3" style="color: var(--ink-muted);">لا توجد مرفقات.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Evaluations History (Rounds) -->
    <h5 class="card-title-custom fs-6 mb-2"><i class="bi bi-clipboard2-check"></i> تقييمات المحكمين وجولات التحكيم</h5>
    <div class="table-responsive mb-4">
        <table class="table ledger-table table-sm align-middle">
            <thead>
                <tr>
                    <th>الجولة</th>
                    <th>المحكم</th>
                    <th>الخصوصية</th>
                    <th>المخاطر</th>
                    <th>الموافقة المستنيرة</th>
                    <th>القرار</th>
                    <th>التوقيع الرقمي</th>
                    <th>التاريخ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Evaluations != null && Model.Evaluations.Any())
                {
                    foreach (var ev in Model.Evaluations.OrderByDescending(e => e.RoundNumber))
                    {
                        <tr>
                            <td class="fw-bold">الجولة <span class="font-mono-tabular">@ev.RoundNumber</span></td>
                            <td>@ev.Judge?.User?.FullName</td>
                            <td>@(ev.PrivacyProtectionRating ?? "-")</td>
                            <td>@(ev.RiskLevel ?? "-")</td>
                            <td>@(ev.InformedConsentRating ?? "-")</td>
                            <td>
                                @if (ev.Decision == EvaluationDecisionConstants.Approved)
                                {
                                    <span class="status-stamp status-approved">@ev.Decision</span>
                                }
                                else if (ev.Decision == EvaluationDecisionConstants.ModificationsRequired)
                                {
                                    <span class="status-stamp status-modifications">@ev.Decision</span>
                                }
                                else
                                {
                                    <span class="status-stamp status-screening">@ev.Decision</span>
                                }
                            </td>
                            <td>
                                @if (ev.IsDigitallySigned)
                                {
                                    <span class="status-stamp status-issued">موقع إلكترونياً</span>
                                }
                                else
                                {
                                    <span class="small" style="color: var(--ink-muted);">غير موقع</span>
                                }
                            </td>
                            <td class="font-mono-tabular small" style="color: var(--ink-muted);">@(ev.SubmittedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center py-3" style="color: var(--ink-muted);">لم يتم إسناد محكمين بعد.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Audit Log: ResearchStatusHistories -->
    <h5 class="card-title-custom fs-6 mb-2"><i class="bi bi-clock-history"></i> سجل التدقيق وتاريخ حالات سير العمل</h5>
    <div class="table-responsive">
        <table class="table ledger-table table-sm align-middle">
            <thead>
                <tr>
                    <th>التاريخ والوقت</th>
                    <th>المسؤول</th>
                    <th>الحالة السابقة</th>
                    <th>الحالة الجديدة</th>
                    <th>السبب / البيان</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ResearchStatusHistories != null && Model.ResearchStatusHistories.Any())
                {
                    foreach (var h in Model.ResearchStatusHistories.OrderByDescending(h => h.ChangedAt))
                    {
                        <tr>
                            <td class="font-mono-tabular small" style="color: var(--ink-muted);">@h.ChangedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="fw-bold">@(h.ChangedByUser?.FullName ?? "النظام")</td>
                            <td>@(h.OldStatus ?? "طلب جديد")</td>
                            <td class="fw-bold" style="color: var(--brand-sovereign);">@h.NewStatus</td>
                            <td class="small">@h.Reason</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
