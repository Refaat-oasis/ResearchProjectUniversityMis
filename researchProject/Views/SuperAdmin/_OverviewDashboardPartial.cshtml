@model researchProject.Models.ViewModels.SystemStatisticsViewModel
@using researchProject.Models.Constants

<div class="card card-custom archival-card">
    <div class="card-header-custom flex-wrap gap-2">
        <div>
            <h3 class="card-title-custom mb-1">لوحة المؤشرات المركزية للجامعة</h3>
            <p class="small mb-0 text-muted">نظرة شاملة ومحدثة على حركة وأداء لجان أخلاقيات البحث العلمي بكافة الكليات</p>
        </div>
        <span class="role-stamp">
            <span>تاريخ التحديث:</span>
            <span class="font-mono-tabular" dir="ltr">@DateTime.UtcNow.ToString("yyyy/MM/dd HH:mm") UTC</span>
        </span>
    </div>

    <!-- Stat Cards Grid -->
    <div class="kpi-ledger-grid mb-4">
        <div class="kpi-ledger-cell">
            <div class="stat-label">إجمالي المقترحات البحثية</div>
            <div class="stat-number font-mono-tabular" data-counter data-target="@Model.TotalResearches">@Model.TotalResearches</div>
        </div>

        <div class="kpi-ledger-cell">
            <div class="stat-label">قيد المراجعة الشكلية</div>
            <div class="stat-number font-mono-tabular" data-counter data-target="@Model.UnderScreeningCount">@Model.UnderScreeningCount</div>
        </div>

        <div class="kpi-ledger-cell">
            <div class="stat-label">مسندة للمحكمين</div>
            <div class="stat-number font-mono-tabular" data-counter data-target="@Model.AssignedToJudgesCount">@Model.AssignedToJudgesCount</div>
        </div>

        <div class="kpi-ledger-cell">
            <div class="stat-label">شهادات صادرة رسمياً</div>
            <div class="stat-number font-mono-tabular" data-counter data-target="@Model.CertificatesIssuedCount">@Model.CertificatesIssuedCount</div>
        </div>
    </div>

    <!-- SLA Performance & Quick Indicators -->
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="h-100">
                <h6 class="fw-semibold mb-3 pb-2 border-bottom">مؤشر الالتزام بمهلة الفحص (48h)</h6>
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    <span class="fs-2 fw-semibold font-mono-tabular" data-counter data-target="@Model.SlaCompliancePercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix="%">@Model.SlaCompliancePercentage%</span>
                    <span class="small text-muted">نسبة الالتزام بالـ SLA</span>
                </div>
                <div class="progress" style="height: 5px;">
                    <div class="progress-bar animated-progress-bar" role="progressbar" style="width: 0%;" data-target-width="@Model.SlaCompliancePercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                </div>
                <div class="small mt-2 text-secondary">متوسط زمن الفحص الشكلي: <strong><span class="font-mono-tabular" data-counter data-target="@Model.AverageScreeningHours.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1">@Model.AverageScreeningHours</span> ساعة</strong></div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="h-100">
                <h6 class="fw-semibold mb-3 pb-2 border-bottom">هيئة المحكمين والباحثين</h6>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom small">
                    <span class="text-secondary">المحكمون النشطون:</span>
                    <strong><span class="font-mono-tabular" data-counter data-target="@Model.TotalJudges">@Model.TotalJudges</span> محكم معتمد</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom small">
                    <span class="text-secondary">الباحثون المسجلون:</span>
                    <strong><span class="font-mono-tabular" data-counter data-target="@Model.TotalResearchers">@Model.TotalResearchers</span> باحث</strong>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 small">
                    <span class="text-secondary">عدد الكليات المشاركة:</span>
                    <strong><span class="font-mono-tabular" data-counter data-target="@Model.TotalColleges">@Model.TotalColleges</span> كلية</strong>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="h-100">
                <h6 class="fw-semibold mb-3 pb-2 border-bottom">توزيع الحالات</h6>
                <div class="d-flex justify-content-between align-items-center py-2 small border-bottom">
                    <span>تعديلات مطلوبة:</span>
                    <span class="status-stamp status-modifications font-mono-tabular" data-counter data-target="@Model.ModificationsRequiredCount">@Model.ModificationsRequiredCount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 small border-bottom">
                    <span>معتمد (بانتظار الشهادة):</span>
                    <span class="status-stamp status-approved font-mono-tabular" data-counter data-target="@Model.ApprovedCount">@Model.ApprovedCount</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 small">
                    <span>شهادات صادرة:</span>
                    <span class="status-stamp status-issued font-mono-tabular" data-counter data-target="@Model.CertificatesIssuedCount">@Model.CertificatesIssuedCount</span>
                </div>
            </div>
        </div>
    </div>
</div>
