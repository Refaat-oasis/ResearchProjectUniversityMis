@model researchProject.Models.DTOs.SystemStatisticsDto
@using researchProject.Models.Constants

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-primary mb-1">لوحة المؤشرات المركزية للجامعة</h3>
        <p class="text-muted mb-0">نظرة شاملة ومحدثة على حركة وأداء لجان أخلاقيات البحث العلمي بكافة الكليات</p>
    </div>
    <span class="badge bg-light text-dark border p-2">
        <i class="bi bi-clock-history me-1"></i> تاريخ التحديث: @DateTime.UtcNow.ToString("yyyy/MM/dd HH:mm") UTC
    </span>
</div>

<!-- Stat Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-label">إجمالي المقترحات البحثية</div>
                <div class="stat-number">@Model.TotalResearches</div>
            </div>
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-journal-check"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-label">قيد المراجعة الشكلية</div>
                <div class="stat-number text-warning">@Model.UnderScreeningCount</div>
            </div>
            <div class="stat-icon bg-warning-subtle text-warning">
                <i class="bi bi-hourglass-split"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-label">مسندة للمحكمين</div>
                <div class="stat-number text-info">@Model.AssignedToJudgesCount</div>
            </div>
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-person-lines-fill"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div>
                <div class="stat-label">شهادات صادرة رسمياً</div>
                <div class="stat-number text-success">@Model.CertificatesIssuedCount</div>
            </div>
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-patch-check-fill"></i>
            </div>
        </div>
    </div>
</div>

<!-- SLA Performance & Quick Indicators -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-stopwatch text-primary me-2"></i>مؤشر الالتزام بمهلة الفحص (48h)</h6>
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-1 fw-bold text-primary">@Model.SlaCompliancePercentage%</span>
                <span class="text-muted small">نسبة الالتزام بالـ SLA</span>
            </div>
            <div class="progress" style="height: 8px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: @Model.SlaCompliancePercentage%"></div>
            </div>
            <div class="text-muted small mt-2">متوسط زمن الفحص الشكلي: <strong>@Model.AverageScreeningHours ساعة</strong></div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-custom h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-people text-info me-2"></i>هيئة المحكمين والباحثين</h6>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">المحكمون النشطون:</span>
                <strong class="text-dark">@Model.TotalJudges محكم معتمد</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <span class="text-muted">الباحثون المسجلون:</span>
                <strong class="text-dark">@Model.TotalResearchers باحث</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2">
                <span class="text-muted">عدد الكليات المشاركة:</span>
                <strong class="text-dark">@Model.TotalColleges كلية</strong>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-custom h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart text-success me-2"></i>توزيع الحالات</h6>
            <div class="d-flex justify-content-between py-1 small">
                <span>تعديلات مطلوبة:</span>
                <span class="badge bg-danger">@Model.ModificationsRequiredCount</span>
            </div>
            <div class="d-flex justify-content-between py-1 small">
                <span>معتمد (بانتظار الشهادة):</span>
                <span class="badge bg-success">@Model.ApprovedCount</span>
            </div>
            <div class="d-flex justify-content-between py-1 small">
                <span>شهادات صادرة:</span>
                <span class="badge bg-dark">@Model.CertificatesIssuedCount</span>
            </div>
        </div>
    </div>
</div>
