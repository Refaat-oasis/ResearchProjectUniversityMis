@model researchProject.Models.ViewModels.SystemStatisticsViewModel
@{
    ViewData["Title"] = "تقارير ومؤشرات الاعتماد المؤسسي والجودة";
}

<div class="page-header-card">
    <div>
        <h1 class="page-title"><i class="bi bi-graph-up-arrow"></i> تقارير ومؤشرات الاعتماد المؤسسي والجودة</h1>
        <p>تحليلات إحصائية شاملة ومؤشرات أداء دقيقة تخدم متطلبات الجودة والاعتماد الأكاديمي ولجان أخلاقيات البحث العلمي</p>
    </div>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a href="/SuperAdmin/ExportReportsToCsv" class="btn btn-brass btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل (CSV)
        </a>
        <button class="btn btn-outline-light btn-sm" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> طباعة التقرير / PDF
        </button>
    </div>
</div>

<!-- Key Performance Indicators (KPIs) -->
<div class="kpi-ledger-grid mb-4">
    <div class="kpi-ledger-cell">
        <div class="kpi-ledger-label"><i class="bi bi-stopwatch me-1"></i>متوسط زمن الفحص الشكلي</div>
        <div class="kpi-ledger-value" style="color: @(Model.AverageScreeningHours <= 48 ? "var(--brand-sovereign)" : "#8C1D24");">@Model.AverageScreeningHours.ToString("0.0")</div>
        <div class="kpi-ledger-sub" title="ساعة (الحد النظامي: 48 ساعة)">ساعة (الحد النظامي: 48 ساعة)</div>
        <div class="progress mt-1" style="height: 5px;">
            <div class="progress-bar" style="width: @Math.Min(100, (Model.AverageScreeningHours / 48.0) * 100)%; background-color: @(Model.AverageScreeningHours <= 48 ? "var(--brand-sovereign)" : "#8C1D24");"></div>
        </div>
    </div>
    <div class="kpi-ledger-cell">
        <div class="kpi-ledger-label"><i class="bi bi-calendar-check me-1"></i>متوسط فترة التحكيم الأخلاقي</div>
        <div class="kpi-ledger-value" style="color: #1D3A5F;">@Model.AverageJudgingDays.ToString("0.0")</div>
        <div class="kpi-ledger-sub" title="يوم عمل (الحد النظامي: 14 يوم)">يوم عمل (الحد النظامي: 14 يوم)</div>
        <div class="progress mt-1" style="height: 5px;">
            <div class="progress-bar" style="width: @Math.Min(100, (Model.AverageJudgingDays / 14.0) * 100)%; background-color: @(Model.AverageJudgingDays <= 14 ? "#1D3A5F" : "var(--brand-brass)");"></div>
        </div>
    </div>
    <div class="kpi-ledger-cell">
        <div class="kpi-ledger-label"><i class="bi bi-shield-check me-1"></i>نسبة الالتزام بالمهلة (SLA)</div>
        <div class="kpi-ledger-value" style="color: @(Model.SlaCompliancePercentage >= 85 ? "var(--brand-sovereign)" : "var(--brand-brass)");">@Model.SlaCompliancePercentage.ToString("0.0")%</div>
        <div class="kpi-ledger-sub" title="المعدل المستهدف: 90%+">المعدل المستهدف: 90%+</div>
        <div class="progress mt-1" style="height: 5px;">
            <div class="progress-bar" style="width: @Math.Min(100, Model.SlaCompliancePercentage)%; background-color: var(--brand-sovereign);"></div>
        </div>
    </div>
    <div class="kpi-ledger-cell">
        <div class="kpi-ledger-label"><i class="bi bi-patch-check me-1"></i>إجمالي الشهادات المعتمدة الصادرة</div>
        <div class="kpi-ledger-value" style="color: var(--brand-brass);">@Model.CertificatesIssuedCount</div>
        <div class="kpi-ledger-sub" title="من إجمالي @Model.TotalResearches مقترحاً">من إجمالي <span class="font-mono-tabular">@Model.TotalResearches</span> مقترحاً</div>
        <div class="progress mt-1" style="height: 5px;">
            <div class="progress-bar" style="width: @(Model.TotalResearches > 0 ? (Model.CertificatesIssuedCount * 100.0 / Model.TotalResearches) : 0)%; background-color: var(--brand-brass);"></div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Distribution by College -->
    <div class="col-12 col-lg-6">
        <div class="card-custom archival-card h-100 mb-0">
            <div class="card-header-custom">
                <h2 class="card-title-custom fs-5">
                    <i class="bi bi-buildings"></i> توزيع المقترحات حسب كليات الجامعة
                </h2>
                <span class="status-stamp status-assigned font-mono-tabular">@Model.TotalColleges كلية</span>
            </div>
            <div class="table-responsive">
                <table class="table ledger-table align-middle">
                    <thead>
                        <tr>
                            <th>الكلية</th>
                            <th class="text-center">عدد المقترحات</th>
                            <th class="text-center">النسبة المئوية</th>
                            <th style="width: 35%;">مؤشر الحصة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResearchesByCollege != null && Model.ResearchesByCollege.Any())
                        {
                            foreach (var item in Model.ResearchesByCollege.OrderByDescending(c => c.Value))
                            {
                                var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches) : 0.0;
                                <tr>
                                    <td class="fw-bold">@item.Key</td>
                                    <td class="text-center"><span class="status-stamp status-assigned font-mono-tabular">@item.Value</span></td>
                                    <td class="text-center font-mono-tabular" style="color: var(--ink-muted);">@pct.ToString("0.0")%</td>
                                    <td>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar" role="progressbar" style="width: @pct%; background-color: var(--brand-sovereign);"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4" style="color: var(--ink-muted);">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i> لا توجد بيانات مسجلة للكليات حالياً.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Distribution by Research Category -->
    <div class="col-12 col-lg-6">
        <div class="card-custom archival-card h-100 mb-0">
            <div class="card-header-custom">
                <h2 class="card-title-custom fs-5">
                    <i class="bi bi-sliders"></i> توزيع الأبحاث حسب التصنيف والتخصص
                </h2>
                <span class="status-stamp">تصنيفات معتمدة</span>
            </div>
            <div class="table-responsive">
                <table class="table ledger-table align-middle">
                    <thead>
                        <tr>
                            <th>تصنيف البحث</th>
                            <th class="text-center">عدد المقترحات</th>
                            <th class="text-center">النسبة المئوية</th>
                            <th style="width: 35%;">مؤشر الحصة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResearchesByCategory != null && Model.ResearchesByCategory.Any())
                        {
                            foreach (var item in Model.ResearchesByCategory.OrderByDescending(c => c.Value))
                            {
                                var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches) : 0.0;
                                <tr>
                                    <td class="fw-bold">@item.Key</td>
                                    <td class="text-center"><span class="status-stamp status-screening font-mono-tabular">@item.Value</span></td>
                                    <td class="text-center font-mono-tabular" style="color: var(--ink-muted);">@pct.ToString("0.0")%</td>
                                    <td>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar" role="progressbar" style="width: @pct%; background-color: var(--brand-brass);"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4" style="color: var(--ink-muted);">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i> لا توجد بيانات تصنيفات مسجلة حالياً.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Workflow Health Breakdown -->
<div class="card-custom archival-card">
    <div class="card-header-custom">
        <h2 class="card-title-custom fs-5">
            <i class="bi bi-diagram-3"></i> سلامة مسارات التحكيم ومراحل العمل الإجرائي
        </h2>
    </div>
    <div class="row g-3 text-center">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">قيد الفحص الشكلي</div>
                <div class="fs-4 fw-bold font-mono-tabular mt-1" style="color: var(--ink-secondary);">@Model.UnderScreeningCount</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">مسند للجان التحكيم</div>
                <div class="fs-4 fw-bold font-mono-tabular mt-1" style="color: #1D3A5F;">@Model.AssignedToJudgesCount</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">تعديلات قيد الإجراء</div>
                <div class="fs-4 fw-bold font-mono-tabular mt-1" style="color: #8C1D24;">@Model.ModificationsRequiredCount</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">معتمد أخلاقياً</div>
                <div class="fs-4 fw-bold font-mono-tabular mt-1" style="color: var(--brand-sovereign);">@Model.ApprovedCount</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">إجمالي المحكمين</div>
                <div class="fs-4 fw-bold font-mono-tabular mt-1" style="color: var(--ink-primary);">@Model.TotalJudges</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="dossier-panel-subtle h-100">
                <div class="small" style="color: var(--ink-muted);">إجمالي الباحثين</div>
                <div class="fs-4 fw-bold font-mono-tabular mt-1" style="color: var(--brand-brass);">@Model.TotalResearchers</div>
            </div>
        </div>
    </div>
</div>

