@model researchProject.Models.ViewModels.SystemStatisticsViewModel
@{
    ViewData["Title"] = "تقارير ومؤشرات الاعتماد المؤسسي والجودة";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-graph-up-arrow text-primary"></i> تقارير ومؤشرات الاعتماد المؤسسي والجودة</h2>
        <p>تحليلات إحصائية شاملة ومؤشرات أداء دقيقة تخدم متطلبات الجودة والاعتماد الأكاديمي ولجان أخلاقيات البحث العلمي</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a href="/SuperAdmin/ExportReportsToCsv" class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل (CSV)
        </a>
        <button class="btn btn-outline-primary" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> طباعة التقرير / PDF
        </button>
    </div>
</div>

<!-- Key Performance Indicators (KPIs) -->
<div class="row g-3 mb-4 align-items-stretch">
    <div class="col-md-3 d-flex">
        <div class="liquid-glass-card kpi-metric-card text-center w-100 flex-fill">
            <div class="kpi-header-box">
                <span><i class="bi bi-stopwatch text-primary me-1"></i>متوسط زمن الفحص الشكلي</span>
            </div>
            <div class="kpi-value-box">
                <span class="kpi-number text-primary">@Model.AverageScreeningHours.ToString("0.0")</span>
            </div>
            <div class="kpi-footer-box">
                <div class="kpi-subtext" title="ساعة (الحد النظامي: 48 ساعة)">ساعة (الحد النظامي: 48 ساعة)</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar @(Model.AverageScreeningHours <= 48 ? "bg-success" : "bg-danger")" 
                         style="width: @Math.Min(100, (Model.AverageScreeningHours / 48.0) * 100)%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 d-flex">
        <div class="liquid-glass-card kpi-metric-card text-center w-100 flex-fill">
            <div class="kpi-header-box">
                <span><i class="bi bi-calendar-check text-info me-1"></i>متوسط فترة التحكيم الأخلاقي</span>
            </div>
            <div class="kpi-value-box">
                <span class="kpi-number text-info">@Model.AverageJudgingDays.ToString("0.0")</span>
            </div>
            <div class="kpi-footer-box">
                <div class="kpi-subtext" title="يوم عمل (الحد النظامي: 14 يوم)">يوم عمل (الحد النظامي: 14 يوم)</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar @(Model.AverageJudgingDays <= 14 ? "bg-info" : "bg-warning")" 
                         style="width: @Math.Min(100, (Model.AverageJudgingDays / 14.0) * 100)%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 d-flex">
        <div class="liquid-glass-card kpi-metric-card text-center w-100 flex-fill">
            <div class="kpi-header-box">
                <span><i class="bi bi-shield-check text-success me-1"></i>نسبة الالتزام بالمهلة (SLA)</span>
            </div>
            <div class="kpi-value-box">
                <span class="kpi-number @(Model.SlaCompliancePercentage >= 85 ? "text-success" : "text-warning")">
                    @Model.SlaCompliancePercentage.ToString("0.0")%
                </span>
            </div>
            <div class="kpi-footer-box">
                <div class="kpi-subtext" title="المعدل المستهدف: 90%+">المعدل المستهدف: 90%+</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: @Math.Min(100, Model.SlaCompliancePercentage)%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 d-flex">
        <div class="liquid-glass-card kpi-metric-card text-center w-100 flex-fill">
            <div class="kpi-header-box">
                <span><i class="bi bi-patch-check text-warning me-1"></i>إجمالي الشهادات المعتمدة الصادرة</span>
            </div>
            <div class="kpi-value-box">
                <span class="kpi-number text-warning">@Model.CertificatesIssuedCount</span>
            </div>
            <div class="kpi-footer-box">
                <div class="kpi-subtext" title="من إجمالي @Model.TotalResearches مقترحاً">من إجمالي @Model.TotalResearches مقترحاً</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-warning" 
                         style="width: @(Model.TotalResearches > 0 ? (Model.CertificatesIssuedCount * 100.0 / Model.TotalResearches) : 0)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Distribution by College -->
    <div class="col-lg-6">
        <div class="liquid-glass-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-buildings text-primary me-2"></i>توزيع المقترحات حسب كليات الجامعة
                </h5>
                <span class="badge bg-primary-subtle text-primary border">@Model.TotalColleges كلية</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>الكلية</th>
                            <th class="text-center">عدد المقترحات</th>
                            <th class="text-center">النسبة المئوية</th>
                            <th style="width: 35%;">مؤشر الحصة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResearchesByCollege != null && Model.ResearchesByCollege.Any())
                        {
                            foreach (var item in Model.ResearchesByCollege.OrderByDescending(c => c.Value))
                            {
                                var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches) : 0.0;
                                <tr>
                                    <td class="fw-bold">@item.Key</td>
                                    <td class="text-center"><span class="badge bg-primary">@item.Value</span></td>
                                    <td class="text-center text-muted">@pct.ToString("0.0")%</td>
                                    <td>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i> لا توجد بيانات مسجلة للكليات حالياً.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Distribution by Research Category -->
    <div class="col-lg-6">
        <div class="liquid-glass-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-sliders text-info me-2"></i>توزيع الأبحاث حسب التصنيف والتخصص
                </h5>
                <span class="badge bg-info-subtle text-info border">تصنيفات معتمدة</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>تصنيف البحث</th>
                            <th class="text-center">عدد المقترحات</th>
                            <th class="text-center">النسبة المئوية</th>
                            <th style="width: 35%;">مؤشر الحصة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResearchesByCategory != null && Model.ResearchesByCategory.Any())
                        {
                            foreach (var item in Model.ResearchesByCategory.OrderByDescending(c => c.Value))
                            {
                                var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches) : 0.0;
                                <tr>
                                    <td class="fw-bold">@item.Key</td>
                                    <td class="text-center"><span class="badge bg-info text-dark">@item.Value</span></td>
                                    <td class="text-center text-muted">@pct.ToString("0.0")%</td>
                                    <td>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @pct%"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i> لا توجد بيانات تصنيفات مسجلة حالياً.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Workflow Health Breakdown -->
<div class="liquid-glass-card p-4">
    <h5 class="fw-bold text-dark mb-3">
        <i class="bi bi-diagram-3 text-success me-2"></i>سلامة مسارات التحكيم ومراحل العمل الإجرائي
    </h5>
    <div class="row g-3 text-center">
        <div class="col-md-2 col-6">
            <div class="p-3 border rounded bg-white">
                <div class="text-muted small">قيد الفحص الشكلي</div>
                <div class="fs-4 fw-bold text-secondary mt-1">@Model.UnderScreeningCount</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="p-3 border rounded bg-white">
                <div class="text-muted small">مسند للجان التحكيم</div>
                <div class="fs-4 fw-bold text-primary mt-1">@Model.AssignedToJudgesCount</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="p-3 border rounded bg-white">
                <div class="text-muted small">تعديلات قيد الإجراء</div>
                <div class="fs-4 fw-bold text-warning mt-1">@Model.ModificationsRequiredCount</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="p-3 border rounded bg-white">
                <div class="text-muted small">معتمد أخلاقياً</div>
                <div class="fs-4 fw-bold text-success mt-1">@Model.ApprovedCount</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="p-3 border rounded bg-white">
                <div class="text-muted small">إجمالي المحكمين</div>
                <div class="fs-4 fw-bold text-dark mt-1">@Model.TotalJudges</div>
            </div>
        </div>
        <div class="col-md-2 col-6">
            <div class="p-3 border rounded bg-white">
                <div class="text-muted small">إجمالي الباحثين</div>
                <div class="fs-4 fw-bold text-info mt-1">@Model.TotalResearchers</div>
            </div>
        </div>
    </div>
</div>

