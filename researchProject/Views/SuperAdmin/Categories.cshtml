@model List<researchProject.Models.Entities.ResearchCategory>
@{
    ViewData["Title"] = "تصنيفات الأبحاث ونماذج الحقول الديناميكية";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-sliders text-warning"></i> تصنيفات الأبحاث ونماذج الحقول الديناميكية</h2>
        <p>تحديد نوع الأبحاث (بشري، حيواني، سريري، استبيانات) وبناء الحقول التفاعلية الإضافية لكل تصنيف</p>
    </div>
    <button class="btn btn-primary-custom btn-sm" onclick="openFieldsBuilder(0, 0, '', '', '[]');">
        <i class="bi bi-plus-lg me-1"></i> إضافة تصنيف جديد
    </button>
</div>

<div class="liquid-glass-card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>اسم التصنيف</th>
                    <th>الكلية التابع لها</th>
                    <th>الوصف</th>
                    <th>تعريف الحقول الإضافية</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var cat in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td class="fw-bold text-dark">@cat.Name</td>
                            <td><span class="badge bg-light text-dark border">@cat.College?.Name</span></td>
                            <td class="text-muted small" style="max-width: 250px;">@(cat.Description ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(cat.FieldsDefinitionJson))
                                {
                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-check2-circle me-1"></i>حقول ديناميكية معرفة</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">لا توجد حقول إضافية</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" onclick='openFieldsBuilder(@cat.Id, @cat.CollegeId, "@cat.Name", @Html.Raw(Json.Serialize(cat.Description ?? "")), @Html.Raw(Json.Serialize(cat.FieldsDefinitionJson ?? "[]")))'>
                                    <i class="bi bi-gear-wide-connected"></i> تعديل وتصميم الحقول
                                </button>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">لا توجد تصنيفات أبحاث مسجلة حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Category & Dynamic Fields Builder -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel"><i class="bi bi-magic me-2 text-primary"></i>تصميم تصنيف البحث والحقول التفاعلية</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="categoryForm" asp-action="SaveCategory" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="catId" value="0" />
                <input type="hidden" name="FieldsDefinitionJson" id="catFieldsJson" value="[]" />

                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الكلية <span class="text-danger">*</span></label>
                            <select name="CollegeId" id="catCollegeId" class="form-select" required>
                                <option value="">-- اختر الكلية --</option>
                                @if (ViewBag.Colleges != null)
                                {
                                    foreach (var c in ViewBag.Colleges)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">اسم تصنيف البحث <span class="text-danger">*</span></label>
                            <input type="text" name="Name" id="catName" class="form-control" required placeholder="مثال: أبحاث وتجارب سريرية" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">وصف التصنيف</label>
                            <textarea name="Description" id="catDesc" class="form-control" rows="2" placeholder="وصف موجز لطبيعة الأبحاث المندرجة تحت هذا التصنيف"></textarea>
                        </div>
                    </div>

                    <div class="card bg-light border p-3 rounded-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-dark mb-0"><i class="bi bi-ui-checks me-2 text-primary"></i>الحقول الإضافية في نموذج التقديم</h6>
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="addFieldRow();">
                                <i class="bi bi-plus-circle me-1"></i> إضافة حقل جديد
                            </button>
                        </div>
                        <div class="text-muted small mb-3">يمكنك تعريف حقول مخصصة (نص، رقم، تاريخ، قائمة منسدلة، نعم/لا) تظهر للباحث عند اختيار هذا التصنيف.</div>

                        <div id="fieldsContainer" class="d-flex flex-column gap-2">
                            <!-- Dynamic field rows inserted here -->
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">حفظ التصنيف والحقول</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentFields = [];

        function openFieldsBuilder(id, collegeId, name, desc, fieldsJson) {
            $('#catId').val(id);
            $('#catCollegeId').val(collegeId);
            $('#catName').val(name);
            $('#catDesc').val(desc);

            try {
                currentFields = typeof fieldsJson === 'string' ? JSON.parse(fieldsJson) : fieldsJson;
            } catch (e) {
                currentFields = [];
            }

            renderFieldRows();
            new bootstrap.Modal(document.getElementById('addCategoryModal')).show();
        }

        function addFieldRow() {
            currentFields.push({
                Name: 'Field_' + (currentFields.length + 1),
                Label: 'حقل إضافي ' + (currentFields.length + 1),
                Type: 'text',
                IsRequired: true,
                Options: []
            });
            renderFieldRows();
        }

        function removeFieldRow(idx) {
            currentFields.splice(idx, 1);
            renderFieldRows();
        }

        function renderFieldRows() {
            var $c = $('#fieldsContainer');
            $c.empty();

            if (currentFields.length === 0) {
                $c.html('<div class="text-muted text-center py-3 small">لا توجد حقول إضافية بعد. انقر على "إضافة حقل جديد" لإدراج حقول مخصصة.</div>');
                return;
            }

            currentFields.forEach(function (f, i) {
                var html = '<div class="row g-2 align-items-center bg-white p-2 border rounded shadow-sm">' +
                    '<div class="col-md-3">' +
                    '<input type="text" class="form-control form-control-sm" placeholder="اسم المعرف (Code)" value="' + (f.Name || '') + '" onchange="currentFields[' + i + '].Name = this.value;" dir="ltr" />' +
                    '</div>' +
                    '<div class="col-md-4">' +
                    '<input type="text" class="form-control form-control-sm" placeholder="التسمية العربية للحقل" value="' + (f.Label || '') + '" onchange="currentFields[' + i + '].Label = this.value;" />' +
                    '</div>' +
                    '<div class="col-md-3">' +
                    '<select class="form-select form-select-sm" onchange="currentFields[' + i + '].Type = this.value;">' +
                    '<option value="text"' + (f.Type === 'text' ? ' selected' : '') + '>نص عادي</option>' +
                    '<option value="textarea"' + (f.Type === 'textarea' ? ' selected' : '') + '>نص تفصيلي (فقرة)</option>' +
                    '<option value="number"' + (f.Type === 'number' ? ' selected' : '') + '>رقم</option>' +
                    '<option value="date"' + (f.Type === 'date' ? ' selected' : '') + '>تاريخ</option>' +
                    '<option value="dropdown"' + (f.Type === 'dropdown' ? ' selected' : '') + '>قائمة اختيار</option>' +
                    '<option value="yesno"' + (f.Type === 'yesno' ? ' selected' : '') + '>نعم / لا</option>' +
                    '</select>' +
                    '</div>' +
                    '<div class="col-md-1 text-center">' +
                    '<div class="form-check d-inline-block">' +
                    '<input class="form-check-input" type="checkbox"' + (f.IsRequired ? ' checked' : '') + ' onchange="currentFields[' + i + '].IsRequired = this.checked;" title="إلزامي؟" />' +
                    '</div>' +
                    '</div>' +
                    '<div class="col-md-1 text-center">' +
                    '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFieldRow(' + i + ')"><i class="bi bi-trash"></i></button>' +
                    '</div>' +
                    '</div>';
                $c.append(html);
            });
        }

        $('#categoryForm').on('submit', function (e) {
            e.preventDefault();
            $('#catFieldsJson').val(JSON.stringify(currentFields));
            const form = this;
            const data = $(form).serialize();

            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: data,
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    alert(res.message);
                    if (res.success) {
                        window.location.reload();
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    alert(xhr.responseText || 'حدث خطأ.');
                }
            });
        });
    </script>
}

