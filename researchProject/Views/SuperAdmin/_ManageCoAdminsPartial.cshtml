@model List<researchProject.Models.Entities.CollegeCoAdmin>

<div class="card card-custom">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-person-badge text-primary"></i> إدارة مديري اللجان الفرعية بالكليات (College Co-Admins)
            </h4>
            <div class="text-muted small">تعيين مديري اللجان لكل كلية لإدارة الفحص الشكلي وإسناد المحكمين والاعتماد وإصدار الشهادات</div>
        </div>
        <button class="btn btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#addCoAdminModal">
            <i class="bi bi-person-plus-fill me-1"></i> تعيين مدير لجنة جديد
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>الاسم الكامل</th>
                    <th>البريد الإلكتروني</th>
                    <th>الكلية المسندة</th>
                    <th>تاريخ التسجيل</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var a in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td class="fw-bold text-dark">@a.User?.FullName</td>
                            <td dir="ltr" class="text-end font-monospace small">@a.User?.Email</td>
                            <td><span class="badge bg-primary-subtle text-primary fs-6">@a.College?.Name</span></td>
                            <td class="text-muted small">@DateTime.UtcNow.ToString("yyyy/MM/dd")</td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">لا يوجد مديرو لجان مسجلون حالياً.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Add Co-Admin -->
<div class="modal fade" id="addCoAdminModal" tabindex="-1" aria-labelledby="addCoAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="addCoAdminModalLabel"><i class="bi bi-person-plus me-2 text-primary"></i>تعيين مدير لجنة فرعية لكلية</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCoAdminForm" action="/SuperAdmin/CreateCoAdminNewUser" method="post" onsubmit="return handleCoAdminSubmit(this);">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الكلية التابع لها <span class="text-danger">*</span></label>
                        <input type="hidden" name="collegeId" id="partialCoAdminCollegeId" />
                        <div class="custom-datalist-wrapper">
                            <i class="bi bi-search datalist-search-icon"></i>
                            <input type="text" list="partialCoAdminCollegesList" id="partialCoAdminCollegeInput" 
                                   class="form-control custom-datalist-input" 
                                   placeholder="ابحث أو اختر الكلية من النظام..." 
                                   data-hidden-target="#partialCoAdminCollegeId"
                                   required autocomplete="off" />
                            <button type="button" class="datalist-clear-btn" title="تفريغ الحقل">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                        <datalist id="partialCoAdminCollegesList">
                            @if (ViewBag.Colleges != null)
                            {
                                foreach (var c in ViewBag.Colleges)
                                {
                                    <option value="@c.Name" data-id="@c.Id">@c.Code</option>
                                }
                            }
                        </datalist>
                        <div class="custom-datalist-hint">
                            <i class="bi bi-info-circle me-1"></i> اختر من كليات الجامعة المسجلة لإسناد الصلاحيات إليها.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control" required placeholder="مثال: أ.د. أحمد محمد علي" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" required placeholder="coadmin@domain.com" dir="ltr" />
                        <div class="form-text small">سيقوم النظام بإنشاء كلمة مرور مؤقتة وإرسالها إلى بريده مباشرة.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary-custom">إنشاء الحساب وتعيين الدور</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $('#partialCoAdminCollegeInput').on('input change', function () {
        var selectedVal = $(this).val();
        var match = $('#partialCoAdminCollegesList option').filter(function () {
            return this.value === selectedVal;
        });
        if (match.length > 0) {
            $('#partialCoAdminCollegeId').val(match.data('id'));
        } else {
            $('#partialCoAdminCollegeId').val('');
        }
    });

    function handleCoAdminSubmit(form) {
        var selectedVal = $('#partialCoAdminCollegeInput').val();
        var match = $('#partialCoAdminCollegesList option').filter(function () {
            return this.value === selectedVal;
        });
        if (match.length > 0) {
            $('#partialCoAdminCollegeId').val(match.data('id'));
        }
        if (!$('#partialCoAdminCollegeId').val()) {
            alert('يرجى اختيار الكلية من القائمة.');
            return false;
        }
        return handleAjaxFormSubmit(form, onCoAdminSaved);
    }

    function onCoAdminSaved(res) {
        $('#addCoAdminModal').modal('hide');
        $('.modal-backdrop').remove();
        loadPartial('/SuperAdmin/ManageCoAdminsPartial', '#main-content-container', 'coadmins');
    }
</script>
