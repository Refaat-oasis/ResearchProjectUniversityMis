@model researchProject.Models.ViewModels.SystemStatisticsViewModel

<div class="card card-custom">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-graph-up-arrow text-primary"></i> تقارير ومؤشرات الاعتماد المؤسسي والجودة
            </h4>
            <div class="text-muted small">تقارير إحصائية دقيقة تخدم متطلبات الجودة والاعتماد الأكاديمي ولجان الأخلاقيات</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/SuperAdmin/ExportReportsToCsv" class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل (Excel)
            </a>
            <button class="btn btn-outline-success btn-sm" onclick="window.print();">
                <i class="bi bi-printer me-1"></i> طباعة التقرير / PDF
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- By College Distribution -->
        <div class="col-md-6">
            <div class="border rounded p-3 bg-light">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-buildings me-2 text-primary"></i>توزيع الأبحاث حسب كليات الجامعة</h6>
                <table class="table table-sm table-hover bg-white rounded">
                    <thead>
                        <tr>
                            <th>الكلية</th>
                            <th class="text-center">عدد المقترحات</th>
                            <th class="text-center">النسبة المئوية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResearchesByCollege.Any())
                        {
                            foreach (var item in Model.ResearchesByCollege)
                            {
                                var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches).ToString("0.0") : "0";
                                <tr>
                                    <td class="fw-bold">@item.Key</td>
                                    <td class="text-center"><span class="badge bg-primary">@item.Value</span></td>
                                    <td class="text-center text-muted">@pct%</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center text-muted">لا توجد بيانات.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- By Category Distribution -->
        <div class="col-md-6">
            <div class="border rounded p-3 bg-light">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-sliders me-2 text-primary"></i>توزيع الأبحاث حسب التصنيف والنوع</h6>
                <table class="table table-sm table-hover bg-white rounded">
                    <thead>
                        <tr>
                            <th>تصنيف البحث</th>
                            <th class="text-center">عدد المقترحات</th>
                            <th class="text-center">النسبة المئوية</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ResearchesByCategory.Any())
                        {
                            foreach (var item in Model.ResearchesByCategory)
                            {
                                var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches).ToString("0.0") : "0";
                                <tr>
                                    <td class="fw-bold">@item.Key</td>
                                    <td class="text-center"><span class="badge bg-info text-dark">@item.Value</span></td>
                                    <td class="text-center text-muted">@pct%</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center text-muted">لا توجد بيانات.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Key Performance Indicators (KPIs) -->
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-speedometer text-primary me-2"></i>مؤشرات قياس الأداء الرئيسية (KPIs)</h6>
    <div class="row g-3">
        <div class="col-md-3">
            <div class="p-3 border rounded bg-white text-center">
                <div class="text-muted small">متوسط زمن الفحص الشكلي</div>
                <div class="fs-3 fw-bold text-primary mt-1">@Model.AverageScreeningHours</div>
                <div class="text-muted small">ساعة (الحد الأقصى: 48 ساعة)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded bg-white text-center">
                <div class="text-muted small">متوسط زمن التحكيم الأخلاقي</div>
                <div class="fs-3 fw-bold text-info mt-1">@Model.AverageJudgingDays</div>
                <div class="text-muted small">أيام عمل لكل مقترح</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded bg-white text-center">
                <div class="text-muted small">الامتثال لاتفاقية مستوى الخدمة</div>
                <div class="fs-3 fw-bold text-success mt-1">@Model.SlaCompliancePercentage%</div>
                <div class="text-muted small">أبحاث فُحصت خلال المهلة</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 border rounded bg-white text-center">
                <div class="text-muted small">إجمالي الشهادات المصدرة</div>
                <div class="fs-3 fw-bold text-dark mt-1">@Model.CertificatesIssuedCount</div>
                <div class="text-muted small">شهادة أخلاقية رقمية</div>
            </div>
        </div>
    </div>
</div>
