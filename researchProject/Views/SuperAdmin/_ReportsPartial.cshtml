@model researchProject.Models.ViewModels.SystemStatisticsViewModel

<div class="card card-custom archival-card">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-graph-up-arrow"></i> تقارير ومؤشرات الاعتماد المؤسسي والجودة
            </h4>
            <div class="small" style="color: var(--ink-muted);">تقارير إحصائية دقيقة تخدم متطلبات الجودة والاعتماد الأكاديمي ولجان الأخلاقيات</div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="/SuperAdmin/ExportReportsToCsv" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل (Excel)
            </a>
            <button class="btn btn-outline-primary btn-sm" onclick="window.print();">
                <i class="bi bi-printer me-1"></i> طباعة التقرير / PDF
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- By College Distribution -->
        <div class="col-12 col-md-6">
            <div class="dossier-panel-subtle h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ink-primary);"><i class="bi bi-buildings me-2"></i>توزيع الأبحاث حسب كليات الجامعة</h6>
                <div class="table-responsive">
                    <table class="table ledger-table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>الكلية</th>
                                <th class="text-center">عدد المقترحات</th>
                                <th class="text-center">النسبة المئوية</th>
                                <th style="width: 30%;">مؤشر الحصة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ResearchesByCollege.Any())
                            {
                                foreach (var item in Model.ResearchesByCollege)
                                {
                                    var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches) : 0.0;
                                    <tr>
                                        <td class="fw-bold">@item.Key</td>
                                        <td class="text-center"><span class="status-stamp status-assigned font-mono-tabular" data-counter data-target="@item.Value">@item.Value</span></td>
                                        <td class="text-center font-mono-tabular" style="color: var(--ink-muted);" data-counter data-target="@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix="%">@pct.ToString("0.0")%</td>
                                        <td>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar animated-progress-bar" role="progressbar" style="width: 0%; background-color: var(--brand-sovereign);" data-target-width="@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center" style="color: var(--ink-muted);">لا توجد بيانات.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- By Category Distribution -->
        <div class="col-12 col-md-6">
            <div class="dossier-panel-subtle h-100">
                <h6 class="fw-bold mb-3" style="color: var(--ink-primary);"><i class="bi bi-sliders me-2"></i>توزيع الأبحاث حسب التصنيف والنوع</h6>
                <div class="table-responsive">
                    <table class="table ledger-table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>تصنيف البحث</th>
                                <th class="text-center">عدد المقترحات</th>
                                <th class="text-center">النسبة المئوية</th>
                                <th style="width: 30%;">مؤشر الحصة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ResearchesByCategory.Any())
                            {
                                foreach (var item in Model.ResearchesByCategory)
                                {
                                    var pct = Model.TotalResearches > 0 ? (item.Value * 100.0 / Model.TotalResearches) : 0.0;
                                    <tr>
                                        <td class="fw-bold">@item.Key</td>
                                        <td class="text-center"><span class="status-stamp status-screening font-mono-tabular" data-counter data-target="@item.Value">@item.Value</span></td>
                                        <td class="text-center font-mono-tabular" style="color: var(--ink-muted);" data-counter data-target="@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix="%">@pct.ToString("0.0")%</td>
                                        <td>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar animated-progress-bar" role="progressbar" style="width: 0%; background-color: var(--brand-brass);" data-target-width="@pct.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center" style="color: var(--ink-muted);">لا توجد بيانات.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Performance Indicators (KPIs) -->
    <h6 class="fw-bold mb-3" style="color: var(--ink-primary);"><i class="bi bi-speedometer me-2"></i>مؤشرات قياس الأداء الرئيسية (KPIs)</h6>
    <div class="kpi-ledger-grid mb-0">
        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label"><i class="bi bi-stopwatch me-1"></i>متوسط زمن الفحص الشكلي</div>
            <div class="kpi-ledger-value font-mono-tabular" style="color: var(--brand-sovereign);" data-counter data-target="@Model.AverageScreeningHours.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1">@Model.AverageScreeningHours.ToString("0.0")</div>
            <div class="kpi-ledger-sub" title="ساعة (الحد الأقصى: 48 ساعة)">ساعة (الحد الأقصى: 48 ساعة)</div>
            <div class="progress mt-1" style="height: 5px;">
                <div class="progress-bar animated-progress-bar" style="width: 0%; background-color: var(--brand-sovereign);" data-target-width="@Math.Min(100, (Model.AverageScreeningHours / 48.0) * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label"><i class="bi bi-calendar-check me-1"></i>متوسط زمن التحكيم الأخلاقي</div>
            <div class="kpi-ledger-value font-mono-tabular" style="color: #1D3A5F;" data-counter data-target="@Model.AverageJudgingDays.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1">@Model.AverageJudgingDays.ToString("0.0")</div>
            <div class="kpi-ledger-sub" title="أيام عمل لكل مقترح">أيام عمل لكل مقترح</div>
            <div class="progress mt-1" style="height: 5px;">
                <div class="progress-bar animated-progress-bar" style="width: 0%; background-color: #1D3A5F;" data-target-width="@Math.Min(100, (Model.AverageJudgingDays / 14.0) * 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label"><i class="bi bi-shield-check me-1"></i>الامتثال لاتفاقية مستوى الخدمة</div>
            <div class="kpi-ledger-value font-mono-tabular" style="color: var(--brand-sovereign);" data-counter data-target="@Model.SlaCompliancePercentage.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-decimals="1" data-suffix="%">@Model.SlaCompliancePercentage.ToString("0.0")%</div>
            <div class="kpi-ledger-sub" title="أبحاث فُحصت خلال المهلة">أبحاث فُحصت خلال المهلة</div>
            <div class="progress mt-1" style="height: 5px;">
                <div class="progress-bar animated-progress-bar" style="width: 0%; background-color: var(--brand-sovereign);" data-target-width="@Math.Min(100, Model.SlaCompliancePercentage).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label"><i class="bi bi-patch-check me-1"></i>إجمالي الشهادات المعتمدة الصادرة</div>
            <div class="kpi-ledger-value font-mono-tabular" style="color: var(--brand-brass);" data-counter data-target="@Model.CertificatesIssuedCount">@Model.CertificatesIssuedCount</div>
            <div class="kpi-ledger-sub" title="شهادة أخلاقية رقمية">شهادة أخلاقية رقمية</div>
            <div class="progress mt-1" style="height: 5px;">
                <div class="progress-bar animated-progress-bar" style="width: 0%; background-color: var(--brand-brass);" data-target-width="@(Model.TotalResearches > 0 ? (Model.CertificatesIssuedCount * 100.0 / Model.TotalResearches) : 0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    </div>
</div>
