@{
    ViewData["Title"] = "الرئيسية - المنصة الإلكترونية لأخلاقيات البحث العلمي والنزاهة الأكاديمية";
}

@section Styles {
    <style>
        .home-landing {
            --hm-ink: #0E2235;
            --hm-body: #475569;
            --hm-muted: #64748B;
            --hm-navy: #0E2235;
            --hm-navy-hover: #163652;
            --hm-emerald: #14533C;
            --hm-emerald-hover: #0E3F2D;
            --hm-gold: #D4AF5A;
            --hm-gold-hover: #DFBF72;
            --hm-surface: #FFFFFF;
            --hm-canvas: #F8FAFC;
            --hm-slate-bg: #F3F5F8;
            --hm-border: #E2E8F0;
            --hm-radius-lg: 18px;
            --hm-radius-md: 12px;
            --hm-radius-sm: 10px;
            font-family: "Cairo", sans-serif;
            color: var(--hm-ink);
            background-color: var(--hm-surface);
        }

        .home-landing *,
        .home-landing *::before,
        .home-landing *::after {
            box-sizing: border-box;
        }

        .home-landing h1,
        .home-landing h2,
        .home-landing h3,
        .home-landing h4 {
            font-family: "Cairo", sans-serif;
            letter-spacing: 0;
        }

        .home-landing a:focus-visible,
        .home-landing input:not(.hm-search-input):focus-visible,
        .home-landing button:focus-visible {
            outline: 2.5px solid var(--hm-navy);
            outline-offset: 3px;
        }

        /* =================================================================
           1. Assiut University Campus Backdrop Hero
           ================================================================= */
        .hm-hero {
            position: relative;
            min-height: clamp(580px, 80vh, 720px);
            display: flex;
            align-items: center;
            padding: 72px 0 80px;
            background-color: #0B1D2E;
            background-image:
                linear-gradient(260deg, rgba(10, 26, 42, 0.92) 0%, rgba(14, 34, 53, 0.80) 48%, rgba(14, 34, 53, 0.32) 100%),
                url('/images/campus/assiut-main-building.jpg');
            background-size: cover;
            background-position: center 42%;
            color: #FFFFFF;
            border-bottom: 3px solid var(--hm-gold);
        }

        .hm-hero a:focus-visible,
        .hm-hero button:focus-visible {
            outline-color: var(--hm-gold);
        }

        .hm-hero-title {
            font-size: clamp(1.95rem, 3.3vw, 2.95rem);
            font-weight: 800;
            line-height: 1.42;
            color: #FFFFFF;
            margin-bottom: 18px;
            max-width: 21ch;
        }

        .hm-hero-lead {
            font-size: 1.08rem;
            line-height: 1.9;
            color: rgba(248, 250, 252, 0.9);
            margin-bottom: 30px;
            max-width: 62ch;
        }

        .hm-hero-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
        }

        .hm-btn {
            min-height: 48px;
            padding: 11px 22px;
            border-radius: var(--hm-radius-sm);
            font-family: "Cairo", sans-serif;
            font-size: 0.96rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: transform 0.18s ease, background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
            cursor: pointer;
        }

        .hm-btn:active {
            transform: translateY(1px);
        }

        .hm-btn-primary {
            background-color: var(--hm-gold);
            color: var(--hm-navy);
            border: 1px solid var(--hm-gold);
            box-shadow: 0 10px 24px -10px rgba(8, 18, 28, 0.55);
        }

        .hm-btn-primary:hover {
            background-color: var(--hm-gold-hover);
            border-color: var(--hm-gold-hover);
            color: var(--hm-navy);
            transform: translateY(-1px);
            box-shadow: 0 14px 28px -12px rgba(8, 18, 28, 0.65);
        }

        .hm-btn-secondary {
            background-color: rgba(255, 255, 255, 0.14);
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.45);
        }

        .hm-btn-secondary:hover {
            background-color: rgba(255, 255, 255, 0.24);
            border-color: rgba(255, 255, 255, 0.75);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .hm-btn-verify {
            background-color: #FFFFFF;
            color: var(--hm-navy);
            border: 1px solid #FFFFFF;
        }

        .hm-btn-verify:hover {
            background-color: #F1F5F9;
            border-color: #F1F5F9;
            color: var(--hm-navy);
            transform: translateY(-1px);
        }

        /* Hero entrance animation (subtle, single load moment) */
        .hm-hero [data-hm-enter] {
            animation: hmFadeSlide 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        @@keyframes hmFadeSlide {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =================================================================
           2. Hero Certificate Verification Box
           ================================================================= */
        .hm-hero-verify {
            margin-top: 28px;
            max-width: 680px;
            background-color: rgba(255, 255, 255, 0.97);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 14px;
            padding: 14px 16px 16px;
            box-shadow: 0 18px 40px -16px rgba(8, 18, 28, 0.55);
            color: var(--hm-ink);
        }

        .hm-hero-verify-label {
            display: block;
            font-family: "Cairo", sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--hm-navy);
            margin-bottom: 10px;
        }

        .hm-search-shell {
            display: flex;
            align-items: stretch;
            background-color: #F8FAFC;
            border: 1.5px solid #CBD5E1;
            border-radius: var(--hm-radius-md);
            padding: 5px;
            gap: 6px;
            transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease;
        }

        .hm-search-shell:focus-within {
            background-color: #FFFFFF;
            border-color: var(--hm-navy);
            box-shadow: 0 0 0 4px rgba(14, 34, 53, 0.08);
        }

        .hm-search-input {
            flex: 1 1 auto;
            min-width: 0;
            border: none !important;
            background: transparent !important;
            box-shadow: none !important;
            padding: 10px 14px;
            font-family: "Cairo", sans-serif;
            font-variant-numeric: tabular-nums;
            font-size: 0.92rem;
            color: var(--hm-ink);
            outline: none !important;
        }

        .hm-search-input:focus,
        .hm-search-input:focus-visible {
            outline: none !important;
            box-shadow: none !important;
        }

        .hm-search-input::placeholder {
            font-family: "Cairo", sans-serif;
            color: #64748B;
        }

        .hm-search-submit {
            min-height: 46px;
            padding: 0 24px;
            border: none;
            border-radius: 9px;
            background-color: var(--hm-emerald);
            color: #FFFFFF;
            font-family: "Cairo", sans-serif;
            font-size: 0.96rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-shrink: 0;
            cursor: pointer;
            transition: background-color 0.18s ease, transform 0.15s ease;
        }

        .hm-search-submit:hover {
            background-color: var(--hm-emerald-hover);
        }

        .hm-search-submit:active {
            transform: translateY(1px);
        }

        /* =================================================================
           3. Connected 5-Step Workflow Stepper
           ================================================================= */
        .hm-workflow-section {
            padding: 64px 0;
            background-color: var(--hm-slate-bg);
            border-bottom: 1px solid var(--hm-border);
        }

        .hm-section-head {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 36px;
        }

        .hm-section-title {
            font-size: clamp(1.45rem, 2.2vw, 1.9rem);
            font-weight: 700;
            color: var(--hm-ink);
            margin-bottom: 6px;
        }

        .hm-section-desc {
            font-size: 0.98rem;
            color: var(--hm-muted);
            margin-bottom: 0;
        }

        .hm-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .hm-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background-color: var(--hm-surface);
            border: 1px solid #DCE3EC;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--hm-navy);
        }

        .hm-chip i.bi {
            color: var(--hm-emerald);
            font-size: 0.95rem;
        }

        .hm-stepper {
            position: relative;
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 16px;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .hm-stepper::before {
            content: "";
            position: absolute;
            top: 40px;
            right: 48px;
            left: 48px;
            height: 2px;
            background: linear-gradient(90deg, #CBD5E1 0%, #94A3B8 50%, #CBD5E1 100%);
            z-index: 0;
        }

        .hm-step-card {
            position: relative;
            z-index: 1;
            background-color: var(--hm-surface);
            border: 1px solid var(--hm-border);
            border-radius: 16px;
            padding: 22px 18px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .hm-step-card:hover {
            transform: translateY(-2px);
            border-color: #94A3B8;
            box-shadow: 0 12px 26px -14px rgba(14, 34, 53, 0.16);
        }

        .hm-step-badge {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background-color: var(--hm-navy);
            color: #FFFFFF;
            font-family: "Cairo", sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 0 4px #FFFFFF;
        }

        .hm-step-card:last-child .hm-step-badge {
            background-color: var(--hm-emerald);
        }

        .hm-step-title {
            font-size: 0.98rem;
            font-weight: 700;
            color: var(--hm-ink);
            line-height: 1.65;
            margin: 0;
        }

        /* =================================================================
           4. Modern 2x2 Architectural Pillars Cards
           ================================================================= */
        .hm-pillars-section {
            padding: 72px 0;
            background-color: var(--hm-surface);
        }

        .hm-pillars-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .hm-pillar-card {
            background-color: #FAFBFD;
            border: 1px solid var(--hm-border);
            border-radius: var(--hm-radius-lg);
            padding: 28px;
            display: flex;
            align-items: flex-start;
            gap: 18px;
            transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .hm-pillar-card:hover {
            transform: translateY(-2px);
            background-color: var(--hm-surface);
            border-color: #CBD5E1;
            box-shadow: 0 16px 34px -20px rgba(14, 34, 53, 0.16);
        }

        .hm-pillar-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background-color: #EAF0F6;
            color: var(--hm-navy);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .hm-pillar-card:hover .hm-pillar-icon {
            background-color: var(--hm-navy);
            color: var(--hm-gold);
        }

        .hm-pillar-title {
            font-size: 1.08rem;
            font-weight: 700;
            color: var(--hm-ink);
            margin-bottom: 8px;
        }

        .hm-pillar-text {
            font-size: 0.96rem;
            line-height: 1.82;
            color: var(--hm-body);
            margin: 0;
        }

        /* =================================================================
           5. Framed Deep-Navy Discovery Banner
           ================================================================= */
        .hm-discovery-section {
            padding: 12px 0 72px;
            background-color: var(--hm-surface);
        }

        .hm-discovery-banner {
            background: linear-gradient(135deg, #0E2235 0%, #15314B 100%);
            border-radius: 20px;
            padding: 40px 44px;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
            box-shadow: 0 22px 48px -22px rgba(14, 34, 53, 0.35);
        }

        .hm-discovery-title {
            font-size: clamp(1.3rem, 2vw, 1.65rem);
            font-weight: 700;
            color: #FFFFFF;
            margin-bottom: 8px;
        }

        .hm-discovery-desc {
            font-size: 0.98rem;
            line-height: 1.8;
            color: rgba(255, 255, 255, 0.84);
            margin: 0;
            max-width: 60ch;
        }

        .hm-discovery-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            flex-shrink: 0;
        }

        .hm-btn-banner-light {
            background-color: rgba(255, 255, 255, 0.12);
            color: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.32);
        }

        .hm-btn-banner-light:hover {
            background-color: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.55);
            color: #FFFFFF;
        }

        .hm-btn-banner-gold {
            background-color: var(--hm-gold);
            color: var(--hm-navy);
            border: 1px solid var(--hm-gold);
        }

        .hm-btn-banner-gold:hover {
            background-color: var(--hm-gold-hover);
            border-color: var(--hm-gold-hover);
            color: var(--hm-navy);
        }

        /* =================================================================
           Responsive Breakpoints (Tablet 991px / Mobile 767px / Phone 575px)
           ================================================================= */
        @@media (max-width: 991.98px) {
            .hm-hero {
                min-height: 0;
                padding: 48px 0 54px;
            }

            .hm-hero-title {
                max-width: none;
            }

            .hm-hero-verify {
                max-width: none;
            }

            .hm-stepper {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .hm-stepper::before {
                top: 24px;
                bottom: 24px;
                right: 36px;
                left: auto;
                width: 2px;
                height: auto;
                background: #CBD5E1;
            }

            .hm-step-card {
                flex-direction: row;
                align-items: center;
                padding: 16px 18px;
            }

            .hm-discovery-banner {
                flex-direction: column;
                align-items: flex-start;
                padding: 32px 28px;
            }
        }

        @@media (max-width: 767.98px) {
            .hm-hero {
                background-image:
                    linear-gradient(180deg, rgba(10, 26, 42, 0.78) 0%, rgba(14, 34, 53, 0.90) 100%),
                    url('/images/campus/assiut-main-building.jpg');
                background-position: center 50%;
            }

            .hm-pillars-grid {
                grid-template-columns: 1fr;
            }

            .hm-pillar-card {
                padding: 22px 20px;
            }
        }

        @@media (max-width: 575.98px) {
            .hm-hero {
                padding: 28px 0 36px;
            }

            .hm-hero-actions .hm-btn {
                width: 100%;
            }

            .hm-hero-verify {
                margin-top: 22px;
                padding: 14px;
            }

            .hm-search-shell {
                flex-direction: column;
                background-color: transparent;
                border: none;
                padding: 0;
                gap: 10px;
            }

            .hm-search-shell:focus-within {
                box-shadow: none;
            }

            .hm-search-input {
                background-color: #F8FAFC !important;
                border: 1.5px solid #CBD5E1 !important;
                border-radius: var(--hm-radius-md);
                min-height: 48px;
            }

            .hm-search-submit {
                width: 100%;
                min-height: 48px;
                border-radius: var(--hm-radius-md);
            }

            .hm-workflow-section,
            .hm-pillars-section {
                padding: 44px 0;
            }

            .hm-discovery-banner {
                padding: 26px 20px;
            }

            .hm-discovery-actions,
            .hm-discovery-actions .hm-btn {
                width: 100%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .hm-hero [data-hm-enter],
            .hm-btn,
            .hm-step-card,
            .hm-pillar-card {
                animation: none !important;
                transition: none !important;
                transform: none !important;
            }
        }
    </style>
}

<div class="home-landing">
    <!-- 1. Campus Backdrop Hero with Verification Box -->
    <section class="hm-hero" aria-labelledby="home-hero-title">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8" data-hm-enter>
                    <h1 id="home-hero-title" class="hm-hero-title">
                        المنصة الإلكترونية للجان الفرعية لأخلاقيات البحث العلمي
                    </h1>

                    <p class="hm-hero-lead">
                        بيئة أكاديمية رقمية مؤتمتة لتحويل دورة مراجعة مقترحات البحوث ولجان الأخلاقيات بالجامعة إلى مسار ذكي خالٍ من المعاملات الورقية، مع التحكيم المستقل وإصدار الشهادات الأخلاقية الرقمية المعتمدة بـ QR.
                    </p>

                    <div class="hm-hero-actions">
                        <a asp-controller="Account" asp-action="SignUp" class="hm-btn hm-btn-primary">
                            تقديم مقترح بحثي (تسجيل باحث)
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="hm-btn hm-btn-secondary">
                            تسجيل الدخول
                        </a>
                    </div>

                    <form asp-controller="Public" asp-action="VerifyCertificate" method="get" class="hm-hero-verify" aria-label="نموذج التحقق من صحة الشهادة">
                        <label for="certificate-serial-number" class="hm-hero-verify-label">التحقق من صحة الشهادات</label>
                        <div class="hm-search-shell">
                            <input id="certificate-serial-number"
                                   type="text"
                                   name="serialNumber"
                                   class="hm-search-input"
                                   placeholder="أدخل الرقم المسلسل للشهادة (مثال: REC-MED-2026-123456)"
                                   dir="ltr"
                                   spellcheck="false"
                                   autocomplete="off" />
                            <button type="submit" class="hm-search-submit">
                                <i class="bi bi-search"></i>
                                فحص وتحقق
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Connected 5-Step Workflow Stepper -->
    <section class="hm-workflow-section" aria-labelledby="home-workflow-title">
        <div class="container">
            <div class="hm-section-head">
                <ul class="hm-chips" aria-label="مميزات مسار العمل">
                    <li class="hm-chip"><i class="bi bi-shield-lock"></i> حوكمة مستقلة</li>
                    <li class="hm-chip"><i class="bi bi-qr-code"></i> شهادات QR</li>
                    <li class="hm-chip"><i class="bi bi-stopwatch"></i> مهلة 48 ساعة SLA</li>
                </ul>
            </div>

            <ol class="hm-stepper">
                <li class="hm-step-card">
                    <span class="hm-step-badge" aria-hidden="true">1</span>
                    <h3 class="hm-step-title">فحص شكلي إداري</h3>
                </li>
                <li class="hm-step-card">
                    <span class="hm-step-badge" aria-hidden="true">2</span>
                    <h3 class="hm-step-title">إسناد للمحكمين</h3>
                </li>
                <li class="hm-step-card">
                    <span class="hm-step-badge" aria-hidden="true">3</span>
                    <h3 class="hm-step-title">تعديلات أخلاقية</h3>
                </li>
                <li class="hm-step-card">
                    <span class="hm-step-badge" aria-hidden="true">4</span>
                    <h3 class="hm-step-title">اعتماد رسمي</h3>
                </li>
                <li class="hm-step-card">
                    <span class="hm-step-badge" aria-hidden="true">5</span>
                    <h3 class="hm-step-title">إصدار الشهادة الرقمية</h3>
                </li>
            </ol>
        </div>
    </section>

    <!-- 4. Modern Architectural Feature Cards -->
    <section class="hm-pillars-section" aria-labelledby="home-pillars-title">
        <div class="container">
            <div class="hm-section-head">
                <div>
                    <h2 id="home-pillars-title" class="hm-section-title">الركائز الأساسية للمنصة</h2>
                    <p class="hm-section-desc">نظام إلكتروني يحقق أعلى معايير الشفافية والحيادية الأكاديمية</p>
                </div>
            </div>

            <div class="hm-pillars-grid">
                <article class="hm-pillar-card">
                    <div class="hm-pillar-icon" aria-hidden="true">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h3 class="hm-pillar-title">منع تضارب المصالح</h3>
                        <p class="hm-pillar-text">استبعاد تلقائي ومحكم للباحثين والمشاركين من تحكيم أبحاثهم، مع توزيع آلي ذكي حسب التخصص الدقيق والأعباء.</p>
                    </div>
                </article>

                <article class="hm-pillar-card">
                    <div class="hm-pillar-icon" aria-hidden="true">
                        <i class="bi bi-people"></i>
                    </div>
                    <div>
                        <h3 class="hm-pillar-title">تحكيم علمي مستقل</h3>
                        <p class="hm-pillar-text">تقييم مبني على الإجماع لا التصويت؛ اعتماد عند إجماع المحكمين، وتعديل إلزامي عند طلب أحدهم مع تعمية الهويات.</p>
                    </div>
                </article>

                <article class="hm-pillar-card">
                    <div class="hm-pillar-icon" aria-hidden="true">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h3 class="hm-pillar-title">انضباط الـ SLA الزمني</h3>
