@{
    ViewData["Title"] = "عن المنصة واللوائح الأخلاقية | About";
}

<section class="campus-editorial-banner">
    <div class="container">
        <div class="small fw-medium mb-2 hero-campus-eyebrow">
            دليل المنظومة واللوائح الأكاديمية
        </div>
        <h1 class="page-title editorial-display-title fw-semibold text-white mb-2">عن المنصة الإلكترونية للجان الأخلاقيات والنزاهة الأكاديمية</h1>
        <p class="fs-5 mb-0 banner-lead" style="max-width: 780px;">
            منظومة رقمية مؤسسية تهدف إلى ضبط وحوكمة المعاملات البحثية وتطبيق المعايير الأخلاقية المعتمدة وطنياً ودولياً.
        </p>
    </div>
</section>

<div class="container py-5">

    <div class="row g-4 mb-5">
        <div class="col-lg-6">
            <section class="charter-section h-100">
                <div class="pb-3 mb-3 border-bottom">
                    <h4 class="page-title fw-semibold mb-0">
                        الرؤية والأهداف
                    </h4>
                </div>
                <p class="text-muted">
                    تهدف المنصة إلى القضاء التام على البيروقراطية الورقية وتسريع وتيرة فحص مقترحات الأبحاث العلمية ورسائل الماجستير والدكتوراه، مع ضمان أقصى درجات الحماية للمشاركين في الأبحاث والبيانات الحساسة.
                </p>

                <div class="mt-3">
                    <div class="charter-rule-item">
                        <span class="charter-rule-num">01</span>
                        <div class="text-muted">
                            التحول الرقمي الكامل (Paperless Ethics Clearance).
                        </div>
                    </div>
                    <div class="charter-rule-item">
                        <span class="charter-rule-num">02</span>
                        <div class="text-muted">
                            الالتزام الصارم باتفاقيات هلسنكي وأخلاقيات البحث الطبي والحيوي والإنساني.
                        </div>
                    </div>
                    <div class="charter-rule-item">
                        <span class="charter-rule-num">03</span>
                        <div class="text-muted">
                            الفصل التام بين الإدارة التنفيذية واللجان العلمية المحكمة.
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-6">
            <section class="charter-section h-100">
                <div class="pb-3 mb-3 border-bottom">
                    <h4 class="page-title fw-semibold mb-0">
                        معايير التقييم الأخلاقي المحوسب
                    </h4>
                </div>
                <p class="text-muted">
                    يخضع كل مقترح بحثي لتقييم علمي ثلاثي الأبعاد من قِبل نخبة من المحكمين المستقلين وفق المعايير التالية:
                </p>

                <div class="mt-3">
                    <div class="charter-rule-item">
                        <span class="charter-rule-num">01</span>
                        <div>
                            <div class="fw-semibold text-dark mb-1">
                                حماية الخصوصية وسرية البيانات
                            </div>
                            <div class="text-muted small">تدابير حماية الهويات وطرق جمع وتشفير وتخزين البيانات البحثية.</div>
                        </div>
                    </div>
                    <div class="charter-rule-item">
                        <span class="charter-rule-num">02</span>
                        <div>
                            <div class="fw-semibold text-dark mb-1">
                                موازنة نسبة المخاطر والمنافع
                            </div>
                            <div class="text-muted small">حصر كافة المخاطر المتوقعة ومقارنتها بالفوائد العلمية والمجتمعية للبحث.</div>
                        </div>
                    </div>
                    <div class="charter-rule-item">
                        <span class="charter-rule-num">03</span>
                        <div>
                            <div class="fw-semibold text-dark mb-1">
                                نماذج وإجراءات الموافقة المستنيرة
                            </div>
                            <div class="text-muted small">وضوح وصحة نماذج موافقة المشاركين وخلوها من الإكراه والغموض.</div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-right me-1"></i> العودة للرئيسية
        </a>
    </div>
</div>
