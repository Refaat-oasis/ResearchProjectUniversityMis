@{
    ViewData["Title"] = "فريق التطوير والمهندسون | Software Engineering Team";
}

<!-- Engineering Team Banner Header -->
<section class="campus-editorial-banner">
    <div class="container">
        <div class="small fw-medium mb-2 hero-campus-eyebrow">
            فريق هندسة وتطوير البرمجيات
        </div>
        <h1 class="page-title editorial-display-title fw-semibold text-white mb-2">مهندسو ومطورو المنصة الإلكترونية</h1>
        <p class="fs-5 mb-0 banner-lead" style="max-width: 720px;">
            قام بتصميم وهندسة وتطوير هذه المنصة الأكاديمية فريق من مهندسي البرمجيات المتخصصين في بناء النظم الرقمية الموزعة وحلول الحوكمة الإلكترونية.
        </p>
    </div>
</section>

<div class="container py-5">

    <!-- Academic Supervision Card -->
    <div class="row justify-content-center mb-4">
        <div class="col-12">
            <article class="developer-card" style="border-top: 3px solid var(--accent-brass, #C89D46); background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
                    <div class="d-flex align-items-center gap-3 gap-md-4">
                        <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-3 border bg-white p-2 shadow-sm" style="width: 76px; height: 76px;">
                            <img src="~/images/brand/assiut-university-logo.png"
                                 asp-append-version="true"
                                 alt="شعار جامعة أسيوط"
                                 style="width: 56px; height: 56px; object-fit: contain;" />
                        </div>
                        <div>
                            <div class="d-inline-flex align-items-center gap-1 role-stamp mb-2" style="background-color: rgba(200, 157, 70, 0.12); color: #8a651b; border-color: rgba(200, 157, 70, 0.35);">
                                <i class="bi bi-mortarboard-fill"></i>
                                <span>تحت إشراف أكاديمي وعلمي | Academic Supervision</span>
                            </div>
                            <h2 class="page-title fw-bold text-dark mb-1" style="font-size: 1.45rem;">د. علي حسين</h2>
                            <div class="fw-semibold mb-1" style="color: var(--brand-sovereign, #0E2235);">
                                رئيس قسم نظم المعلومات الإدارية (MIS) — جامعة أسيوط
                            </div>
                            <div class="font-mono-tabular text-muted small" dir="ltr">
                                Dr. Ali Hussein — Head of MIS Department, Assiut University
                            </div>
                        </div>
                    </div>
                    <div class="border-top border-md-top-0 pt-3 pt-md-0 text-md-end" style="max-width: 420px;">
                        <p class="text-muted small mb-2">
                            تم تصميم وتطوير هذه المنصة الأكاديمية تحت الإشراف العلمي والأكاديمي المباشر لرئاسة قسم نظم المعلومات الإدارية (MIS) بجامعة أسيوط، دعماً للتحول الرقمي وحوكمة البحث العلمي.
                        </p>
                        <span class="role-stamp">
                            <i class="bi bi-building-check me-1"></i> جامعة أسيوط — قسم MIS
                        </span>
                    </div>
                </div>
            </article>
        </div>
    </div>

    <!-- Developers Cards Row -->
    <div class="row g-4 justify-content-center">
        <!-- Developer 1: Ahmed Mohamed Refaat -->
        <div class="col-lg-6">
            <article class="developer-card h-100 d-flex flex-column">
                <div class="row g-4 align-items-start">
                    <div class="col-sm-5">
                        <div class="developer-portrait-frame mb-0">
                            <img src="~/images/developers/ahmed-refaat.jpg"
                                 asp-append-version="true"
                                 alt="Ahmed Mohamed Refaat"
                                 onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Ahmed+Refaat&background=1a365d&color=fff&size=200';" />
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="role-stamp mb-2">
                            Software Engineer
                        </div>
                        <h3 class="page-title fw-semibold text-dark mb-1">أحمد محمد رفعت</h3>
                        <div class="font-mono-tabular text-muted fw-medium small mb-3" dir="ltr">Ahmed Mohamed Refaat</div>
                        <p class="text-muted small mb-0">
                            مشارك في التصميم المعماري للمنصة، وتطوير دورة عمل التحكيم الأكاديمي، وبناء وحدات التحكم والخدمات المتخصصة وقواعد الأمان وحوكمة البيانات.
                        </p>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <div class="small text-dark fw-medium mb-2">مهندس برمجيات (Software Engineer)</div>
                    <div class="font-mono-tabular d-flex flex-wrap gap-1" dir="ltr">
                        <code>.NET 9 / C#</code>
                        <code>ASP.NET Core MVC</code>
                        <code>Entity Framework Core</code>
                        <code>SQL Server</code>
                        <code>Clean Architecture</code>
                    </div>
                </div>

                <div class="pt-3 mt-auto border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="role-stamp">
                        Core Developer
                    </span>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="https://www.linkedin.com/in/ahmed-mohamed-refaat/" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary px-3" title="LinkedIn">
                            <i class="bi bi-linkedin me-1"></i> LinkedIn
                        </a>
                        <a href="mailto:info@research.mis.edu.eg" class="btn btn-sm btn-outline-secondary px-3" title="البريد الإلكتروني">
                            <i class="bi bi-envelope me-1"></i> تواصل
                        </a>
                    </div>
                </div>
            </article>
        </div>

        <!-- Developer 2: Ziad Hasaneen Abo Elhassan -->
        <div class="col-lg-6">
            <article class="developer-card h-100 d-flex flex-column">
                <div class="row g-4 align-items-start">
                    <div class="col-sm-5">
                        <div class="developer-portrait-frame mb-0">
                            <img src="~/images/developers/ziad-hasaneen.jpg"
                                 asp-append-version="true"
                                 alt="Ziad Hasaneen Abo Elhassan"
                                 onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Ziad+Hasaneen&background=059669&color=fff&size=200';" />
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="role-stamp mb-2">
                            Software Engineer
                        </div>
                        <h3 class="page-title fw-semibold text-dark mb-1">زياد حسنين أبو الحسن</h3>
                        <div class="font-mono-tabular text-muted fw-medium small mb-3" dir="ltr">Ziad Hasaneen Abo Elhassan</div>
                        <p class="text-muted small mb-0">
                            مشارك في هندسة البنية التحتية، وتكامل خدمات التشفير والشهادات الرقمية، وإدارة دورة حياة الحسابات وربط الإشعارات الحية عبر SignalR و Hangfire.
                        </p>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <div class="small text-dark fw-medium mb-2">مهندس برمجيات (Software Engineer)</div>
                    <div class="font-mono-tabular d-flex flex-wrap gap-1" dir="ltr">
                        <code>.NET 9 / C#</code>
                        <code>Identity &amp; Security</code>
                        <code>SignalR &amp; Real-Time</code>
                        <code>Hangfire Background Jobs</code>
                        <code>Database Systems</code>
                    </div>
                </div>

                <div class="pt-3 mt-auto border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="role-stamp">
                        Core Developer
                    </span>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="https://www.linkedin.com/in/ziad-hassanein-iti/" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary px-3" title="LinkedIn">
                            <i class="bi bi-linkedin me-1"></i> LinkedIn
                        </a>
                        <a href="mailto:info@research.mis.edu.eg" class="btn btn-sm btn-outline-secondary px-3" title="البريد الإلكتروني">
                            <i class="bi bi-envelope me-1"></i> تواصل
                        </a>
                    </div>
                </div>
            </article>
        </div>
    </div>

    <!-- Back to Home Button -->
    <div class="mt-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-right me-1"></i> العودة للرئيسية
        </a>
    </div>
</div>
