@model researchProject.Models.ViewModels.SystemStatisticsViewModel
@{
    ViewData["Title"] = "إحصائيات وتقارير أداء الكلية";
}

<div class="page-header-card">
    <div>
        <h2><i class="bi bi-pie-chart text-warning"></i> إحصائيات وتقارير أداء الكلية</h2>
        <p>مؤشرات أداء فحص المقترحات وإنجاز لجان التحكيم على مستوى الكلية</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportReportsToCsv" class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل (CSV)
        </a>
        <button class="btn btn-outline-light btn-sm" onclick="window.print();">
            <i class="bi bi-printer me-1"></i> طباعة التقرير
        </button>
    </div>
</div>

<div class="liquid-glass-card mb-4">
    <!-- Stat Summary Cards -->
    <div class="row g-3 mb-4 align-items-stretch">
        <div class="col-md-3 d-flex">
            <div class="stat-card w-100 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">أبحاث الكلية الإجمالية</div>
                    <div class="stat-number text-primary">@Model.TotalResearches</div>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3 d-flex">
            <div class="stat-card w-100 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">قيد الفحص الشكلي</div>
                    <div class="stat-number text-warning">@Model.UnderScreeningCount</div>
                </div>
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-hourglass"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3 d-flex">
            <div class="stat-card w-100 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">مسندة للتحكيم</div>
                    <div class="stat-number text-info">@Model.AssignedToJudgesCount</div>
                </div>
                <div class="stat-icon bg-info-subtle text-info">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3 d-flex">
            <div class="stat-card w-100 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">شهادات صادرة</div>
                    <div class="stat-number text-success">@Model.CertificatesIssuedCount</div>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quality KPIs -->
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card p-3 bg-light border rounded-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i>كفاءة الفحص الشكلي وسرعة الإنجاز</h6>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">متوسط زمن الفحص الإداري:</span>
                    <strong class="text-dark">@Model.AverageScreeningHours ساعة</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">نسبة الالتزام بالمهلة (48h):</span>
                    <strong class="text-success">@Model.SlaCompliancePercentage%</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">الباحثون المسجلون بالكلية:</span>
                    <strong class="text-dark">@Model.TotalResearchers باحث</strong>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3 bg-light border rounded-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-mortarboard text-info me-2"></i>هيئة التحكيم الأكاديمية</h6>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">المحكمون المعتمدون بالكلية:</span>
                    <strong class="text-dark">@Model.TotalJudges محكم</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">متوسط زمن التحكيم:</span>
                    <strong class="text-dark">@Model.AverageJudgingDays يوم</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">الأبحاث التي تطلبت تعديلات:</span>
                    <strong class="text-danger">@Model.ModificationsRequiredCount مقترح</strong>
                </div>
            </div>
        </div>
    </div>
</div>

