@model List<researchProject.Models.Entities.Research>
@using researchProject.Models.Constants
@{
    ViewData["Title"] = "طابور الفحص الشكلي للمقترحات";
}

<div class="page-header-card">
    <div>
        <h1><i class="bi bi-hourglass-split"></i> طابور الفحص الشكلي للمقترحات (Screening Queue)</h1>
        <p>مراجعة الأوراق إدارياً والتأكد من استيفاء المرفقات خلال المهلة النظامية (24 - 48 ساعة)</p>
    </div>
    <span class="status-stamp status-screening">
        بانتظار الفحص: <strong class="font-mono-tabular">@(Model?.Count ?? 0)</strong>
    </span>
</div>

<div class="card card-custom archival-card">
    <div class="table-responsive">
        <table class="table ledger-table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>التصنيف والتخصص</th>
                    <th>الباحث الرئيسي</th>
                    <th>تاريخ التقديم</th>
                    <th>الموعد النهائي للفحص</th>
                    <th>مؤشر المهلة (SLA)</th>
                    <th>إجراءات الفحص</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var mainAuthor = r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";
                        bool isOverdue = r.ScreeningDueAt < DateTime.UtcNow;
                        var remainingHours = Math.Round((r.ScreeningDueAt - DateTime.UtcNow).TotalHours, 1);

                        <tr style="@(isOverdue ? "border-right: 3px solid #8C1D24;" : "")">
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-bold" style="max-width: 260px; color: var(--ink-primary);">@r.Title</td>
                            <td>
                                <div class="fw-medium">@r.Category?.Name</div>
                                <div class="small" style="color: var(--ink-secondary);">@r.AcademicSpecialty</div>
                            </td>
                            <td>@mainAuthor</td>
                            <td class="small" style="color: var(--ink-secondary);">
                                <span class="font-mono-tabular" dir="ltr">@r.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</span>
                            </td>
                            <td class="small fw-bold" style="color: var(--ink-primary);">
                                <span class="font-mono-tabular" dir="ltr">@r.ScreeningDueAt.ToString("yyyy/MM/dd HH:mm")</span>
                            </td>
                            <td>
                                @if (isOverdue)
                                {
                                    <span class="sla-badge sla-overdue">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> متأخر عن المهلة!
                                    </span>
                                }
                                else
                                {
                                    <span class="sla-badge sla-ontime">
                                        <i class="bi bi-clock me-1"></i> متبقي <span class="font-mono-tabular">@remainingHours</span> ساعة
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    <a asp-action="Review" asp-route-id="@r.Id" class="btn btn-sm btn-primary-custom">
                                        <i class="bi bi-check2-square me-1"></i> فحص وإسناد
                                    </a>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-check2-circle fs-1 d-block mb-3 text-success"></i>
                            لا توجد أبحاث بانتظار الفحص الشكلي حالياً، تم إنجاز جميع المهام بنجاح!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
