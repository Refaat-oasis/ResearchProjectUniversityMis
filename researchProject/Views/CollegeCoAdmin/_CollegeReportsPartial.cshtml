@model researchProject.Models.ViewModels.SystemStatisticsViewModel

<div class="card card-custom archival-card">
    <div class="card-header-custom flex-wrap gap-3">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-pie-chart" style="color: var(--brand-brass);"></i> إحصائيات وتقارير أداء الكلية
            </h4>
            <div class="small mt-1" style="color: var(--ink-secondary);">مؤشرات أداء فحص المقترحات وإنجاز لجان التحكيم على مستوى الكلية</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/CollegeCoAdmin/ExportReportsToCsv" class="btn btn-primary-custom btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> تصدير إكسيل (Excel)
            </a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print();">
                <i class="bi bi-printer me-1"></i> طباعة التقرير
            </button>
        </div>
    </div>

    <!-- Stat Summary Ledger Strip -->
    <div class="kpi-ledger-grid mb-4">
        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label stat-label">أبحاث الكلية الإجمالية</div>
            <div class="kpi-ledger-value stat-number font-mono-tabular">@Model.TotalResearches</div>
        </div>

        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label stat-label">قيد الفحص الشكلي</div>
            <div class="kpi-ledger-value stat-number font-mono-tabular" style="color: var(--tone-screening-ink);">@Model.UnderScreeningCount</div>
        </div>

        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label stat-label">مسندة للتحكيم</div>
            <div class="kpi-ledger-value stat-number font-mono-tabular" style="color: var(--tone-assigned-ink);">@Model.AssignedToJudgesCount</div>
        </div>

        <div class="kpi-ledger-cell">
            <div class="kpi-ledger-label stat-label">شهادات صادرة</div>
            <div class="kpi-ledger-value stat-number font-mono-tabular" style="color: var(--brand-sovereign);">@Model.CertificatesIssuedCount</div>
        </div>
    </div>

    <!-- Quality KPIs -->
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="dossier-panel h-100 mb-0">
                <h6 class="fw-bold mb-3 pb-2 text-primary" style="border-bottom: 1px solid var(--border-hairline);">
                    <i class="bi bi-clock-history me-2" style="color: var(--brand-brass);"></i>كفاءة الفحص الشكلي وسرعة الإنجاز
                </h6>
                <dl class="mb-0">
                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid var(--border-hairline);">
                        <dt class="fw-normal small mb-0" style="color: var(--ink-secondary);">متوسط زمن الفحص الإداري:</dt>
                        <dd class="mb-0 fw-bold" style="color: var(--ink-primary);">
                            <span class="font-mono-tabular">@Model.AverageScreeningHours</span> ساعة
                        </dd>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid var(--border-hairline);">
                        <dt class="fw-normal small mb-0" style="color: var(--ink-secondary);">نسبة الالتزام بالمهلة (48h):</dt>
                        <dd class="mb-0 fw-bold text-success">
                            <span class="font-mono-tabular" dir="ltr">@Model.SlaCompliancePercentage%</span>
                        </dd>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <dt class="fw-normal small mb-0" style="color: var(--ink-secondary);">الباحثون المسجلون بالكلية:</dt>
                        <dd class="mb-0 fw-bold" style="color: var(--ink-primary);">
                            <span class="font-mono-tabular">@Model.TotalResearchers</span> باحث
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="dossier-panel h-100 mb-0">
                <h6 class="fw-bold mb-3 pb-2 text-primary" style="border-bottom: 1px solid var(--border-hairline);">
                    <i class="bi bi-sliders me-2" style="color: var(--brand-brass);"></i>توزيع أبحاث الكلية حسب التصنيف
                </h6>
                <div class="table-responsive">
                    <table class="table ledger-table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>التصنيف</th>
                                <th class="text-center">العدد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ResearchesByCategory != null && Model.ResearchesByCategory.Any())
                            {
                                foreach (var item in Model.ResearchesByCategory)
                                {
                                    <tr>
                                        <td>@item.Key</td>
                                        <td class="text-center fw-bold font-mono-tabular text-primary">@item.Value</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
