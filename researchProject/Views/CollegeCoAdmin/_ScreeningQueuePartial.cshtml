@model List<researchProject.Models.Entities.Research>
@using researchProject.Models.Constants

<div class="card card-custom archival-card">
    <div class="card-header-custom flex-wrap gap-3">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-hourglass-split" style="color: var(--brand-brass, #B88E38);"></i> طابور الفحص الشكلي للمقترحات (Screening Queue)
            </h4>
            <div class="small mt-1" style="color: var(--ink-secondary, #475569);">مراجعة الأوراق إدارياً والتأكد من استيفاء المرفقات خلال المهلة النظامية (24 - 48 ساعة)</div>
        </div>
        <span class="status-stamp status-screening">
            <span class="font-mono-tabular me-1">@(Model?.Count ?? 0)</span> مقترحات بانتظار الفحص
        </span>
    </div>

    <div class="table-responsive">
        <table class="table ledger-table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>التصنيف والتخصص</th>
                    <th>الباحث الرئيسي</th>
                    <th>تاريخ التقديم</th>
                    <th>الموعد النهائي للفحص</th>
                    <th>مؤشر المهلة (SLA)</th>
                    <th>إجراءات الفحص</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var mainAuthor = r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";
                        bool isOverdue = r.ScreeningDueAt < DateTime.UtcNow;
                        var remainingHours = Math.Round((r.ScreeningDueAt - DateTime.UtcNow).TotalHours, 1);

                        <tr style="@(isOverdue ? "border-right: 3px solid #8C1D24;" : "")">
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-bold" style="max-width: 260px; color: var(--ink-primary, #0E2235);">@r.Title</td>
                            <td>
                                <div class="fw-medium">@r.Category?.Name</div>
                                <div class="small" style="color: var(--ink-secondary, #475569);">@r.AcademicSpecialty</div>
                            </td>
                            <td>@mainAuthor</td>
                            <td class="small" style="color: var(--ink-secondary, #475569);">
                                <span class="font-mono-tabular" dir="ltr">@r.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</span>
                            </td>
                            <td class="small fw-bold" style="color: var(--ink-primary, #0E2235);">
                                <span class="font-mono-tabular" dir="ltr">@r.ScreeningDueAt.ToString("yyyy/MM/dd HH:mm")</span>
                            </td>
                            <td>
                                @if (isOverdue)
                                {
                                    <span class="sla-badge sla-overdue">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> متأخر عن المهلة!
                                    </span>
                                }
                                else
                                {
                                    <span class="sla-badge sla-ontime">
                                        <i class="bi bi-clock me-1"></i> متبقي <span class="font-mono-tabular">@remainingHours</span> ساعة
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="table-actions-inline">
                                    <button class="btn btn-sm btn-primary-custom" onclick="loadPartial('/CollegeCoAdmin/ResearchReviewPartial/@r.Id', '#main-content-container', 'screening-queue');" title="فحص وتدقيق المقترح وإسناد المحكمين">
                                        <i class="bi bi-check2-square me-1"></i> فحص وإسناد
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5" style="color: var(--ink-muted, #64748B);">
                            <i class="bi bi-check2-circle fs-3 d-block mb-2" style="color: var(--brand-sovereign, #0E2235);"></i>
                            لا توجد أبحاث بانتظار الفحص الشكلي حالياً، تم إنجاز جميع المهام!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
