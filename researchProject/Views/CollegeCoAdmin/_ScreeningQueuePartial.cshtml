@model List<researchProject.Models.Entities.Research>
@using researchProject.Models.Constants

<div class="card card-custom">
    <div class="card-header-custom">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-hourglass-split text-warning"></i> طابور الفحص الشكلي للمقترحات (Screening Queue)
            </h4>
            <div class="text-muted small">مراجعة الأوراق إدارياً والتأكد من استيفاء المرفقات خلال المهلة النظامية (24 - 48 ساعة)</div>
        </div>
        <span class="badge bg-primary fs-6">@(Model?.Count ?? 0) مقترحات بانتظار الفحص</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>التصنيف والتخصص</th>
                    <th>الباحث الرئيسي</th>
                    <th>تاريخ التقديم</th>
                    <th>الموعد النهائي للفحص</th>
                    <th>مؤشر المهلة (SLA)</th>
                    <th>إجراءات الفحص</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var mainAuthor = r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";
                        bool isOverdue = r.ScreeningDueAt < DateTime.UtcNow;
                        var remainingHours = Math.Round((r.ScreeningDueAt - DateTime.UtcNow).TotalHours, 1);

                        <tr class="@(isOverdue ? "table-danger" : "")">
                            <td>@index</td>
                            <td class="fw-bold" style="max-width: 250px;">@r.Title</td>
                            <td>
                                <div>@r.Category?.Name</div>
                                <div class="text-muted small">@r.AcademicSpecialty</div>
                            </td>
                            <td>@mainAuthor</td>
                            <td class="text-muted small">@r.SubmittedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="small fw-bold">@r.ScreeningDueAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                @if (isOverdue)
                                {
                                    <span class="sla-badge sla-overdue">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> متأخر عن المهلة!
                                    </span>
                                }
                                else
                                {
                                    <span class="sla-badge sla-ontime">
                                        <i class="bi bi-clock me-1"></i> متبقي @remainingHours ساعة
                                    </span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-primary-custom" onclick="loadPartial('/CollegeCoAdmin/ResearchReviewPartial/@r.Id', '#main-content-container', 'screening-queue');">
                                    <i class="bi bi-check2-square me-1"></i> فحص وإسناد
                                </button>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            <i class="bi bi-check2-circle text-success fs-3 d-block mb-2"></i>
                            لا توجد أبحاث بانتظار الفحص الشكلي حالياً، تم إنجاز جميع المهام!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
