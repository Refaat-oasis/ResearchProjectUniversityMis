@model List<researchProject.Models.Entities.Research>
@using researchProject.Models.Constants

<div class="card card-custom archival-card">
    <div class="card-header-custom flex-wrap gap-3">
        <div>
            <h4 class="card-title-custom">
                <i class="bi bi-award" style="color: var(--brand-brass, #B88E38);"></i> الاعتماد النهائي وإصدار الشهادات الأخلاقية الرقمية
            </h4>
            <div class="small mt-1" style="color: var(--ink-secondary, #475569);">المقترحات التي نالت موافقة واكتمال جولات التحكيم (صلاحية حصرية لمدير اللجنة الفرعية بالكلية)</div>
        </div>
    </div>

    <!-- Instructions Notice -->
    <div class="alert alert-success small mb-4" style="border-right: 3px solid var(--brand-sovereign);">
        <i class="bi bi-check-circle-fill me-1"></i>
        <strong>الاعتماد المباشر:</strong> تصدر الشهادة الأخلاقية الرسمية فوراً بختم واعتماد اللجنة ومزودة بالرقم المسلسل المعتمد ورمز الاستجابة السريعة (QR Code).
    </div>

    <div class="table-responsive">
        <table class="table ledger-table align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان المقترح البحثي</th>
                    <th>التصنيف والتخصص</th>
                    <th>الباحث الرئيسي</th>
                    <th>نتائج التحكيم</th>
                    <th>الحالة الحالية</th>
                    <th>الإجراء التنفيذي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var r in Model)
                    {
                        var mainAuthor = r.ResearcherResearchesBridges?.FirstOrDefault()?.Researcher?.User?.FullName ?? "غير محدد";
                        int approvedJudges = r.Evaluations?.Count(e => e.Decision == EvaluationDecisionConstants.Approved) ?? 0;
                        string statusClass = r.WorkflowStatus switch
                        {
                            ResearchStatusConstants.UnderFormalScreening => "status-screening",
                            ResearchStatusConstants.AssignedToJudges => "status-assigned",
                            ResearchStatusConstants.ModificationsRequired => "status-modifications",
                            ResearchStatusConstants.Approved => "status-approved",
                            ResearchStatusConstants.CertificateIssued => "status-issued",
                            _ => "status-screening"
                        };

                        <tr>
                            <td class="font-mono-tabular text-muted">@index</td>
                            <td class="fw-bold" style="max-width: 260px; color: var(--ink-primary, #0E2235);">@r.Title</td>
                            <td>
                                <div class="fw-medium">@r.Category?.Name</div>
                                <div class="small" style="color: var(--ink-secondary, #475569);">@r.AcademicSpecialty</div>
                            </td>
                            <td>@mainAuthor</td>
                            <td>
                                <span class="status-stamp status-approved">
                                    <i class="bi bi-check2-all me-1"></i> اعتماد المحكم
                                </span>
                            </td>
                            <td><span class="status-stamp @statusClass">@r.WorkflowStatus</span></td>
                            <td>
                                <div class="table-actions-inline">
                                    <button class="btn btn-sm btn-primary-custom fw-bold px-3" onclick="issueCertificate(@r.Id, '@r.Title');" title="اعتماد وإصدار الشهادة الأخلاقية الرقمية">
                                        <i class="bi bi-patch-check-fill me-1"></i> اعتماد وإصدار الشهادة
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5" style="color: var(--ink-muted, #64748B);">
                            لا توجد أبحاث معتمدة بانتظار إصدار الشهادة حالياً.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function issueCertificate(researchId, title) {
        if (!confirm(`هل أنت متأكد من اعتماد المقترح:\n« ${title} »\nوإصدار الشهادة الأخلاقية الرقمية؟`)) return;

        $('#partial-loading-spinner').css('display', 'flex');

        $.ajax({
            url: '/CollegeCoAdmin/IssueCertificate',
            type: 'POST',
            data: { researchId: researchId },
            success: function (res) {
                $('#partial-loading-spinner').hide();
                if (res.success) {
                    alert(res.message + '\nالرقم المسلسل: ' + res.serialNumber);
                    loadPartial('/CollegeCoAdmin/FinalApprovalPartial', '#main-content-container', 'finalApproval');
                } else {
                    alert(res.message);
                }
            },
            error: function (xhr) {
                $('#partial-loading-spinner').hide();
                alert(xhr.responseText || 'حدث خطأ أثناء إصدار الشهادة.');
            }
        });
    }
</script>
