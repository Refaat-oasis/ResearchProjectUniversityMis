@{
    ViewData["Title"] = "دعوة محكم علمي معتمد";
}

<div class="page-header-card">
    <div>
        <h1><i class="bi bi-envelope-plus"></i> دعوة محكم علمي معتمد</h1>
        <p>إرسال رابط دعوة آمن عبر البريد الإلكتروني لانضمام خبير أو باحث لهيئة المحكمين بالكلية</p>
    </div>
</div>

<div class="card card-custom archival-card">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="dossier-panel-subtle" style="border-top: 3px solid var(--brand-sovereign); padding: 24px;">
                <form id="coAdminInviteForm" asp-action="InviteJudge" method="post">
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني للمحكم <span class="text-danger">*</span></label>
                        <div class="dedicated-dropdown-wrapper" data-allow-custom="true">
                            <div class="dedicated-dropdown-input-group">
                                <i class="bi bi-envelope dedicated-dropdown-icon-right"></i>
                                <input type="email" name="email" id="visibleInviteEmail" class="form-control dedicated-dropdown-input font-mono-tabular" 
                                       placeholder="اكتب بريداً جديداً أو اختر من مستخدمي النظام..." 
                                       required dir="ltr" autocomplete="off" />
                                <div class="dedicated-dropdown-actions-left">
                                    <button type="button" class="dedicated-dropdown-clear-btn" title="مسح">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <button type="button" class="dedicated-dropdown-chevron-btn" title="عرض القائمة">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="dedicated-dropdown-menu">
                                @if (ViewBag.SystemUsers != null)
                                {
                                    foreach (var u in ViewBag.SystemUsers)
                                    {
                                        <div class="dedicated-dropdown-item" data-id="@u.Email" data-name="@u.Email" data-value="@u.Email" data-label="@u.Email">
                                            <span>@u.FullName (@u.Email)</span>
                                            <span class="dedicated-dropdown-item-badge">@u.RoleName</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                        <div class="form-text small mt-1">
                            <i class="bi bi-info-circle me-1"></i> يمكنك اختيار مستخدم مسجل بالنظام أو كتابة أي بريد جديد وسيتم إرسال رابط الدعوة الرسمية إليه مباشرة.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">التخصص الأكاديمي الدقيق المطلوب للتحكيم</label>
                        <input type="text" name="specialty" class="form-control" placeholder="مثال: علم الأدوية السريري / الأخلاقيات الحيوية" />
                    </div>

                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-3" style="border-top: 1px solid var(--border-hairline);">
                        <a asp-action="ScreeningQueue" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-right me-1"></i> العودة لطابور الفحص
                        </a>
                        <button type="submit" class="btn btn-primary-custom px-4 py-2">
                            <i class="bi bi-send-fill me-1"></i> إرسال رابط الدعوة الرسمية
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#coAdminInviteForm').on('submit', function (e) {
            e.preventDefault();
            const form = this;
            const emailInput = $(form).find('input[name="email"]');
            const emailVal = (emailInput.val() || '').trim();
            if (!emailVal) {
                window.showToast('error', 'البريد الإلكتروني إلزامي.');
                return false;
            }

            const data = $(form).serialize();

            $('#partial-loading-spinner').css('display', 'flex');

            $.ajax({
                url: form.action,
                type: 'POST',
                data: data,
                success: function (res) {
                    $('#partial-loading-spinner').hide();
                    if (res && res.success) {
                        window.showToast('success', res.message || 'تم إرسال الدعوة بنجاح.');
                        form.reset();
                    } else {
                        window.showToast('error', (res && res.message) ? res.message : 'فشل إرسال الدعوة.');
                    }
                },
                error: function (xhr) {
                    $('#partial-loading-spinner').hide();
                    var msg = 'حدث خطأ أثناء إرسال الدعوة.';
                    try {
                        var json = JSON.parse(xhr.responseText);
                        if (json && json.message) msg = json.message;
                    } catch (e) {
                        if (xhr.responseText) msg = xhr.responseText;
                    }
                    window.showToast('error', msg);
                }
            });
        });
    </script>
}
