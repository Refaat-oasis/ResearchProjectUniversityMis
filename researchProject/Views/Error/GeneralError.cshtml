@model researchProject.Models.ErrorViewModel
@{
    ViewData["Title"] = "عذراً، حدث خطأ غير متوقع";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9 text-center">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px);">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm" style="width: 110px; height: 110px; background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);">
                            <i class="bi bi-heart-pulse-fill text-danger" style="font-size: 3.5rem;"></i>
                        </div>
                    </div>

                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-6 fw-semibold mb-3">
                        عذراً • نعتذر عن هذا الخلل
                    </span>

                    <h2 class="fw-bold text-dark mb-3">نعتذر بشدة، تعذر إتمام العملية في الوقت الحالي</h2>
                    <p class="text-secondary fs-6 leading-relaxed mb-4" style="line-height: 1.8;">
                        حدث أمر غير متوقع أثناء معالجة طلبك، ونحن نعتذر بصدق عن ذلك.
                        تم تسجيل تفاصيل هذا الخطأ تلقائياً في سجلات النظام وسيقوم فريق الدعم الفني بمراجعته والتأكد من استقرار الخدمة.
                    </p>

                    @if (Model?.ShowRequestId == true)
                    {
                        <div class="alert alert-light border rounded-3 py-2 px-3 d-inline-block text-muted small mb-4">
                            <span>الرقم المرجعي للطلب:</span>
                            <code class="fw-bold ms-1">@Model.RequestId</code>
                        </div>
                    }

                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="/" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                            <i class="bi bi-house-door"></i>
                            العودة إلى الصفحة الرئيسية
                        </a>
                        <button onclick="window.location.reload()" class="btn btn-outline-secondary px-4 py-2 rounded-3 d-inline-flex align-items-center gap-2">
                            <i class="bi bi-arrow-clockwise"></i>
                            إعادة المحاولة
                        </button>
                    </div>
                </div>
                <div class="card-footer bg-light py-3 border-0 text-muted small text-center">
                    منصة اللجان الفرعية للنزاهة الأكاديمية وأخلاقيات البحث العلمي &copy; @DateTime.UtcNow.Year
                </div>
            </div>
        </div>
    </div>
</div>

